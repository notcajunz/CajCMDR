<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
<Meta name="ExplicitAutoJoints">true</Meta>
<Item class="Script" referent="RBX77">
<Properties>
<string name="Name">CajCMDR</string>
<bool name="Disabled">false</bool>
<ProtectedString name="Source"><![CDATA[--[[
	CajCMDR bootstrap.
	Builds on the Cmdr command framework: adds roles bound to Roblox communities (groups), a permission layer,
	chat commands, moderation tools and 200+ commands.  Configure everything in the `Config` module.
]]

const HttpService = game:GetService("HttpService")
const Players = game:GetService("Players")
const ReplicatedStorage = game:GetService("ReplicatedStorage")
const ServerScriptService = game:GetService("ServerScriptService")
const ServerStorage = game:GetService("ServerStorage")

const Config = require(script.Config)
const Store = require(script.Core.Store)
const Roles = require(script.Core.Roles)
const Log = require(script.Core.Log)
const Chat = require(script.Core.Chat)
const Admin = require(script.Core.Admin)

const PREFIX = "[CajAdmin]"

----------------------------------------------------------------------------------------------------
-- Find Cmdr
----------------------------------------------------------------------------------------------------

const function findCmdr(): ModuleScript?
	-- The drop-in package ships Cmdr as a child of this script; fall back to an existing install.
	const bundled = script:FindFirstChild("Cmdr")
	if bundled and bundled:IsA("ModuleScript") then
		return bundled
	end

	for _, container in ipairs({ ServerScriptService, ServerStorage }) do
		const found = container:FindFirstChild("Cmdr", true)
		if found and found:IsA("ModuleScript") then
			return found
		end
	end

	return nil
end

const cmdrModule = findCmdr()
if not cmdrModule then
	error(`{PREFIX} Could not find the Cmdr module. Re-insert the CajCMDR package (see README.md).`)
end

----------------------------------------------------------------------------------------------------
-- Roles and shared data
----------------------------------------------------------------------------------------------------

Roles.Init(Config)
Log.Init(Config)

const data = Instance.new("Folder")
data.Name = "CajAdminData"
data:SetAttribute("Roles", Roles.ToJson())
data:SetAttribute("MaxLevel", Roles.MaxLevel)
data:SetAttribute("Protect", Config.ProtectHigherRanks ~= false)
data:SetAttribute("PlaceName", Config.PlaceName or "CajCMDR")
data:SetAttribute("ConsoleKeys", HttpService:JSONEncode(Config.ConsoleKeys or { "F2" }))
data:SetAttribute("ChatPrefix", if Config.Chat and Config.Chat.Enabled then Config.Chat.Prefix or ";" else "")
data:SetAttribute("CommandLevels", "{}")

const groupLevels = {}
for groupName, roleName in pairs(Config.DefaultGroupRoles or {}) do
	const role = Roles.Get(roleName)
	if role then
		groupLevels[groupName] = role.Level
	end
end
data:SetAttribute("GroupLevels", HttpService:JSONEncode(groupLevels))
data.Parent = ReplicatedStorage

----------------------------------------------------------------------------------------------------
-- Cmdr
----------------------------------------------------------------------------------------------------

const Cmdr = require(cmdrModule)

Admin.Init({
	Cmdr = Cmdr,
	Config = Config,
	Roles = Roles,
	Store = Store,
	Log = Log,
	Chat = Chat,
	DataFolder = data,
})

Cmdr.Registry:RegisterDefaultCommands({ "DefaultUtil", "Help" })
Cmdr.Registry:RegisterTypesIn(script.Shared.Types)
Cmdr.Registry:RegisterHooksIn(script.Shared.Hooks)

-- Command logging (server only).
Cmdr.Registry:RegisterHook("AfterRun", function(context: any)
	const spec = Admin.Specs[context.Name:lower()]
	Log.Command({
		Time = os.time(),
		Executor = context.Executor.Name,
		UserId = context.Executor.UserId,
		Level = Roles.GetLevel(context.Executor),
		Text = context.RawText,
		Response = context.Response,
		Command = context.Name,
	})

	if spec and spec.Audit then
		Log.Audit({
			Time = os.time(),
			Executor = context.Executor.Name,
			UserId = context.Executor.UserId,
			Text = context.RawText,
			Response = context.Response,
		})
	end

	return nil
end, 100)

----------------------------------------------------------------------------------------------------
-- Command loading
----------------------------------------------------------------------------------------------------

const stubFolder = Instance.new("Folder")
stubFolder.Name = "Stubs"
stubFolder.Parent = script.Core

const function toSet(list: { string }?): { [string]: boolean }
	const set = {}
	for _, value in ipairs(list or {}) do
		set[value:lower()] = true
	end

	return set
end

const disabledCommands = toSet(Config.DisabledCommands)
const disabledCategories = toSet(Config.DisabledCategories)
const usedNames: { [string]: string } = {}
local commandCount = 0

const function registerSpec(spec: any, category: string)
	assert(type(spec) == "table", "command spec must be a table")
	assert(type(spec.Name) == "string" and spec.Name ~= "", "command spec needs a Name")
	assert(type(spec.Run) == "function", `command "{spec.Name}" needs a Run function`)

	const lowered = spec.Name:lower()
	if disabledCommands[lowered] then
		return
	end

	-- Name / alias collisions
	for _, name in ipairs({ spec.Name, table.unpack(spec.Aliases or {}) }) do
		const key = name:lower()
		if usedNames[key] then
			warn(`{PREFIX} "{name}" ({category}) is already used by "{usedNames[key]}"; skipping the duplicate.`)
			return
		end
	end

	const overrides = Config.CommandRoles or {}
	const roleName = overrides[spec.Name] or overrides[lowered] or spec.Role or "Admin"
	local role = Roles.Get(roleName)
	if not role then
		warn(`{PREFIX} Unknown role "{roleName}" for command "{spec.Name}"; only the top role can use it.`)
		role = Roles.GetRoleForLevel(Roles.MaxLevel)
	end

	usedNames[lowered] = spec.Name
	for _, alias in ipairs(spec.Aliases or {}) do
		usedNames[alias:lower()] = spec.Name
	end

	const definition = {
		Name = spec.Name,
		Aliases = spec.Aliases,
		Description = spec.Description or "No description.",
		Group = category,
		Args = spec.Args or {},
	}

	const stub = script.Core.CommandStub:Clone()
	stub.Name = spec.Name
	stub:SetAttribute("Def", HttpService:JSONEncode(definition))
	stub.Parent = stubFolder

	Cmdr.Registry:RegisterCommand(stub)

	const registered = Cmdr.Registry:GetCommand(spec.Name)
	if not registered then
		warn(`{PREFIX} Cmdr refused to register "{spec.Name}".`)
		stub:Destroy()
		return
	end

	registered.Run = spec.Run

	Admin.Specs[lowered] = { Name = spec.Name, Role = role.Name, Level = role.Level, Category = category, Audit = spec.Audit == true }
	Admin.CommandLevels[lowered] = role.Level
	commandCount += 1
end

local categoryCount = 0
for _, moduleScript in ipairs(script.Commands:GetChildren()) do
	if not moduleScript:IsA("ModuleScript") or disabledCategories[moduleScript.Name:lower()] then
		continue
	end

	const loaded, factory = pcall(require, moduleScript)
	if not loaded then
		warn(`{PREFIX} Failed to load command file {moduleScript.Name}: {factory}`)
		continue
	end

	const built, specs = pcall(factory, Admin)
	if not built then
		warn(`{PREFIX} Failed to build commands from {moduleScript.Name}: {specs}`)
		continue
	end

	categoryCount += 1
	for _, spec in ipairs(specs) do
		const registered, err = pcall(registerSpec, spec, moduleScript.Name)
		if not registered then
			warn(`{PREFIX} Skipped a command in {moduleScript.Name}: {err}`)
		end
	end
end

Admin.PublishCommandLevels()

----------------------------------------------------------------------------------------------------
-- Join gating: server bans and server lock
----------------------------------------------------------------------------------------------------

const function gate(player: Player)
	const banReason = Admin.ServerBans[player.UserId]
	if banReason then
		player:Kick(`You are banned from this server. Reason: {banReason}`)
		return
	end

	if Admin.ServerLock.Level > 0 and Roles.GetLevel(player) < Admin.ServerLock.Level then
		player:Kick(Admin.ServerLock.Reason ~= "" and Admin.ServerLock.Reason or "This server is locked.")
	end
end

Players.PlayerAdded:Connect(gate)
Roles.Resolved.Event:Connect(gate)

----------------------------------------------------------------------------------------------------
-- Start everything
----------------------------------------------------------------------------------------------------

-- The client script lives inside this package; hand a copy to every player (no StarterPlayerScripts setup needed).
const clientTemplate = script:FindFirstChild("Client")

const function giveClient(player: Player)
	if not clientTemplate then
		return
	end

	task.spawn(function()
		const gui = player:WaitForChild("PlayerGui", 30)
		if not gui or gui:FindFirstChild("CajAdminClient") then
			return
		end

		const client = clientTemplate:Clone()
		client.Name = "CajAdminClient"
		client.Parent = gui
	end)
end

Players.PlayerAdded:Connect(giveClient)
for _, player in ipairs(Players:GetPlayers()) do
	giveClient(player)
end

Roles.Start()
Admin.Start()
Chat.Start({ Cmdr = Cmdr, Config = Config, Roles = Roles, Admin = Admin, Log = Log })

print(`{PREFIX} Ready: {commandCount} commands in {categoryCount} categories. Press F2 to open the console.`)
]]></ProtectedString>
</Properties>
<Item class="LocalScript" referent="RBX5F">
<Properties>
<string name="Name">Client</string>
<bool name="Disabled">false</bool>
<ProtectedString name="Source"><![CDATA[--[[
	CajCMDR client. The server copies this script into every player's PlayerGui, so you never have to place it
	yourself. It starts the Cmdr console, applies your key bindings and shows messages from the server.
]]

const HttpService = game:GetService("HttpService")
const Players = game:GetService("Players")
const ReplicatedStorage = game:GetService("ReplicatedStorage")

const player = Players.LocalPlayer

const data = ReplicatedStorage:WaitForChild("CajAdminData")
const Cmdr = require(ReplicatedStorage:WaitForChild("CmdrClient"))

const Notifications = require(script.Notifications)
const Effects = require(script.Effects)

-- Console look and keys, from the Config on the server.
Cmdr:SetPlaceName(data:GetAttribute("PlaceName") or "CajCMDR")

const keys = {}
const okKeys, keyNames = pcall(HttpService.JSONDecode, HttpService, data:GetAttribute("ConsoleKeys") or "[]")
if okKeys and type(keyNames) == "table" then
	for _, name in ipairs(keyNames) do
		const okCode, code = pcall(function()
			return Enum.KeyCode[name]
		end)
		if okCode and code then
			table.insert(keys, code)
		end
	end
end
Cmdr:SetActivationKeys(if #keys > 0 then keys else { Enum.KeyCode.F2 })

-- Messages and effects sent by the server.
Cmdr:HandleEvent("CajNotify", Notifications.Notify)
Cmdr:HandleEvent("CajAnnounce", Notifications.Announce)
Cmdr:HandleEvent("CajFx", Effects.Run)

-- Command output normally goes to the console. When it is closed (for example after a chat command),
-- show it in a small panel instead so nothing is lost.
Cmdr:HandleEvent("AddLine", function(text: any, options: any)
	const window = Cmdr._interface.Window
	if window:IsVisible() then
		window:AddLine(text, options)
	elseif tostring(text) ~= "" then
		Notifications.Output(tostring(text))
	end
end)

-- Show only the commands this player's role may use, and refresh when the role changes.
const function refreshCommands()
	Cmdr.Dispatcher:RunBeforeCommandRegisterHooks()
end

player:GetAttributeChangedSignal("CajLevel"):Connect(refreshCommands)
task.delay(2, refreshCommands)

if player:GetAttribute("CajRole") and player:GetAttribute("CajRole") ~= "Player" then
	Notifications.Notify(`Welcome, {player:GetAttribute("CajRole")}! Press {(keys[1] or Enum.KeyCode.F2).Name} to open the console.`, "success")
end

player:GetAttributeChangedSignal("CajRole"):Connect(function()
	const role = player:GetAttribute("CajRole")
	if role and role ~= "Player" then
		Notifications.Notify(`You are now {role}. Press {(keys[1] or Enum.KeyCode.F2).Name} to open the console.`, "success")
	end
end)
]]></ProtectedString>
</Properties>
<Item class="ModuleScript" referent="RBX5D">
<Properties>
<string name="Name">Effects</string>
<ProtectedString name="Source"><![CDATA[--[[
	Client-side effects that the server asks for with Admin.Fx(player, "name", ...).
	Only the server can trigger these, so other players cannot use them on you.
]]

const Lighting = game:GetService("Lighting")
const Players = game:GetService("Players")
const RunService = game:GetService("RunService")
const StarterGui = game:GetService("StarterGui")
const TweenService = game:GetService("TweenService")
const UserInputService = game:GetService("UserInputService")

const Notifications = require(script.Parent.Notifications)

const player = Players.LocalPlayer

const Effects = {}
const handlers: { [string]: (...any) -> () } = {}

-- state
local flyConnection: RBXScriptConnection? = nil
local flyObjects: { Instance } = {}
local noclipConnection: RBXScriptConnection? = nil
local infJumpConnection: RBXScriptConnection? = nil
local viewConnection: RBXScriptConnection? = nil
local espConnections: { RBXScriptConnection } = {}
local xrayConnection: RBXScriptConnection? = nil
local xrayParts: { [BasePart]: boolean } = {}
local savedLighting: { [string]: any }? = nil
local hiddenGuis: { [ScreenGui]: boolean } = {}
local shakeCounter = 0

const function camera(): Camera
	return workspace.CurrentCamera
end

const function getHumanoid(): Humanoid?
	const character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

const function getRoot(): BasePart?
	const character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

const function overlay(name: string, color: Color3): Frame
	const screen = Instance.new("ScreenGui")
	screen.Name = name
	screen.ResetOnSpawn = false
	screen.IgnoreGuiInset = true
	screen.DisplayOrder = 500
	screen.Parent = player:WaitForChild("PlayerGui")

	const frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = color
	frame.BorderSizePixel = 0
	frame.Parent = screen
	return frame
end

----------------------------------------------------------------------------------------------------
-- Flight
----------------------------------------------------------------------------------------------------

handlers.unfly = function()
	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end

	for _, object in ipairs(flyObjects) do
		object:Destroy()
	end
	table.clear(flyObjects)

	const humanoid = getHumanoid()
	if humanoid then
		humanoid.PlatformStand = false
	end
end

handlers.fly = function(speed: number?)
	handlers.unfly()

	const root = getRoot()
	const humanoid = getHumanoid()
	if not root or not humanoid then
		return
	end

	const flySpeed = speed or 60

	const attachment = Instance.new("Attachment")
	attachment.Name = "CajFlyA"
	attachment.Parent = root

	const velocity = Instance.new("LinearVelocity")
	velocity.Name = "CajFly"
	velocity.Attachment0 = attachment
	velocity.MaxForce = math.huge
	velocity.VectorVelocity = Vector3.zero
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.Parent = root

	flyObjects = { attachment, velocity }
	humanoid.PlatformStand = true

	flyConnection = RunService.RenderStepped:Connect(function()
		const currentRoot = getRoot()
		const currentHumanoid = getHumanoid()
		if not currentRoot or not currentHumanoid or currentRoot ~= root then
			handlers.unfly()
			return
		end

		currentHumanoid.PlatformStand = true

		const cam = camera().CFrame
		local direction = currentHumanoid.MoveDirection
		-- Moving toward where the camera looks also moves up/down.
		const flatLook = Vector3.new(cam.LookVector.X, 0, cam.LookVector.Z)
		if direction.Magnitude > 0 and flatLook.Magnitude > 0.001 then
			const forwardAmount = direction:Dot(flatLook.Unit)
			direction += Vector3.new(0, cam.LookVector.Y * math.max(forwardAmount, 0), 0)
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			direction += Vector3.new(0, 1, 0)
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.Q) then
			direction -= Vector3.new(0, 1, 0)
		end

		velocity.VectorVelocity = if direction.Magnitude > 0.05 then direction.Unit * flySpeed else Vector3.zero

		if flatLook.Magnitude > 0.001 then
			currentRoot.CFrame = CFrame.lookAt(currentRoot.Position, currentRoot.Position + flatLook)
		end
	end)
end

----------------------------------------------------------------------------------------------------
-- Noclip / infinite jump
----------------------------------------------------------------------------------------------------

handlers.clip = function()
	if noclipConnection then
		noclipConnection:Disconnect()
		noclipConnection = nil
	end
end

handlers.noclip = function()
	handlers.clip()
	noclipConnection = RunService.Stepped:Connect(function()
		const character = player.Character
		if not character then
			return
		end

		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	end)
end

handlers.uninfjump = function()
	if infJumpConnection then
		infJumpConnection:Disconnect()
		infJumpConnection = nil
	end
end

handlers.infjump = function()
	handlers.uninfjump()
	infJumpConnection = UserInputService.JumpRequest:Connect(function()
		const humanoid = getHumanoid()
		if humanoid then
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end)
end

----------------------------------------------------------------------------------------------------
-- Camera
----------------------------------------------------------------------------------------------------

handlers.fov = function(degrees: number)
	TweenService:Create(camera(), TweenInfo.new(0.4), { FieldOfView = math.clamp(degrees, 1, 120) }):Play()
end

handlers.firstperson = function()
	player.CameraMode = Enum.CameraMode.LockFirstPerson
end

handlers.thirdperson = function()
	player.CameraMode = Enum.CameraMode.Classic
	player.CameraMaxZoomDistance = 128
end

handlers.zoom = function(distance: number)
	player.CameraMaxZoomDistance = math.max(distance, 0.5)
end

handlers.unview = function()
	if viewConnection then
		viewConnection:Disconnect()
		viewConnection = nil
	end

	const humanoid = getHumanoid()
	if humanoid then
		camera().CameraSubject = humanoid
	end
end

handlers.view = function(userId: number)
	handlers.unview()

	const target = Players:GetPlayerByUserId(userId)
	if not target then
		return
	end

	viewConnection = RunService.RenderStepped:Connect(function()
		const character = target.Character
		const humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid and camera().CameraSubject ~= humanoid then
			camera().CameraSubject = humanoid
		end

		if not target.Parent then
			handlers.unview()
		end
	end)
end

handlers.shake = function(seconds: number?, intensity: number?)
	shakeCounter += 1
	const id = shakeCounter
	const duration = seconds or 3
	const strength = (intensity or 1) * 0.35
	const started = os.clock()
	const name = "CajShake"

	pcall(RunService.UnbindFromRenderStep, RunService, name)
	RunService:BindToRenderStep(name, Enum.RenderPriority.Camera.Value + 1, function()
		const elapsed = os.clock() - started
		if id ~= shakeCounter or elapsed >= duration then
			RunService:UnbindFromRenderStep(name)
			return
		end

		const fade = 1 - elapsed / duration
		const offset = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * strength * fade
		camera().CFrame *= CFrame.new(offset) * CFrame.Angles(0, 0, (math.random() - 0.5) * 0.05 * strength * fade)
	end)
end

----------------------------------------------------------------------------------------------------
-- Screen effects
----------------------------------------------------------------------------------------------------

handlers.unblind = function()
	const gui = player:WaitForChild("PlayerGui"):FindFirstChild("CajBlind")
	if gui then
		gui:Destroy()
	end
end

handlers.blind = function()
	handlers.unblind()
	overlay("CajBlind", Color3.new(0, 0, 0))
end

handlers.flash = function()
	const frame = overlay("CajFlash", Color3.new(1, 1, 1))
	const tween = TweenService:Create(frame, TweenInfo.new(1.6), { BackgroundTransparency = 1 })
	tween:Play()
	tween.Completed:Connect(function()
		if frame.Parent then
			frame.Parent:Destroy()
		end
	end)
end

handlers.unblur = function()
	const blur = Lighting:FindFirstChild("CajBlur")
	if blur then
		blur:Destroy()
	end
end

handlers.blur = function(size: number?)
	handlers.unblur()
	const blur = Instance.new("BlurEffect")
	blur.Name = "CajBlur"
	blur.Size = 0
	blur.Parent = Lighting
	TweenService:Create(blur, TweenInfo.new(0.5), { Size = math.clamp(size or 20, 1, 56) }):Play()
end

handlers.unfullbright = function()
	if savedLighting then
		for property, value in pairs(savedLighting) do
			(Lighting :: any)[property] = value
		end
		savedLighting = nil
	end
end

handlers.fullbright = function()
	if not savedLighting then
		savedLighting = {
			Brightness = Lighting.Brightness,
			Ambient = Lighting.Ambient,
			OutdoorAmbient = Lighting.OutdoorAmbient,
			FogEnd = Lighting.FogEnd,
			GlobalShadows = Lighting.GlobalShadows,
		}
	end

	Lighting.Brightness = 2
	Lighting.Ambient = Color3.new(1, 1, 1)
	Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
	Lighting.FogEnd = 1e6
	Lighting.GlobalShadows = false
end

handlers.unxray = function()
	if xrayConnection then
		xrayConnection:Disconnect()
		xrayConnection = nil
	end

	for part in pairs(xrayParts) do
		part.LocalTransparencyModifier = 0
	end
	table.clear(xrayParts)
end

handlers.xray = function()
	handlers.unxray()

	const function apply(part: Instance)
		if part:IsA("BasePart") and part.Transparency < 0.9 and not (player.Character and part:IsDescendantOf(player.Character)) then
			if not part.Parent or not part.Parent:FindFirstChildOfClass("Humanoid") then
				xrayParts[part] = true
				part.LocalTransparencyModifier = 0.7
			end
		end
	end

	xrayConnection = workspace.DescendantAdded:Connect(apply)

	task.spawn(function()
		local processed = 0
		for _, descendant in ipairs(workspace:GetDescendants()) do
			apply(descendant)
			processed += 1
			if processed % 400 == 0 then
				task.wait()
			end
		end
	end)
end

handlers.unesp = function()
	for _, connection in ipairs(espConnections) do
		connection:Disconnect()
	end
	table.clear(espConnections)

	for _, other in ipairs(Players:GetPlayers()) do
		const character = other.Character
		const highlight = character and character:FindFirstChild("CajESP")
		if highlight then
			highlight:Destroy()
		end
	end
end

handlers.esp = function()
	handlers.unesp()

	const function mark(other: Player, character: Model)
		if other == player then
			return
		end

		const old = character:FindFirstChild("CajESP")
		if old then
			old:Destroy()
		end

		const highlight = Instance.new("Highlight")
		highlight.Name = "CajESP"
		highlight.FillTransparency = 0.6
		highlight.OutlineTransparency = 0
		highlight.FillColor = other.TeamColor.Color
		highlight.OutlineColor = Color3.new(1, 1, 1)
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = character
	end

	const function track(other: Player)
		if other.Character then
			mark(other, other.Character)
		end
		table.insert(
			espConnections,
			other.CharacterAdded:Connect(function(character)
				mark(other, character)
			end)
		)
	end

	for _, other in ipairs(Players:GetPlayers()) do
		track(other)
	end
	table.insert(espConnections, Players.PlayerAdded:Connect(track))
end

handlers.showgui = function()
	for gui in pairs(hiddenGuis) do
		gui.Enabled = true
	end
	table.clear(hiddenGuis)

	pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.All, true)
end

handlers.hidegui = function()
	handlers.showgui()

	for _, gui in ipairs(player:WaitForChild("PlayerGui"):GetChildren()) do
		if gui:IsA("ScreenGui") and gui.Enabled and not gui.Name:find("Caj") and gui.Name ~= "Cmdr" then
			hiddenGuis[gui] = true
			gui.Enabled = false
		end
	end

	pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.All, false)
end

handlers.countdown = function(seconds: number, caption: string?)
	Notifications.Countdown(seconds, caption)
end

handlers.reset = function()
	for _, name in ipairs({ "unfly", "clip", "uninfjump", "unview", "unblind", "unblur", "unfullbright", "unxray", "unesp", "showgui", "thirdperson" }) do
		handlers[name]()
	end

	camera().FieldOfView = 70
end

----------------------------------------------------------------------------------------------------

function Effects.Run(effect: string, ...: any)
	const handler = handlers[effect]
	if not handler then
		warn(`[CajAdmin] Unknown client effect "{effect}"`)
		return
	end

	const arguments = table.pack(...)
	task.spawn(function()
		const ok, err = pcall(handler, table.unpack(arguments, 1, arguments.n))
		if not ok then
			warn(`[CajAdmin] Client effect "{effect}" failed: {err}`)
		end
	end)
end

-- Flight stops when the character respawns.
player.CharacterAdded:Connect(function()
	handlers.unfly()
end)

return Effects
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX5E">
<Properties>
<string name="Name">Notifications</string>
<ProtectedString name="Source"><![CDATA[--[[
	On-screen messages: toasts, announcement banner, output panel and countdown.
	Everything is built in code so there is nothing to set up in Studio.
]]

const Players = game:GetService("Players")
const TweenService = game:GetService("TweenService")

const COLORS = {
	info = Color3.fromRGB(80, 170, 255),
	success = Color3.fromRGB(110, 220, 140),
	warn = Color3.fromRGB(255, 200, 60),
	error = Color3.fromRGB(255, 100, 100),
}

const BACKGROUND = Color3.fromRGB(24, 26, 32)
const TEXT = Color3.fromRGB(235, 235, 240)
const MAX_TOASTS = 6

const Notifications = {}

local gui: ScreenGui? = nil
local toastHolder: Frame? = nil
local outputPanel: Frame? = nil
local outputScroll: ScrollingFrame? = nil
local outputBuffer: { string } = {}
local outputToken = 0
local countdownToken = 0
local announceBusy = false
const announceQueue: { { string | number } } = {}

const function getGui(): ScreenGui
	if gui and gui.Parent then
		return gui
	end

	const screen = Instance.new("ScreenGui")
	screen.Name = "CajAdminUI"
	screen.ResetOnSpawn = false
	screen.IgnoreGuiInset = true
	screen.DisplayOrder = 100
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screen.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	gui = screen
	return screen
end

const function round(parent: Instance, radius: number)
	const corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
end

const function label(parent: Instance, text: string, size: number, color: Color3, font: Enum.Font?): TextLabel
	const textLabel = Instance.new("TextLabel")
	textLabel.BackgroundTransparency = 1
	textLabel.Text = text
	textLabel.TextSize = size
	textLabel.TextColor3 = color
	textLabel.Font = font or Enum.Font.GothamMedium
	textLabel.TextWrapped = true
	textLabel.TextXAlignment = Enum.TextXAlignment.Left
	textLabel.Parent = parent
	return textLabel
end

----------------------------------------------------------------------------------------------------
-- Toasts
----------------------------------------------------------------------------------------------------

const function getToastHolder(): Frame
	if toastHolder and toastHolder.Parent then
		return toastHolder
	end

	const holder = Instance.new("Frame")
	holder.Name = "Toasts"
	holder.BackgroundTransparency = 1
	holder.AnchorPoint = Vector2.new(1, 0)
	holder.Position = UDim2.new(1, -16, 0, 56)
	holder.Size = UDim2.fromOffset(340, 400)
	holder.Parent = getGui()

	const layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 8)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	layout.Parent = holder

	toastHolder = holder
	return holder
end

function Notifications.Notify(text: string, kind: string?)
	const holder = getToastHolder()

	-- Drop the oldest toast when there are too many.
	const existing = {}
	for _, child in ipairs(holder:GetChildren()) do
		if child:IsA("Frame") then
			table.insert(existing, child)
		end
	end
	if #existing >= MAX_TOASTS then
		existing[1]:Destroy()
	end

	const accent = COLORS[kind or "info"] or COLORS.info

	const toast = Instance.new("Frame")
	toast.BackgroundColor3 = BACKGROUND
	toast.BackgroundTransparency = 0.08
	toast.Size = UDim2.new(1, 0, 0, 0)
	toast.AutomaticSize = Enum.AutomaticSize.Y
	toast.LayoutOrder = math.floor(os.clock() * 1000)
	toast.Parent = holder
	round(toast, 8)

	const bar = Instance.new("Frame")
	bar.BackgroundColor3 = accent
	bar.BorderSizePixel = 0
	bar.Size = UDim2.new(0, 4, 1, 0)
	bar.Parent = toast
	round(bar, 4)

	const padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 16)
	padding.PaddingRight = UDim.new(0, 12)
	padding.PaddingTop = UDim.new(0, 10)
	padding.PaddingBottom = UDim.new(0, 10)
	padding.Parent = toast

	const content = label(toast, text, 15, TEXT)
	content.Size = UDim2.new(1, 0, 0, 0)
	content.AutomaticSize = Enum.AutomaticSize.Y

	task.delay(math.clamp(3 + #text / 20, 3, 10), function()
		if toast.Parent then
			TweenService:Create(toast, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
			TweenService:Create(content, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
			TweenService:Create(bar, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
			task.wait(0.35)
			toast:Destroy()
		end
	end)
end

----------------------------------------------------------------------------------------------------
-- Announcement banner
----------------------------------------------------------------------------------------------------

const function showNextAnnouncement()
	if announceBusy then
		return
	end

	const nextItem = table.remove(announceQueue, 1)
	if not nextItem then
		return
	end

	announceBusy = true
	const title, text, duration = nextItem[1] :: string, nextItem[2] :: string, nextItem[3] :: number

	const banner = Instance.new("Frame")
	banner.AnchorPoint = Vector2.new(0.5, 0)
	banner.Position = UDim2.new(0.5, 0, 0, -140)
	banner.Size = UDim2.new(0.6, 0, 0, 0)
	banner.AutomaticSize = Enum.AutomaticSize.Y
	banner.BackgroundColor3 = BACKGROUND
	banner.BackgroundTransparency = 0.05
	banner.Parent = getGui()
	round(banner, 12)

	const constraint = Instance.new("UISizeConstraint")
	constraint.MaxSize = Vector2.new(720, 1000)
	constraint.MinSize = Vector2.new(260, 0)
	constraint.Parent = banner

	const stroke = Instance.new("UIStroke")
	stroke.Color = COLORS.warn
	stroke.Thickness = 2
	stroke.Parent = banner

	const padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 18)
	padding.PaddingRight = UDim.new(0, 18)
	padding.PaddingTop = UDim.new(0, 12)
	padding.PaddingBottom = UDim.new(0, 14)
	padding.Parent = banner

	const layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = banner

	const titleLabel = label(banner, title, 14, COLORS.warn, Enum.Font.GothamBold)
	titleLabel.Size = UDim2.new(1, 0, 0, 18)
	titleLabel.LayoutOrder = 1

	const body = label(banner, text, 22, TEXT, Enum.Font.GothamBold)
	body.Size = UDim2.new(1, 0, 0, 0)
	body.AutomaticSize = Enum.AutomaticSize.Y
	body.LayoutOrder = 2

	TweenService:Create(banner, TweenInfo.new(0.4, Enum.EasingStyle.Back), { Position = UDim2.new(0.5, 0, 0, 24) }):Play()

	task.delay(duration, function()
		TweenService:Create(banner, TweenInfo.new(0.35), { Position = UDim2.new(0.5, 0, 0, -160) }):Play()
		task.wait(0.4)
		banner:Destroy()
		announceBusy = false
		showNextAnnouncement()
	end)
end

function Notifications.Announce(title: string, text: string, duration: number?)
	table.insert(announceQueue, { title, text, duration or 8 })
	showNextAnnouncement()
end

----------------------------------------------------------------------------------------------------
-- Output panel (command output when the console is closed, e.g. after a chat command)
----------------------------------------------------------------------------------------------------

const function getOutputPanel(): (Frame, ScrollingFrame)
	if outputPanel and outputPanel.Parent and outputScroll then
		return outputPanel, outputScroll
	end

	const panel = Instance.new("Frame")
	panel.Name = "Output"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromOffset(520, 340)
	panel.BackgroundColor3 = BACKGROUND
	panel.BackgroundTransparency = 0.05
	panel.Visible = false
	panel.Parent = getGui()
	round(panel, 10)

	const header = label(panel, "Output", 15, COLORS.warn, Enum.Font.GothamBold)
	header.Position = UDim2.fromOffset(14, 8)
	header.Size = UDim2.new(1, -60, 0, 22)

	const close = Instance.new("TextButton")
	close.Text = "X"
	close.Font = Enum.Font.GothamBold
	close.TextSize = 16
	close.TextColor3 = TEXT
	close.BackgroundColor3 = Color3.fromRGB(60, 62, 72)
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position = UDim2.new(1, -8, 0, 6)
	close.Size = UDim2.fromOffset(28, 26)
	close.Parent = panel
	round(close, 6)
	close.Activated:Connect(function()
		panel.Visible = false
	end)

	const scroll = Instance.new("ScrollingFrame")
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.Position = UDim2.fromOffset(14, 38)
	scroll.Size = UDim2.new(1, -28, 1, -50)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.new()
	scroll.ScrollBarThickness = 5
	scroll.Parent = panel

	const layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = scroll

	outputPanel = panel
	outputScroll = scroll
	return panel, scroll
end

--[[ Collects lines for a moment, then shows them together in one panel. ]]
function Notifications.Output(text: string)
	table.insert(outputBuffer, text)
	outputToken += 1
	const token = outputToken

	task.delay(0.25, function()
		if token ~= outputToken then
			return
		end

		const panel, scroll = getOutputPanel()
		scroll:ClearAllChildren()
		const layout = Instance.new("UIListLayout")
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = scroll

		for index, line in ipairs(outputBuffer) do
			const row = label(scroll, line, 14, TEXT, Enum.Font.Code)
			row.Size = UDim2.new(1, -8, 0, 0)
			row.AutomaticSize = Enum.AutomaticSize.Y
			row.LayoutOrder = index
		end

		table.clear(outputBuffer)
		panel.Visible = true

		task.delay(25, function()
			if token == outputToken then
				panel.Visible = false
			end
		end)
	end)
end

----------------------------------------------------------------------------------------------------
-- Countdown
----------------------------------------------------------------------------------------------------

function Notifications.Countdown(seconds: number, caption: string?)
	countdownToken += 1
	const token = countdownToken

	const old = getGui():FindFirstChild("Countdown")
	if old then
		old:Destroy()
	end

	const frame = Instance.new("Frame")
	frame.Name = "Countdown"
	frame.BackgroundTransparency = 1
	frame.AnchorPoint = Vector2.new(0.5, 0)
	frame.Position = UDim2.new(0.5, 0, 0.12, 0)
	frame.Size = UDim2.fromOffset(400, 150)
	frame.Parent = getGui()

	const number = label(frame, tostring(seconds), 96, TEXT, Enum.Font.GothamBlack)
	number.TextXAlignment = Enum.TextXAlignment.Center
	number.Size = UDim2.new(1, 0, 0, 100)
	number.TextStrokeTransparency = 0.4

	const sub = label(frame, caption or "", 24, COLORS.warn, Enum.Font.GothamBold)
	sub.TextXAlignment = Enum.TextXAlignment.Center
	sub.Position = UDim2.fromOffset(0, 100)
	sub.Size = UDim2.new(1, 0, 0, 36)

	task.spawn(function()
		for remaining = seconds, 1, -1 do
			if token ~= countdownToken or not frame.Parent then
				return
			end

			number.Text = tostring(remaining)
			task.wait(1)
		end

		if token == countdownToken and frame.Parent then
			number.Text = "0"
			task.wait(1)
			frame:Destroy()
		end
	end)
end

return Notifications
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX68">
<Properties>
<string name="Name">Commands</string>
</Properties>
<Item class="ModuleScript" referent="RBX60">
<Properties>
<string name="Name">Character</string>
<ProtectedString name="Source"><![CDATA[--[[
	Character: health, movement, appearance, tools, teams and teleporting.
]]

const InsertService = game:GetService("InsertService")
const Players = game:GetService("Players")
const Teams = game:GetService("Teams")

return function(Admin)
	----------------------------------------------------------------------------------------------------
	-- helpers
	----------------------------------------------------------------------------------------------------

	const function applyInvisible(_player: Player, character: Model, humanoid: Humanoid)
		Admin.SetTransparency(character, 1)
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None

		-- Accessories can finish loading a moment later.
		task.delay(1.5, function()
			if character.Parent then
				Admin.SetTransparency(character, 1)
			end
		end)
	end

	const function bodyParts(character: Model): { BasePart }
		const parts = {}
		for _, child in ipairs(character:GetChildren()) do
			if child:IsA("BasePart") and child.Name ~= "HumanoidRootPart" then
				table.insert(parts, child)
			end
		end

		return parts
	end

	--[[ Places players on a ring around a point, looking at it. Returns how many were moved. ]]
	const function teleportAround(players: { Player }, origin: Vector3, skip: Player?): number
		local index = 0
		const total = #players
		const radius = 5 + math.floor(total / 8) * 2

		return Admin.Each(players, function(player, character)
			if player == skip then
				return false
			end

			index += 1
			const angle = (index / math.max(total, 1)) * math.pi * 2
			const position = origin + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
			Admin.Teleport(character, CFrame.lookAt(position, origin))
		end)
	end

	const function describe(count: number, verb: string): string
		return Admin.Result(verb, count)
	end

	const function giveDefaults(player: Player, character: Model, humanoid: Humanoid)
		humanoid.MaxHealth = 100
		humanoid.Health = math.min(humanoid.Health, 100)
		humanoid.WalkSpeed = 16
		humanoid.UseJumpPower = true
		humanoid.JumpPower = 50
		humanoid.PlatformStand = false
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
		humanoid.DisplayName = player.DisplayName
		Admin.SetScale(humanoid, 1, 1, 1)
		Admin.SetTransparency(character, nil)

		const root = character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			root.Anchored = false
		end

		Admin.RemoveEffect(character, "CajFF")
	end

	const function scaleCommand(name: string, aliases: { string }?, description: string, argName: string, apply: (Humanoid, number) -> ())
		return {
			Name = name,
			Aliases = aliases,
			Role = "Moderator",
			Description = description,
			Args = {
				{ Type = "targets", Name = "players", Description = "The players to resize." },
				{ Type = "positiveNumber", Name = argName, Description = "Scale (1 = normal, 0.1 - 12)." },
			},
			Run = function(_, players: { Player }, value: number)
				const count = Admin.Each(players, function(_player, _character, humanoid)
					if not humanoid:FindFirstChild("BodyHeightScale") then
						return false
					end

					apply(humanoid, value)
				end)

				if count == 0 then
					return "Nobody was resized (resizing only works on R15 avatars)."
				end

				return describe(count, "Resized")
			end,
		}
	end

	----------------------------------------------------------------------------------------------------
	-- commands
	----------------------------------------------------------------------------------------------------

	return {
		-- Health -------------------------------------------------------------------------------------
		{
			Name = "kill",
			Aliases = { "slay" },
			Role = "Moderator",
			Description = "Kills players.",
			Args = { { Type = "targets", Name = "players", Description = "The players to kill." } },
			Run = function(_, players: { Player })
				return describe(
					Admin.Each(players, function(_player, _character, humanoid)
						humanoid.Health = 0
					end),
					"Killed"
				)
			end,
		},
		{
			Name = "respawn",
			Aliases = { "re" },
			Role = "Helper",
			Description = "Respawns players at their spawn point.",
			Args = { { Type = "players", Name = "players", Description = "The players to respawn." } },
			Run = function(_, players: { Player })
				return describe(
					Admin.EachPlayer(players, function(player)
						player:LoadCharacter()
					end),
					"Respawned"
				)
			end,
		},
		{
			Name = "refresh",
			Aliases = { "ref" },
			Role = "Helper",
			Description = "Respawns players and puts them back where they were standing.",
			Args = { { Type = "players", Name = "players", Description = "The players to refresh." } },
			Run = function(_, players: { Player })
				return describe(
					Admin.Each(players, function(player, _character, _humanoid, root)
						const spot = root.CFrame
						player:LoadCharacter()

						const character = player.Character
						if character and character:WaitForChild("HumanoidRootPart", 5) then
							task.wait()
							character:PivotTo(spot)
						end
					end),
					"Refreshed"
				)
			end,
		},
		{
			Name = "heal",
			Role = "Helper",
			Description = "Restores players to full health.",
			Args = { { Type = "players", Name = "players", Description = "The players to heal." } },
			Run = function(_, players: { Player })
				return describe(
					Admin.Each(players, function(_player, _character, humanoid)
						humanoid.Health = humanoid.MaxHealth
					end),
					"Healed"
				)
			end,
		},
		{
			Name = "damage",
			Aliases = { "hurt" },
			Role = "Moderator",
			Description = "Deals damage to players (force fields protect).",
			Args = {
				{ Type = "targets", Name = "players", Description = "The players to damage." },
				{ Type = "positiveNumber", Name = "amount", Description = "How much damage." },
			},
			Run = function(_, players: { Player }, amount: number)
				return describe(
					Admin.Each(players, function(_player, _character, humanoid)
						humanoid:TakeDamage(amount)
					end),
					"Damaged"
				)
			end,
		},
		{
			Name = "sethealth",
			Aliases = { "hp" },
			Role = "Moderator",
			Description = "Sets the current health of players.",
			Args = {
				{ Type = "targets", Name = "players", Description = "The players." },
				{ Type = "number", Name = "health", Description = "New health." },
			},
			Run = function(_, players: { Player }, health: number)
				return describe(
					Admin.Each(players, function(_player, _character, humanoid)
						humanoid.Health = math.clamp(health, 0, humanoid.MaxHealth)
					end),
					"Updated"
				)
			end,
		},
		{
			Name = "maxhealth",
			Aliases = { "maxhp" },
			Role = "Admin",
			Description = "Sets the maximum (and current) health of players.",
			Args = {
				{ Type = "targets", Name = "players", Description = "The players." },
				{ Type = "positiveNumber", Name = "health", Description = "New maximum health." },
			},
			Run = function(_, players: { Player }, health: number)
				return describe(
					Admin.Each(players, function(_player, _character, humanoid)
						humanoid.MaxHealth = health
						humanoid.Health = health
					end),
					"Updated"
				)
			end,
		},
		{
			Name = "god",
			Aliases = { "godmode" },
			Role = "Admin",
			Description = "Gives players infinite health (kept after respawning).",
			Args = { { Type = "targets", Name = "players", Description = "The players." } },
			Run = function(_, players: { Player })
				return describe(
					Admin.EachPlayer(players, function(player)
						Admin.SetState(player, "god", function(_, _character, humanoid)
							humanoid.MaxHealth = math.huge
							humanoid.Health = math.huge
						end)
					end),
					"Made invincible"
				)
			end,
		},
		{
			Name = "ungod",
			Role = "Admin",
			Description = "Removes god mode.",
			Args = { { Type = "players", Name = "players", Description = "The players." } },
			Run = function(_, players: { Player })
				return describe(
					Admin.EachPlayer(players, function(player)
						Admin.ClearState(player, "god")
						const humanoid = Admin.GetHumanoid(player)
						if humanoid then
							humanoid.MaxHealth = 100
							humanoid.Health = 100
						end
					end),
					"Updated"
				)
			end,
		},
		{
			Name = "ff",
			Aliases = { "forcefield" },
			Role = "Moderator",
			Description = "Gives players a force field.",
			Args = { { Type = "targets", Name = "players", Description = "The players." } },
			Run = function(_, players: { Player })
				return describe(
					Admin.Each(players, function(_player, character)
						Admin.RemoveEffect(character, "CajFF")
						const field = Instance.new("ForceField")
						field.Name = "CajFF"
						field.Parent = character
					end),
					"Protected"
				)
			end,
		},
		{
			Name = "unff",
			Aliases = { "unforcefield" },
			Role = "Moderator",
			Description = "Removes force fields.",
			Args = { { Type = "players", Name = "players", Description = "The players." } },
			Run = function(_, players: { Player })
				return describe(
					Admin.Each(players, function(_player, character)
						for _, child in ipairs(character:GetChildren()) do
							if child:IsA("ForceField") then
								child:Destroy()
							end
						end
					end),
					"Updated"
				)
			end,
		},

		-- Movement stats -------------------------------------------------------------------------------
		{
			Name = "speed",
			Aliases = { "ws", "walkspeed" },
			Role = "Moderator",
			Description = "Sets walk speed (default 16, kept after respawning).",
			Args = {
				{ Type = "targets", Name = "players", Description = "The players." },
				{ Type = "number", Name = "speed", Description = "Studs per second (0-500)." },
			},
			Run = function(_, players: { Player }, speed: number)
				const value = math.clamp(speed, 0, 500)
				return describe(
					Admin.EachPlayer(players, function(player)
						Admin.SetState(player, "speed", function(_, _character, humanoid)
							humanoid.WalkSpeed = value
						end)
					end),
					"Updated"
				)
			end,
		},
		{
			Name = "jumppower",
			Aliases = { "jp" },
			Role = "Moderator",
			Description = "Sets jump power (default 50, kept after respawning).",
			Args = {
				{ Type = "targets", Name = "players", Description = "The players." },
				{ Type = "number", Name = "power", Description = "Jump power (0-1000)." },
			},
			Run = function(_, players: { Player }, power: number)
				const value = math.clamp(power, 0, 1000)
				return describe(
					Admin.EachPlayer(players, function(player)
						Admin.SetState(player, "jump", function(_, _character, humanoid)
							humanoid.UseJumpPower = true
							humanoid.JumpPower = value
						end)
					end),
					"Updated"
				)
			end,
		},
		{
			Name = "jumpheight",
			Aliases = { "jh" },
			Role = "Moderator",
			Description = "Sets jump height in studs (default 7.2, kept after respawning).",
			Args = {
				{ Type = "targets", Name = "players", Description = "The players." },
				{ Type = "number", Name = "height", Description = "Jump height in studs (0-500)." },
			},
			Run = function(_, players: { Player }, height: number)
				const value = math.clamp(height, 0, 500)
				return describe(
					Admin.EachPlayer(players, function(player)
						Admin.SetState(player, "jump", function(_, _character, humanoid)
							humanoid.UseJumpPower = false
							humanoid.JumpHeight = value
						end)
					end),
					"Updated"
