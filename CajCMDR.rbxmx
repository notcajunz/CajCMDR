<Item class="ModuleScript" referent="RBX47">
<Properties>
<string name="Name">Vector</string>
<ProtectedString name="Source"><![CDATA[const AXES: { string } = { "X", "Y", "Z" }

const function validateVector(value: number?, index: number): (boolean, string?)
	if value == nil then
		return false, `Invalid or missing number at position {index} in Vector type.`
	end

	return true
end

return function(registry: any)
	const vector3Type = registry.Cmdr.Util.MakeSequenceType({
		ValidateEach = validateVector,
		TransformEach = tonumber,
		Constructor = Vector3.new,
		Length = 3,
	})

	const vector2Type = registry.Cmdr.Util.MakeSequenceType({
		ValidateEach = validateVector,
		TransformEach = tonumber,
		Constructor = Vector2.new,
		Length = 2,
	})

	const positionVector3Type = registry.Cmdr.Util.MakeSequenceType({
		Transform = function(text: string, executor: Player): { number? }
			const character = executor.Character
			const currentPosition = if character then character:GetPivot().Position else Vector3.zero

			return registry.Cmdr.Util.Map(
				registry.Cmdr.Util.SplitPrioritizedDelimeter(text, { ",", "%s" }),
				function(value: string, index: number): number?
					if value:sub(1, 1) ~= "~" then
						return tonumber(value)
					end

					const axis = AXES[index]
					const currentComponent = if axis then currentPosition[axis] else 0
					const offset = tonumber(value:sub(2))
					return if value == "~" then currentComponent elseif offset then currentComponent + offset else nil
				end
			)
		end,
		ValidateEach = validateVector,
		Constructor = Vector3.new,
		Length = 3,
	})

	registry:RegisterType("vector3", vector3Type)
	registry:RegisterType("vector3s", registry.Cmdr.Util.MakeListableType(vector3Type))

	registry:RegisterType("vector2", vector2Type)
	registry:RegisterType("vector2s", registry.Cmdr.Util.MakeListableType(vector2Type))

	registry:RegisterType("positionVector3", positionVector3Type)
	registry:RegisterType("positionVector3s", registry.Cmdr.Util.MakeListableType(positionVector3Type))
end
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="ModuleScript" referent="RBX5B">
<Properties>
<string name="Name">CmdrClient</string>
<ProtectedString name="Source"><![CDATA[const RunService = game:GetService("RunService")

const IS_CLIENT = RunService:IsClient()
assert(
	IS_CLIENT,
	"[Cmdr] The Cmdr client library cannot be required by the server. Please require the server libary instead."
)

const Dispatcher = require("@self/Shared/Dispatcher")
const Registry = require("@self/Shared/Registry")
const Util = require("@self/Shared/Util")

const CmdrInterface = require("@self/CmdrInterface")
const DefaultEventHandlers = require("@self/DefaultEventHandlers")

const TypesFolder = script:WaitForChild("Types") :: Folder
const CommandsFolder = script:WaitForChild("Commands") :: Folder

type Signal = {
	Fire: (self: Signal, ...any) -> (),
	Connect: (self: Signal, callback: (...any) -> ()) -> RBXScriptConnection,
}

const function createSignal(): Signal
	const event = Instance.new("BindableEvent")

	return {
		Fire = function(_, ...)
			event:Fire(...)
		end,

		Connect = function(_, callback)
			return event.Event:Connect(callback)
		end,
	}
end

--[=[
	@class CmdrClient
	@client

	The Cmdr client object and entry point.
]=]

--[=[
	@within CmdrClient
	@readonly

	@prop Registry Registry

	Refers to the command Registry.
]=]

--[=[
	@within CmdrClient
	@readonly

	@prop Dispatcher Dispatcher

	Refers to the command Dispatcher.
]=]

--[=[
	@within CmdrClient
	@readonly

	@prop Util Util

	Refers to a table containing many useful utility functions.
]=]

--[=[
	@within CmdrClient
	@readonly

	@prop Gui ScreenGui

	Refers to the current Cmdr GUI.
]=]

--[=[
	@within CmdrClient
	@readonly

	@prop Toggled { Connect: (self: Toggled, callback: (visible: boolean) -> ()) -> RBXScriptConnection, Fire: (self: Toggled, visible: boolean) -> () }

	A signal that fires when the Cmdr window is toggled.
]=]

--[=[
	@within CmdrClient
	@readonly
	@private

	@prop _interface CmdrInterface

	Refers to the CmdrInterface object.
]=]

--[=[
	@within CmdrClient
	@readonly
	@private

	@prop _replicatedRoot ModuleScript

	Refers to the CmdrClient modulescript containing all shared functionality.
]=]

--[=[
	@within CmdrClient
	@readonly
	@private

	@prop _remoteEvent RemoteEvent

	Refers to the CmdrEvent RemoteEvent found within CmdrClient.
]=]

--[=[
	@within CmdrClient
	@readonly
	@private

	@prop _remoteFunction RemoteFunction

	Refers to the CmdrFunction RemoteFunction found within CmdrClient.
]=]

--[=[
	@within CmdrClient
	@readonly
	@private

	@prop _enabled boolean

	Whether or not Cmdr is enabled (will show via the defined activation keys). Use [`CmdrClient:SetEnabled`](#SetEnabled) to change.
]=]

--[=[
	@within CmdrClient
	@readonly
	@private

	@prop _activationKeys { Enum.KeyCode }

	The list of key codes that will show or hide Cmdr. Use [`CmdrClient:SetActivationKeys`](#SetActivationKeys) to change.
]=]

--[=[
	@within CmdrClient
	@readonly
	@private

	@prop _activationUnlocksMouse boolean

	Whether or not activating the Cmdr window will unlock the mouse.
]=]

--[=[
	@within CmdrClient
	@readonly
	@private

	@prop _mashToEnable boolean

	Whether or not mashing to enabled is enabled. Use [`CmdrClient:SetMashToEnable`](#SetMashToEnable) to change.
]=]

--[=[
	@within CmdrClient
	@readonly
	@private

	@prop _hideOnLostFocus boolean

	Whether or not losing focus will hide the Cmdr window.
]=]

--[=[
	@within CmdrClient
	@readonly
	@private

	@prop _placeName string

	The current place name, displayed on the interface. Use [`CmdrClient:SetPlaceName`](#SetPlaceName) to change.
]=]

--[=[
	@within CmdrClient
	@readonly
	@private

	@prop _events { [string]: (any) -> () }

	A collection of event callbacks used by Cmdr.
]=]

const CmdrClient = {
	Registry = nil :: Registry.Registry?,
	Dispatcher = nil :: any,
	Util = Util,

	Gui = nil :: ScreenGui?,
	Toggled = createSignal(),

	_interface = nil :: any,

	_replicatedRoot = script,
	_remoteEvent = script:WaitForChild("CmdrEvent") :: RemoteEvent,
	_remoteFunction = script:WaitForChild("CmdrFunction") :: RemoteFunction,

	_enabled = true,
	_activationKeys = { Enum.KeyCode.F2 },
	_activationUnlocksMouse = false,
	_mashToEnable = false,
	_hideOnLostFocus = true,

	_placeName = "Cmdr",

	_events = {} :: { [string]: (any) -> () },
}

--[=[
	@within CmdrClient
	Sets whether or not Cmdr can be shown via the defined activation keys. Useful for when you want users to opt-in to show the console, for instance in a settings menu.
]=]
function CmdrClient:SetEnabled(enabled: boolean)
	self._enabled = enabled

	if not enabled then
		self:Hide()
	end
end

--[=[
	@within CmdrClient
	Sets the key codes that will be used to toggle Cmdr.
]=]
function CmdrClient:SetActivationKeys(keys: { Enum.KeyCode })
	self._activationKeys = keys
	self._interface.Window:BindActivationKeys()
end

--[=[
	@within CmdrClient
	Sets if activation will free the mouse.
]=]
function CmdrClient:SetActivationUnlocksMouse(enabled: boolean)
	self._activationUnlocksMouse = enabled
	self._interface.Window:UpdateMouseUnlock()
end

--[=[
	@within CmdrClient
	Shows the Cmdr window. Does nothing if Cmdr isn't enabled.
]=]
function CmdrClient:Show()
	if not self._enabled then
		return
	end

	self._interface.Window:Show()
end

--[=[
	@within CmdrClient
	Hides the Cmdr window.
]=]
function CmdrClient:Hide()
	self._interface.Window:Hide()
end

--[=[
	@within CmdrClient
	Toggles the Cmdr window. Does nothing if Cmdr isn't enabled.
]=]
function CmdrClient:Toggle()
	if self._enabled then
		self._interface.Window:SetVisible(not self._interface.Window:IsVisible())
	end
end

--[=[
	@within CmdrClient
	Enables the "Mash to enable" feature.
	This feature, when enabled, requires the [activation key](#SetActivationKeys) to be pressed 5 times within a second to enable Cmdr.
	This may be helpful to guard against mispresses from opening the window, for example.
]=]
function CmdrClient:SetMashToEnable(enabled: boolean)
	self._mashToEnable = enabled
end

--[=[
	@within CmdrClient
	Sets the hide on 'lost focus' feature.
	This feature, which is enabled by default, will cause Cmdr to [hide](#Hide) when the user clicks off the window.
]=]
function CmdrClient:SetHideOnLostFocus(enabled: boolean)
	self._hideOnLostFocus = enabled
end

--[=[
	@within CmdrClient
	Sets the place name label on the interface. This is useful for a quick way to tell what game you're playing in a universe game.
]=]
function CmdrClient:SetPlaceName(name: string)
	self._placeName = name
	self._interface.Window:UpdateLabelText()
end

--[=[
	@within CmdrClient
	Sets the [network event handler](/docs/networkeventhandlers) for a certain event type.
]=]
function CmdrClient:HandleEvent(name: string, callback: (...any) -> ())
	self._events[name] = callback
end

-- Initialize CmdrClient
const function initialize()
	CmdrClient.Registry = Registry(CmdrClient)
	CmdrClient.Dispatcher = Dispatcher(CmdrClient)
	CmdrClient._interface = CmdrInterface(CmdrClient)

	CmdrClient._remoteEvent.OnClientEvent:Connect(function(eventName: string, ...)
		if not CmdrClient._events[eventName] then
			return
		end

		CmdrClient._events[eventName](...)
	end)

	CmdrClient.Registry:RegisterTypesIn(TypesFolder)
	CmdrClient.Registry:RegisterCommandsIn(CommandsFolder)

	TypesFolder.ChildAdded:Connect(function(child: Instance)
		if not child:IsA("ModuleScript") then
			warn(`[Cmdr] Ignored non-module child in Types: {child.Name}`)
			return
		end

		require(child)(CmdrClient.Registry)
	end)

	CommandsFolder.ChildAdded:Connect(function(child: Instance)
		if not child:IsA("ModuleScript") then
			warn(`[Cmdr] Ignored non-module child in Commands: {child.Name}`)
			return
		end

		CmdrClient.Registry:RegisterCommand(child)
	end)
end

initialize()
DefaultEventHandlers(CmdrClient)

-- Export CmdrClient
return setmetatable(CmdrClient, {
	__index = function(self, key)
		const dispatcher = rawget(self, "Dispatcher")
		const value = dispatcher and dispatcher[key]
		assert(value, `[Cmdr] Dispatcher has no method or property "{key}".`)

		if type(value) == "function" then
			Util:_emitDeprecationWarning("ProxyCalls")

			return function(_, ...)
				return value(dispatcher, ...)
			end
		end

		return nil
	end,
	__newindex = function(_, key)
		error(`[Cmdr] Cannot assign key "{key}"; the CmdrClient object is read-only.`)
	end,
})
]]></ProtectedString>
</Properties>
<Item class="ModuleScript" referent="RBX4C">
<Properties>
<string name="Name">CmdrInterface</string>
<ProtectedString name="Source"><![CDATA[const CreateGui = require("@self/CreateGui")
const WindowModule = require("@self/Window")
const AutoCompleteModule = require("@self/AutoComplete")

return function(CmdrClient)
	CmdrClient.Gui = CreateGui()

	const AutoComplete = AutoCompleteModule(CmdrClient)
	const Window = WindowModule(CmdrClient, AutoComplete)

	Window:UpdateLabelText()
	Window:UpdateWindowHeight()

	return {
		Window = Window,
		AutoComplete = AutoComplete,
	}
end
]]></ProtectedString>
</Properties>
<Item class="ModuleScript" referent="RBX49">
<Properties>
<string name="Name">AutoComplete</string>
<ProtectedString name="Source"><![CDATA[const VALID_TEXT_COLOR = Color3.fromRGB(255, 255, 255)
const INVALID_TEXT_COLOR = Color3.fromRGB(255, 73, 73)
const TEXT_MEASUREMENT_SIZE = Vector2.new(1000, 1000)

--[=[
	@class AutoComplete
	@ignore
	Handles the Cmdr suggestions interface.
]=]

return function(CmdrClient)
	const autoCompleteFrame = CmdrClient.Gui:WaitForChild("Autocomplete") :: ScrollingFrame
	const defaultBarThickness = autoCompleteFrame.ScrollBarThickness

	const AutoComplete = {
		_autoItem = autoCompleteFrame:WaitForChild("TextButton") :: TextButton,
		_title = autoCompleteFrame:WaitForChild("Title") :: TextLabel,
		_description = autoCompleteFrame:WaitForChild("Description") :: TextLabel,
		_entry = CmdrClient.Gui.Frame:WaitForChild("Entry") :: Frame,

		Items = {},
		SelectedItem = 1,

		Prefix = "",
		LastItem = false,

		Command = nil,
		Arg = nil,
		NumArgs = nil,
		IsPartial = false,
	}

	-- Updates the size of the container.
	const function updateContainerSize()
		const titleWidth = AutoComplete._title.Field.TextBounds.X
		const typeWidth = AutoComplete._title.Field.Type.TextBounds.X
		const frameWidth = autoCompleteFrame.Size.X.Offset

		const availableHeight = autoCompleteFrame.Parent.AbsoluteSize.Y - autoCompleteFrame.AbsolutePosition.Y - 10
		const contentHeight = autoCompleteFrame.UIListLayout.AbsoluteContentSize.Y

		const xOffset = math.max(titleWidth + typeWidth, frameWidth)
		const yOffset = math.min(contentHeight, availableHeight)
		autoCompleteFrame.Size = UDim2.fromOffset(xOffset, yOffset)
	end

	--[=[
		@within AutoComplete
		@private

		Updates the position of the container.
	]=]
	function AutoComplete:_updateContainerPosition(offset: number?)
		const entryPosition = self._entry.TextBox.AbsolutePosition
		const xOffset = if offset then entryPosition.X - 10 + offset else entryPosition.X
		const yOffset = entryPosition.Y + 30
		autoCompleteFrame.Position = UDim2.fromOffset(xOffset, yOffset)
	end

	--[=[
		@within AutoComplete
		@private

		Sets the text of the provided object.
	]=]
	function AutoComplete:_setText(object: GuiObject, textObject: TextLabel, text: string?, sizeFromContents: boolean)
		object.Visible = text ~= nil
		textObject.Text = text or ""

		if sizeFromContents then
			const textSize = CmdrClient.Util.GetTextSize(text or "", textObject, TEXT_MEASUREMENT_SIZE)
			textObject.Size = UDim2.new(0, textSize.X, object.Size.Y.Scale, object.Size.Y.Offset)
		end
	end

	--[=[
		@within AutoComplete
		@private

		Updates the displayed auto completion info.
	]=]
	function AutoComplete:_updateInfoDisplay(options: any)
		const typeName = options.type and `{options.type:sub(1, 1):upper()}{options.type:sub(2)}`
		const typeText = typeName and `: {typeName}`
		self:_setText(self._title, self._title.Field, options.name, true)
		self:_setText(self._title.Field.Type, self._title.Field.Type, typeText)
		self:_setText(self._description, self._description.Label, options.description)

		self._description.Label.TextColor3 = if options.invalid then INVALID_TEXT_COLOR else VALID_TEXT_COLOR
		self._description.Size = UDim2.new(1, 0, 0, 40)

		while not self._description.Label.TextFits do
			self._description.Size = self._description.Size + UDim2.fromOffset(0, 2)

			if self._description.Size.Y.Offset > 500 then
				break
			end
		end

		task.wait()
		updateContainerSize()
		autoCompleteFrame.ScrollBarThickness = defaultBarThickness
	end

	--[=[
		@within AutoComplete
		Shows the autocomplete menu.
	]=]
	function AutoComplete:Show(items: any, options: any)
		options = options or {}

		for _, item in ipairs(self.Items) do
			if item.gui then
				item.gui:Destroy()
			end
		end

		self.SelectedItem = 1
		self.Items = items

		self.Prefix = options.prefix or ""
		self.LastItem = options.isLast or false

		self.Command = options.command
		self.Arg = options.arg
		self.NumArgs = options.numArgs
		self.IsPartial = options.isPartial

		local autocompleteWidth = 200
		autoCompleteFrame.ScrollBarThickness = 0

		for index, item in ipairs(items) do
			const typedText = item[1]
			const suggestionText = item[2]
			const button = self._autoItem:Clone()
			button.Name = `{typedText}{suggestionText}`
			button.BackgroundTransparency = if index == self.SelectedItem then 0.5 else 1

			local start, stop = suggestionText:lower():find(typedText:lower(), 1, true)
			if not start then
				start = 1
				stop = #suggestionText
			end

			const prefix = suggestionText:sub(1, start - 1)
			const suffix = suggestionText:sub(stop + 1)
			button.Typed.Text = `{(" "):rep(start - 1)}{typedText}`
			button.Suggest.Text = `{prefix}{(" "):rep(#typedText)}{suffix}`

			button.LayoutOrder = index
			button.Parent = autoCompleteFrame

			const maxBounds = math.max(button.Typed.TextBounds.X, button.Suggest.TextBounds.X) + 20
			autocompleteWidth = math.max(autocompleteWidth, maxBounds)

			item.gui = button
		end

		const text = self._entry.TextBox.Text
		const words = CmdrClient.Util.SplitString(text)
		if text:sub(#text, #text) == " " and not options.at then
			words[#words + 1] = "e"
		end

		table.remove(words, #words)

		const positionOffset = (options.at or (#table.concat(words, " ") + 1)) * 7
		const sizeOffset = UDim2.fromOffset(autocompleteWidth, autoCompleteFrame.UIListLayout.AbsoluteContentSize.Y)
		self:_updateContainerPosition(positionOffset)
		autoCompleteFrame.Size = sizeOffset
		autoCompleteFrame.Visible = true

		self:_updateInfoDisplay(if self.Items[1] and self.Items[1].options then self.Items[1].options else options)
	end

	--[=[
		@within AutoComplete
		Returns the selected autocomplete item.
	]=]
	function AutoComplete:GetSelectedItem()
		if not autoCompleteFrame.Visible then
			return nil
		end

		return self.Items[self.SelectedItem]
	end

	--[=[
		@within AutoComplete
		Hides the autocomplete menu.
	]=]
	function AutoComplete:Hide()
		autoCompleteFrame.Visible = false
	end

	--[=[
		@within AutoComplete
		Returns whether autocomplete is visible.
	]=]
	function AutoComplete:IsVisible()
		return autoCompleteFrame.Visible
	end

	--[=[
		@within AutoComplete
		Changes the current selection.
	]=]
	function AutoComplete:Select(delta: number)
		if not autoCompleteFrame.Visible then
			return
		end

		self.SelectedItem += delta

		if self.SelectedItem > #self.Items then
			self.SelectedItem = 1
		elseif self.SelectedItem < 1 then
			self.SelectedItem = #self.Items
		end

		for index, item in ipairs(self.Items) do
			item.gui.BackgroundTransparency = if index == self.SelectedItem then 0.5 else 1
		end

		const headerHeight = self._title.Size.Y.Offset + self._description.Size.Y.Offset
		const itemPosition = self.SelectedItem * self._autoItem.Size.Y.Offset
		const ySize = headerHeight + itemPosition - autoCompleteFrame.Size.Y.Offset
		autoCompleteFrame.CanvasPosition = Vector2.new(0, math.max(0, ySize))

		const selectedItem = self.Items[self.SelectedItem]
		if selectedItem and selectedItem.options then
			self:_updateInfoDisplay(selectedItem.options)
		end
	end

	AutoComplete._autoItem.Parent = nil
	autoCompleteFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateContainerSize)

	return AutoComplete
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX4A">
<Properties>
<string name="Name">CreateGui</string>
<ProtectedString name="Source"><![CDATA[const Players = game:GetService("Players")
const StarterGui = game:GetService("StarterGui")

const Player = Players.LocalPlayer
const PlayerGui = Player:WaitForChild("PlayerGui")

-- ContextActionService does not receive clicks over other UI, so a non-sinking layer observes those
const function createInputLayers(gui: ScreenGui)
	if not gui:FindFirstChild("Backdrop") then
		const Backdrop = Instance.new("Frame")
		Backdrop.Active = false
		Backdrop.BackgroundTransparency = 1
		Backdrop.Name = "Backdrop"
		Backdrop.Size = UDim2.fromScale(1, 1)
		Backdrop.Visible = false
		Backdrop.ZIndex = 0
		Backdrop.Parent = gui
	end

	if not gui:FindFirstChild("MouseUnlocker") then
		const MouseUnlocker = Instance.new("TextButton")
		MouseUnlocker.Active = false
		MouseUnlocker.BackgroundTransparency = 1
		MouseUnlocker.Modal = true
		MouseUnlocker.Name = "MouseUnlocker"
		MouseUnlocker.Selectable = false
		MouseUnlocker.Size = UDim2.fromOffset(0, 0)
		MouseUnlocker.Text = ""
		MouseUnlocker.Visible = false
		MouseUnlocker.Parent = gui
	end
end

return function(): ScreenGui
	if StarterGui:FindFirstChild("Cmdr") then
		const Cmdr = PlayerGui:WaitForChild("Cmdr") :: ScreenGui
		createInputLayers(Cmdr)
		return Cmdr
	end

	const Cmdr = Instance.new("ScreenGui")
	Cmdr.DisplayOrder = 1000
	Cmdr.Name = "Cmdr"
	Cmdr.ResetOnSpawn = false
	Cmdr.AutoLocalize = false

	const Frame = Instance.new("ScrollingFrame")
	Frame.BackgroundColor3 = Color3.fromRGB(17, 17, 17)
	Frame.BackgroundTransparency = 0.4
	Frame.BorderSizePixel = 0
	Frame.CanvasSize = UDim2.new(0, 0, 0, 0)
	Frame.Name = "Frame"
	Frame.Position = UDim2.new(0.025, 0, 0, 25)
	Frame.ScrollBarThickness = 6
	Frame.ScrollingDirection = Enum.ScrollingDirection.Y
	Frame.Selectable = false
	Frame.Size = UDim2.fromScale(0.95, 0)
	Frame.Visible = false
	Frame.AutomaticCanvasSize = Enum.AutomaticSize.Y
	Frame.Parent = Cmdr

	const Autocomplete = Instance.new("ScrollingFrame")
	Autocomplete.BackgroundColor3 = Color3.fromRGB(59, 59, 59)
	Autocomplete.BackgroundTransparency = 0.5
	Autocomplete.BorderSizePixel = 0
	Autocomplete.CanvasSize = UDim2.new(0, 0, 0, 0)
	Autocomplete.Name = "Autocomplete"
	Autocomplete.Position = UDim2.fromOffset(167, 75)
	Autocomplete.ScrollBarThickness = 6
	Autocomplete.ScrollingDirection = Enum.ScrollingDirection.Y
	Autocomplete.Selectable = false
	Autocomplete.Size = UDim2.fromOffset(200, 200)
	Autocomplete.Visible = false
	Autocomplete.AutomaticCanvasSize = Enum.AutomaticSize.Y
	Autocomplete.Parent = Cmdr

	const UIListLayout = Instance.new("UIListLayout")
	UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
	UIListLayout.Parent = Frame

	const Line = Instance.new("TextBox")
	Line.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	Line.BackgroundTransparency = 1
	Line.Font = Enum.Font.Code
	Line.Name = "Line"
	Line.Size = UDim2.new(1, 0, 0, 20)
	Line.AutomaticSize = Enum.AutomaticSize.Y
	Line.TextColor3 = Color3.fromRGB(255, 255, 255)
	Line.TextSize = 14
	Line.TextXAlignment = Enum.TextXAlignment.Left
	Line.TextEditable = false
	Line.ClearTextOnFocus = false
	Line.Parent = Frame

	const UIPadding = Instance.new("UIPadding")
	UIPadding.PaddingBottom = UDim.new(0, 10)
	UIPadding.PaddingLeft = UDim.new(0, 10)
	UIPadding.PaddingRight = UDim.new(0, 10)
	UIPadding.PaddingTop = UDim.new(0, 10)
	UIPadding.Parent = Frame

	const Entry = Instance.new("Frame")
	Entry.BackgroundTransparency = 1
	Entry.LayoutOrder = 999999999
	Entry.Name = "Entry"
	Entry.Size = UDim2.new(1, 0, 0, 20)
	Entry.Parent = Frame

	const UIListLayout2 = Instance.new("UIListLayout")
	UIListLayout2.SortOrder = Enum.SortOrder.LayoutOrder
	UIListLayout2.Parent = Autocomplete

	const Title = Instance.new("Frame")
	Title.BackgroundColor3 = Color3.fromRGB(59, 59, 59)
	Title.BackgroundTransparency = 0.2
	Title.BorderSizePixel = 0
	Title.LayoutOrder = -2
	Title.Name = "Title"
	Title.Size = UDim2.new(1, 0, 0, 40)
	Title.Parent = Autocomplete

	const Description = Instance.new("Frame")
	Description.BackgroundColor3 = Color3.fromRGB(59, 59, 59)
	Description.BackgroundTransparency = 0.2
	Description.BorderSizePixel = 0
	Description.LayoutOrder = -1
	Description.Name = "Description"
	Description.Size = UDim2.new(1, 0, 0, 20)
	Description.Parent = Autocomplete

	const TextButton = Instance.new("TextButton")
	TextButton.BackgroundColor3 = Color3.fromRGB(59, 59, 59)
	TextButton.BackgroundTransparency = 0.5
	TextButton.BorderSizePixel = 0
	TextButton.Font = Enum.Font.Code
	TextButton.Size = UDim2.new(1, 0, 0, 30)
	TextButton.Text = ""
	TextButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	TextButton.TextSize = 14
	TextButton.TextXAlignment = Enum.TextXAlignment.Left
	TextButton.Parent = Autocomplete

	const UIListLayout3 = Instance.new("UIListLayout")
	UIListLayout3.FillDirection = Enum.FillDirection.Horizontal
	UIListLayout3.SortOrder = Enum.SortOrder.LayoutOrder
	UIListLayout3.Padding = UDim.new(0, 7)
	UIListLayout3.Parent = Entry

	const TextBox = Instance.new("TextBox")
	TextBox.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	TextBox.BackgroundTransparency = 1
	TextBox.ClearTextOnFocus = false
	TextBox.Font = Enum.Font.Code
	TextBox.LayoutOrder = 999999999
	TextBox.Position = UDim2.fromOffset(140, 0)
	TextBox.Size = UDim2.new(1, 0, 0, 20)
	TextBox.Text = "x"
	TextBox.TextColor3 = Color3.fromRGB(255, 255, 255)
	TextBox.TextSize = 14
	TextBox.TextXAlignment = Enum.TextXAlignment.Left
	TextBox.Selectable = false
	TextBox.Parent = Entry

	const TextLabel = Instance.new("TextLabel")
	TextLabel.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	TextLabel.BackgroundTransparency = 1
	TextLabel.Font = Enum.Font.Code
	TextLabel.Size = UDim2.fromOffset(0, 20)
	TextLabel.AutomaticSize = Enum.AutomaticSize.X
	TextLabel.Text = ""
	TextLabel.TextColor3 = Color3.fromRGB(255, 223, 93)
	TextLabel.TextSize = 14
	TextLabel.TextXAlignment = Enum.TextXAlignment.Left
	TextLabel.Parent = Entry

	const Field = Instance.new("TextLabel")
	Field.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	Field.BackgroundTransparency = 1
	Field.Font = Enum.Font.SourceSansBold
	Field.Name = "Field"
	Field.Size = UDim2.new(0, 37, 1, 0)
	Field.Text = "from"
	Field.TextColor3 = Color3.fromRGB(255, 255, 255)
	Field.TextSize = 20
	Field.TextXAlignment = Enum.TextXAlignment.Left
	Field.Parent = Title

	const UIPadding2 = Instance.new("UIPadding")
	UIPadding2.PaddingLeft = UDim.new(0, 10)
	UIPadding2.Parent = Title

	const Label = Instance.new("TextLabel")
	Label.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	Label.BackgroundTransparency = 1
	Label.Font = Enum.Font.SourceSansLight
	Label.Name = "Label"
	Label.Size = UDim2.fromScale(1, 1)
	Label.Text = "The players to teleport. The players to teleport. The players to teleport. The players to teleport. "
	Label.TextColor3 = Color3.fromRGB(255, 255, 255)
	Label.TextSize = 16
	Label.TextWrapped = true
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.TextYAlignment = Enum.TextYAlignment.Top
	Label.Parent = Description

	const UIPadding3 = Instance.new("UIPadding")
	UIPadding3.PaddingBottom = UDim.new(0, 10)
	UIPadding3.PaddingLeft = UDim.new(0, 10)
	UIPadding3.PaddingRight = UDim.new(0, 10)
	UIPadding3.Parent = Description

	const Typed = Instance.new("TextLabel")
	Typed.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	Typed.BackgroundTransparency = 1
	Typed.Font = Enum.Font.Code
	Typed.Name = "Typed"
	Typed.Size = UDim2.fromScale(1, 1)
	Typed.Text = "Lab"
	Typed.TextColor3 = Color3.fromRGB(131, 222, 255)
	Typed.TextSize = 14
	Typed.TextXAlignment = Enum.TextXAlignment.Left
	Typed.Parent = TextButton

	const UIPadding4 = Instance.new("UIPadding")
	UIPadding4.PaddingLeft = UDim.new(0, 10)
	UIPadding4.Parent = TextButton

	const Suggest = Instance.new("TextLabel")
	Suggest.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	Suggest.BackgroundTransparency = 1
	Suggest.Font = Enum.Font.Code
	Suggest.Name = "Suggest"
	Suggest.Size = UDim2.fromScale(1, 1)
	Suggest.Text = "   el"
	Suggest.TextColor3 = Color3.fromRGB(255, 255, 255)
	Suggest.TextSize = 14
	Suggest.TextXAlignment = Enum.TextXAlignment.Left
	Suggest.Parent = TextButton

	const Type = Instance.new("TextLabel")
	Type.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	Type.BackgroundTransparency = 1
	Type.BorderColor3 = Color3.fromRGB(255, 153, 153)
	Type.Font = Enum.Font.SourceSans
	Type.Name = "Type"
	Type.Position = UDim2.fromScale(1, 0)
	Type.Size = UDim2.fromScale(0, 1)
	Type.Text = ": Players"
	Type.TextColor3 = Color3.fromRGB(255, 255, 255)
	Type.TextSize = 15
	Type.TextXAlignment = Enum.TextXAlignment.Left
	Type.Parent = Field

	createInputLayers(Cmdr)

	Cmdr.Parent = PlayerGui
	return Cmdr
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX4B">
<Properties>
<string name="Name">Window</string>
<ProtectedString name="Source"><![CDATA[const ContextActionService = game:GetService("ContextActionService")
const GuiService = game:GetService("GuiService")
const Players = game:GetService("Players")
const TextChatService = game:GetService("TextChatService")
const UserInputService = game:GetService("UserInputService")

const WINDOW_MAX_HEIGHT = 300
const MOUSE_TOUCH_INPUTS =
	{ Enum.UserInputType.MouseButton1, Enum.UserInputType.MouseButton2, Enum.UserInputType.Touch }

const ACTION_PRIORITY = Enum.ContextActionPriority.High.Value
const ACTIVATION_ACTION = "CmdrActivation"
const REFOCUS_ACTION = "CmdrRefocus"
const CLICK_OUTSIDE_ACTION = "CmdrClickOutside"

const VALID_TEXT_COLOR = Color3.fromRGB(255, 255, 255)
const INVALID_TEXT_COLOR = Color3.fromRGB(255, 73, 73)
const PROCESSING_TEXT_COLOR = Color3.fromRGB(255, 223, 93)
const ERROR_TEXT_COLOR = Color3.fromRGB(255, 153, 153)

const Player = Players.LocalPlayer

-- Checks if a screen position lies outside a given GUI bounds
const function isPositionOutsideGui(position: Vector3, gui: GuiObject): boolean
	const topLeft = gui.AbsolutePosition
	const bottomRight = topLeft + gui.AbsoluteSize
	return position.X < topLeft.X or position.X > bottomRight.X or position.Y < topLeft.Y or position.Y > bottomRight.Y
end

-- Constructs auto-completed text string from command argument definitions
const function buildAutoCompleteText(command, lastArg, replace: string): string
	const parts = { command.Alias }
	for _, argument in command.Arguments do
		local segments = argument.RawSegments
		if argument == lastArg then
			segments = table.clone(segments)
			segments[#segments] = replace
		end

		const argumentText = `{argument.Prefix}{table.concat(segments, ",")}`
		const needsQuotes = argumentText == "" or argumentText:find(" ", 1, true) ~= nil
		table.insert(parts, if needsQuotes then ("%q"):format(argumentText) else argumentText)

		if argument == lastArg then
			break
		end
	end

	return table.concat(parts, " ")
end

-- Acting on release keeps the key's own character out of a TextBox focused in response to it
const function onKeyReleased(callback: () -> ())
	local pressed = false

	return function(_, state: Enum.UserInputState): Enum.ContextActionResult
		if state == Enum.UserInputState.Begin then
			pressed = true
		elseif state == Enum.UserInputState.End and pressed then
			pressed = false
			callback()
		else
			pressed = false
		end

		return Enum.ContextActionResult.Pass
	end
end

--[=[
	@class Window
	@ignore
	Handles the Cmdr command bar interface.
]=]

return function(CmdrClient, AutoComplete)
	const entryFrame = CmdrClient.Gui:WaitForChild("Frame")
	const Window = {
		_entry = entryFrame:WaitForChild("Entry") :: Frame,
		_lineTemplate = entryFrame:WaitForChild("Line") :: TextBox,
		_backdrop = CmdrClient.Gui:WaitForChild("Backdrop") :: Frame,
		_mouseUnlocker = CmdrClient.Gui:WaitForChild("MouseUnlocker") :: TextButton,

		_previousChatStates = {} :: { [any]: boolean },
		_visibleInputConnection = nil :: RBXScriptConnection?,
		_hasLostFocus = false,

		_valid = true,
		_errorText = nil :: string?,
		_historyState = nil :: { Position: number, InitialText: string }?,

		_pressCount = 0,
		_lastPressTime = 0,
	}

	--[=[
		@within Window
		Get the text entry label
	]=]
	function Window:GetLabelText()
		return self._entry.TextLabel.Text
	end

	--[=[
		@within Window
		Updates the command prompt label.
	]=]
	function Window:UpdateLabelText()
		const placeName = CmdrClient._placeName
		self._entry.TextLabel.Text = `{Player.Name}{if placeName and placeName ~= "" then `@{placeName}` else ""}$`
	end

	--[=[
		@within Window
		Recalculate the window height
	]=]
	function Window:UpdateWindowHeight()
		const layout = entryFrame.UIListLayout
		const padding = entryFrame.UIPadding
		const height = layout.AbsoluteContentSize.Y + padding.PaddingTop.Offset + padding.PaddingBottom.Offset

		const xSize = entryFrame.Size.X
		const clampedHeight = math.clamp(height, 0, WINDOW_MAX_HEIGHT)

		entryFrame.Size = UDim2.new(xSize.Scale, xSize.Offset, 0, clampedHeight)
		entryFrame.CanvasPosition = Vector2.new(0, height)
		AutoComplete:_updateContainerPosition()
	end

	--[=[
		@within Window
		@private

		Sets the command entry text.
	]=]
	function Window:_setEntryText(text: string)
		self._entry.TextBox.Text = text

		if self:IsVisible() then
			self._entry.TextBox.CursorPosition = #text + 1
			self:UpdateWindowHeight()
		end
	end

	--[=[
		@within Window
		Returns the current command entry text.
	]=]
	function Window:GetEntryText(): string
		return (self._entry.TextBox.Text:gsub("\t", ""))
	end

	--[=[
		@within Window
		Adds a line to the command output.
	]=]
	function Window:AddLine(text: any, options: any)
		const lineText = tostring(text)
		const lineOptions = if typeof(options) == "Color3" then { Color = options } else options or {}

		if lineText == "" then
			self:UpdateWindowHeight()
			return
		end

		const line = self._lineTemplate:Clone()
		line.Text = CmdrClient.Util.EmulateTabstops(lineText, 8)
		line.TextColor3 = lineOptions.Color or line.TextColor3
		line.RichText = lineOptions.RichText or false
		line.Parent = entryFrame
	end

	--[=[
		@within Window
		@private

		Sets the visibility of the Roblox chat interface.
	]=]
	function Window:_setChatEnabled(enabled: boolean)
		if enabled then
			for configuration, wasEnabled in self._previousChatStates do
				configuration.Enabled = wasEnabled
			end

			table.clear(self._previousChatStates)
			return
		end

		const configurations = {
			TextChatService.ChatWindowConfiguration,
			TextChatService.ChatInputBarConfiguration,
			TextChatService.ChannelTabsConfiguration,
		}

		for _, configuration in configurations do
			self._previousChatStates[configuration] = configuration.Enabled
			configuration.Enabled = false
		end
	end

	--[=[
		@within Window
		Unlocks the mouse while the command bar is visible, if activation is set to unlock it.
	]=]
	function Window:UpdateMouseUnlock()
		self._mouseUnlocker.Visible = self:IsVisible() and CmdrClient._activationUnlocksMouse
	end

	--[=[
		@within Window
		Sets whether the command bar is visible.
	]=]
	function Window:SetVisible(visible: boolean)
		if entryFrame.Visible == visible then
			return
		end

		entryFrame.Visible = visible
		self:_setChatEnabled(not visible)
		self:_setInputBound(visible)
		self:UpdateMouseUnlock()

		if visible then
			self._entry.TextBox:CaptureFocus()
			self:_setEntryText("")
		else
			AutoComplete:Hide()
			self._entry.TextBox:ReleaseFocus()
		end

		CmdrClient.Toggled:Fire(visible)
	end

	--[=[
		@within Window
		Returns whether the command bar is currently visible.
	]=]
	function Window:IsVisible(): boolean
		return entryFrame.Visible
	end

	--[=[
		@within Window
		Hides the command bar.
	]=]
	function Window:Hide()
		self:SetVisible(false)
	end

	--[=[
		@within Window
		Shows the command bar.
	]=]
	function Window:Show()
		self:SetVisible(true)
	end

	--[=[
		@within Window
		@private

		Sets whether the current input is valid.
	]=]
	function Window:_setIsValidInput(isValid: boolean, errorText: string?)
		self._entry.TextBox.TextColor3 = if isValid then VALID_TEXT_COLOR else INVALID_TEXT_COLOR
		self._valid = isValid
		self._errorText = errorText
	end

	--[=[
		@within Window
		Clears the invalid input visual state.
	]=]
	function Window:HideInvalidState()
		self._entry.TextBox.TextColor3 = VALID_TEXT_COLOR
	end

	--[=[
		@within Window
		@private

		Navigates through the command history buffer using an index delta.
	]=]
	function Window:_traverseHistory(delta: number)
		const history = CmdrClient.Dispatcher:GetHistory()
		if not self._historyState then
			self._historyState = {
				Position = #history + 1,
				InitialText = self:GetEntryText(),
			}
		end

		self._historyState.Position = math.clamp(self._historyState.Position + delta, 1, #history + 1)
		self:_setEntryText(
			if self._historyState.Position == #history + 1
				then self._historyState.InitialText
				else history[self._historyState.Position]
		)
	end

	--[=[
		@within Window
		@private

		Resets the stored command history navigation state.
	]=]
	function Window:_clearHistoryState()
		self._historyState = nil
	end

	--[=[
		@within Window
		@private

		Handles vertical directional navigation.
	]=]
	function Window:_selectVertical(delta: number)
		if AutoComplete:IsVisible() and not self._historyState then
			AutoComplete:Select(delta)
		else
			self:_traverseHistory(delta)
		end
	end

	--[=[
		@within Window
		@private

		Trims the input command text.
	]=]
	function Window:_processEntry(text: string)
		const trimmedText = CmdrClient.Util.TrimString(text)

		if #trimmedText == 0 then
			return
		end

		self:AddLine(`{self:GetLabelText()} {trimmedText}`, PROCESSING_TEXT_COLOR)
		self:AddLine(CmdrClient.Dispatcher:EvaluateAndRun(trimmedText, Player, { IsHuman = true }))
	end

	--[=[
		@within Window
		@private

		Handles the entry losing focus, hiding on escape and running the entry when submitted.
	]=]
	function Window:_loseFocus(submit: boolean, cause: InputObject?)
		if self._hasLostFocus then
			return
		end

		const text = self._entry.TextBox.Text
		self:_clearHistoryState()

		--[[
		NOTE: This behavior exists to recapture focus when pressing on anywhere within the UI.
		While I understand the purpose for this, it prevents users from copying text of previous output,
		and immediately recaptures the UI when closing it via escape. I have removed this for the time being.
		This might be worth revisiting sometime in the future if enough complaints appear however.

		if self:IsVisible() and not GuiService.MenuIsOpen and not UserInputService.TouchEnabled then
			self._entry.TextBox:CaptureFocus()
		else
		--]]

		if cause and cause.KeyCode == Enum.KeyCode.Escape then
			self:Hide()
		elseif submit then
			self._hasLostFocus = true

			task.defer(function()
				if self:IsVisible() then
					self._entry.TextBox:CaptureFocus()
				end
			end)

			if self._valid then
				self:_setEntryText("")
				self:_processEntry(text)
			else
				self:AddLine(self._errorText, ERROR_TEXT_COLOR)
			end

			self._hasLostFocus = false
		end
	end

	--[=[
		@within Window
		@private

		Process activation toggle keys.
	]=]
	function Window:_handleActivationKey()
		if not CmdrClient._enabled then
			return
		end

		const currentTime = os.clock()
		if CmdrClient._mashToEnable then
			-- Increment mash counter if pressed within 1 second window
			self._pressCount = if currentTime - self._lastPressTime < 1 then self._pressCount + 1 else 1
			self._lastPressTime = currentTime

			if self._pressCount >= 5 then
				self._pressCount = 0
				CmdrClient._mashToEnable = false
				self:SetVisible(true)
			end
		else
			self:SetVisible(not self:IsVisible())
		end
	end

	--[=[
		@within Window
		@private

		Handles Tab key auto-completion logic.
	]=]
	function Window:_handleTabCompletion()
		const item = AutoComplete:GetSelectedItem()
		const text = self:GetEntryText()

		if not item or (AutoComplete.LastItem and text:match("%s$")) then
			self:_setEntryText(text)
			return
		end

		const command = AutoComplete.Command
		const newText = if command then buildAutoCompleteText(command, AutoComplete.Arg, item[2]) else item[2]
		const insertSpace = not command
			or (AutoComplete.NumArgs ~= #command.ArgumentDefinitions and not AutoComplete.IsPartial)

		self:_setEntryText(if insertSpace then `{newText} ` else newText)
	end

	function Window:_handlePointerInput(input: InputObject)
		if
			CmdrClient._hideOnLostFocus
			and table.find(MOUSE_TOUCH_INPUTS, input.UserInputType)
			and isPositionOutsideGui(input.Position, entryFrame)
		then
			self:Hide()
		end
	end

	function Window:_handleVisibleInput(input: InputObject, gameProcessed: boolean)
		const keyCode = input.KeyCode

		if table.find(CmdrClient._activationKeys, keyCode) then
			if gameProcessed then
				self:Hide()
			end
		elseif keyCode == Enum.KeyCode.Backspace and input:IsModifierKeyDown(Enum.ModifierKey.Ctrl) then
			self:_setEntryText("")
		elseif keyCode == Enum.KeyCode.Down then
			self:_selectVertical(1)
		elseif keyCode == Enum.KeyCode.Up then
			self:_selectVertical(-1)
		elseif input.UserInputType == Enum.UserInputType.Keyboard and keyCode ~= Enum.KeyCode.Tab then
			self:_clearHistoryState()
		end
	end

	const activationAction = onKeyReleased(function()
		Window:_handleActivationKey()
	end)

	const refocusAction = onKeyReleased(function()
		Window._entry.TextBox:CaptureFocus()
	end)

	const function clickOutsideAction(_, state: Enum.UserInputState, input: InputObject): Enum.ContextActionResult
		if state == Enum.UserInputState.Begin then
			Window:_handlePointerInput(input)
		end

		return Enum.ContextActionResult.Pass
	end

	function Window:BindActivationKeys()
		ContextActionService:UnbindAction(ACTIVATION_ACTION)

		if #CmdrClient._activationKeys == 0 then
			return
		end

		ContextActionService:BindActionAtPriority(
			ACTIVATION_ACTION,
			activationAction,
			false,
			ACTION_PRIORITY,
			table.unpack(CmdrClient._activationKeys)
		)
	end

	function Window:_setInputBound(bound: boolean)
		self._backdrop.Visible = bound

		if bound then
			ContextActionService:BindActionAtPriority(
				REFOCUS_ACTION,
				refocusAction,
				false,
				ACTION_PRIORITY,
				Enum.KeyCode.Tab
			)
			ContextActionService:BindActionAtPriority(
				CLICK_OUTSIDE_ACTION,
				clickOutsideAction,
				false,
				ACTION_PRIORITY,
				table.unpack(MOUSE_TOUCH_INPUTS)
			)

			self._visibleInputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
				self:_handleVisibleInput(input, gameProcessed)
			end)
		else
			ContextActionService:UnbindAction(REFOCUS_ACTION)
			ContextActionService:UnbindAction(CLICK_OUTSIDE_ACTION)

			if self._visibleInputConnection then
				self._visibleInputConnection:Disconnect()
				self._visibleInputConnection = nil
			end
		end
	end

	--[=[
		@within Window
		@private

		Processes autocomplete for command arguments once a command name is active.
	]=]
	function Window:_handleArgumentAutoComplete(
		command: any,
		arguments: { string },
		text: string,
		hasTrailingSpace: boolean,
		atEnd: boolean
	)
		const commandValid, commandError = command:Validate()
		self:_setIsValidInput(commandValid, `Validation errors: {commandError or ""}`)

		const lastArgument = command:GetArgument(#arguments)
		if not lastArgument then
			return
		end

		const autocompleteItems = {}
		const typedText = lastArgument.TextSegmentInProgress
		local isPartial = false

		if lastArgument.RawSegmentsAreAutocomplete then
			for index, segment in lastArgument.RawSegments do
				autocompleteItems[index] = { segment, segment }
			end
		else
			const items, options = lastArgument:GetAutocomplete()
			isPartial = options and options.IsPartial or false

			for index, item in items do
				autocompleteItems[index] = { typedText, item }
			end
		end

		local argumentValid, argumentError = true, nil
		if #typedText > 0 then
			argumentValid, argumentError = lastArgument:Validate()
		end

		if not atEnd and argumentValid then
			self:HideInvalidState()
		end

		AutoComplete:Show(autocompleteItems, {
			at = atEnd and #text - #typedText + (if hasTrailingSpace then -1 else 0),
			prefix = if #lastArgument.RawSegments == 1 then lastArgument.Prefix else "",
			isLast = #command.Arguments == #command.ArgumentDefinitions and #typedText > 0,
			numArgs = #arguments,
			command = command,
			arg = lastArgument,
			name = `{lastArgument.Name}{if lastArgument.Required then "" else "?"}`,
			type = lastArgument.Type.DisplayName,
			description = if argumentValid then lastArgument.Object.Description else argumentError,
			invalid = not argumentValid,
			isPartial = isPartial,
		})
	end

	--[=[
		@within Window
		@private

		Processes autocomplete for initial command name lookup.
	]=]
	function Window:_handleCommandAutoComplete(commandText: string, command: any)
		self:_setIsValidInput(true)

		const exactCommand = CmdrClient.Registry:GetCommand(commandText)
		local exactMatch

		if exactCommand and not exactCommand._isHidden then
			-- selene: allow(mixed_table)
			exactMatch = {
				exactCommand.Name,
				exactCommand.Name,
				options = {
					name = exactCommand.Name,
					description = exactCommand.Description,
				},
			}

			local argument = exactCommand.Args and exactCommand.Args[1]
			if type(argument) == "function" then
				argument = argument(command)
			end

			if argument and not argument.Optional and argument.Default == nil then
				self:_setIsValidInput(false, "This command has required arguments.")
				self:HideInvalidState()
			end
		else
			self:_setIsValidInput(
				false,
				`{commandText} is not a valid command name. Use the help command to see all available commands.`
			)
		end

		const loweredText = commandText:lower()
		const autocompleteItems = { exactMatch }
		-- selene: allow(mixed_table)
		for _, commandName in CmdrClient.Registry:GetCommandNames(true) do
			if commandName:lower():sub(1, #loweredText) ~= loweredText then
				continue
			end

			if exactMatch and exactMatch[1] == commandName then
				continue
			end

			const commandObject = CmdrClient.Registry:GetCommand(commandName)
			table.insert(autocompleteItems, {
				commandText,
				commandName,
				options = {
					name = commandObject.Name,
					description = commandObject.Description,
				},
			})
		end

		AutoComplete:Show(autocompleteItems)
	end

	--[=[
		@within Window
		@private

		Fired whenever the command input text changes. Validates inputs and updates the autocomplete view.
	]=]
	function Window:_onTextChanged(text: string)
		const command = CmdrClient.Dispatcher:Evaluate(text, Player, true)
		local arguments = CmdrClient.Util.SplitString(text)
		const commandText = table.remove(arguments, 1)

		const hasTrailingSpace = text:match("%s$") ~= nil
		local atEnd = false
		if command then
			arguments = CmdrClient.Util.MashExcessArguments(arguments, #command.Object.Args)
			atEnd = #arguments == #command.Object.Args
		end

		local entryComplete = commandText and #arguments > 0
		if hasTrailingSpace and not atEnd then
			entryComplete = true
			table.insert(arguments, "")
		end

		if command and entryComplete then
			self:_handleArgumentAutoComplete(command, arguments, text, hasTrailingSpace, atEnd)
		elseif commandText and #arguments == 0 then
			self:_handleCommandAutoComplete(commandText, command)
		else
			self:_setIsValidInput(false, "Use the help command to see all available commands.")
			AutoComplete:Hide()
		end
	end

	const entryTextBox = Window._entry.TextBox

	entryTextBox.FocusLost:Connect(function(submit: boolean, cause: InputObject?)
		Window:_loseFocus(submit, cause)
	end)

	entryTextBox:GetPropertyChangedSignal("Text"):Connect(function()
		const text = entryTextBox.Text
		entryFrame.CanvasPosition = Vector2.new(0, entryFrame.AbsoluteCanvasSize.Y)

		if text:find("\t", 1, true) then
			Window:_handleTabCompletion()
		elseif text:find("[\r\n]") then
			Window:_setEntryText((text:gsub("[\r\n]", "")))
		else
			Window:_onTextChanged(text)
		end
	end)

	Window._backdrop.InputBegan:Connect(function(input: InputObject)
		Window:_handlePointerInput(input)
	end)

	GuiService.MenuOpened:Connect(function()
		Window:Hide()
	end)

	entryFrame.ChildAdded:Connect(function()
		task.defer(Window.UpdateWindowHeight, Window)
	end)

	Window._lineTemplate.Parent = script
	Window:BindActivationKeys()

	return Window
end
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="ModuleScript" referent="RBX4D">
<Properties>
<string name="Name">DefaultEventHandlers</string>
<ProtectedString name="Source"><![CDATA[const TextChatService = game:GetService("TextChatService")

const TextChannels = TextChatService:WaitForChild("TextChannels")
const RBXSystem: TextChannel = TextChannels:WaitForChild("RBXSystem")

return function(CmdrClient)
	CmdrClient:HandleEvent("Message", function(text: string)
		RBXSystem:DisplaySystemMessage(`<font color="rgb(249, 217, 56)">[Announcement] {text}</font>`)
	end)

	CmdrClient:HandleEvent("AddLine", function(...: any)
		CmdrClient._interface.Window:AddLine(...)
	end)

	CmdrClient:HandleEvent("RunBeforeCommandRegisterHooks", function()
		CmdrClient.Dispatcher:RunBeforeCommandRegisterHooks()
	end)
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="Folder" referent="RBX5A">
<Properties>
<string name="Name">Shared</string>
</Properties>
<Item class="ModuleScript" referent="RBX4E">
<Properties>
<string name="Name">Argument</string>
<ProtectedString name="Source"><![CDATA[const Util = require("./Util")

const function unescapeOperators(text: string): string
	for _, operator in ipairs({ "%.", "%?", "%*", "%*%*" }) do
		text = text:gsub(`\\{operator}`, operator:gsub("%%", ""))
	end

	return text
end

--[=[
	@class ArgumentContext
	Represents an individual argument within an individual command execution.
]=]

const Argument = {}
Argument.__index = Argument

--[=[
	@within ArgumentContext
	@readonly
	@prop Command CommandContext

	The command that this argument belongs to.
]=]

--[=[
	@within ArgumentContext
	@readonly
	@prop Type TypeDefinition

	The type definition for this argument.
]=]

--[=[
	@within ArgumentContext
	@readonly
	@prop Name string

	The name of this argument, shown on the autocomplete interface.
]=]

--[=[
	@within ArgumentContext
	@readonly
	@prop Object ArgumentDefinition

	The raw argument definition.
]=]

--[=[
	@within ArgumentContext
	@readonly
	@prop Required boolean

	Whether or not this argument was required.
]=]

--[=[
	@within ArgumentContext
	@readonly
	@prop Executor Player

	The player that ran the command that this argument belongs to.
]=]

--[=[
	@within ArgumentContext
	@readonly
	@prop RawValue string

	The raw, unparsed value for this argument.
]=]

--[=[
	@within ArgumentContext
	@readonly
	@prop RawSegments {string}

	An array of strings representing the values in a comma-separated list, if applicable.
]=]

--[=[
	@within ArgumentContext
	@readonly
	@prop Prefix string

	The prefix used in this argument (like `%` in `%Team`). Empty string if no prefix was used. See [Prefixed Union Types](/docs/commands#prefixed-union-types) for more details.
]=]

--[=[
	@within ArgumentContext
	@private
	@prop TextSegmentInProgress any

	The text of the raw segment the user is currently typing.
]=]

--[=[
	@within ArgumentContext
	@private
	@prop RawSegmentsAreAutocomplete boolean

	Whether the raw segments were generated from autocomplete.
]=]

--[=[
	@within ArgumentContext
	@private
	@prop TransformedValues {any}

	The transformed value (generated later).
]=]

--[=[
	@within ArgumentContext
	@private

	@param command CommandContext -- The command that owns this argument
	@param argumentDefinition ArgumentDefinition -- The raw argument definition
	@param value any -- The raw, unparsed value
	@return ArgumentContext

	Returns a new ArgumentContext, an object that handles parsing and validating arguments.
]=]
function Argument.new(command: any, argumentDefinition: any, value: any)
	const self = {
		Command = command,
		Type = nil,
		Name = argumentDefinition.Name,
		Object = argumentDefinition,
		Required = argumentDefinition.Default == nil and argumentDefinition.Optional ~= true,
		Executor = command.Executor,
		RawValue = value,
		RawSegments = {},
		TransformedValues = {},
		Prefix = "",
		TextSegmentInProgress = "",
		RawSegmentsAreAutocomplete = false,
	}

	if type(argumentDefinition.Type) == "table" then
		self.Type = argumentDefinition.Type
	else
		const typeName = command.Cmdr.Registry:GetTypeName(argumentDefinition.Type)
		const parsedType, parsedRawValue, prefix = Util.ParsePrefixedUnionType(typeName, value)
		const existingType = command.Dispatcher.Registry:GetType(parsedType)
		assert(
			existingType,
			`[Cmdr] Argument "{self.Name or "none"}" has an unregistered type {parsedType or "<none>"}`
		)

		self.Type = existingType
		self.RawValue = parsedRawValue
		self.Prefix = prefix
	end

	setmetatable(self, Argument)

	self:Transform()

	return self
end

--[=[
	@within ArgumentContext
	@private

	Transforms a raw argument segment.
]=]
function Argument:TransformSegment(rawSegment: string): any
	if self.Type.Transform then
		return self.Type.Transform(rawSegment, self.Executor)
	end

	return rawSegment
end

--[=[
	@within ArgumentContext
	@private

	Returns the default autocomplete results.
]=]
function Argument:GetDefaultAutocomplete()
	if not self.Type.Autocomplete then
		return {}
	end

	const strings, options = self.Type.Autocomplete(self:TransformSegment(""))
	return strings, options or {}
end

--[=[
	@within ArgumentContext
	@private

	Calls the transform function on this argument.
	The return value(s) from this function are passed to all of the other argument methods.
	Called automatically at instantiation.
]=]
function Argument:Transform()
	if #self.TransformedValues ~= 0 then
		return
	end

	local rawValue = self.RawValue
	if self.Type.ArgumentOperatorAliases then
		rawValue = self.Type.ArgumentOperatorAliases[rawValue] or rawValue
	end

	if rawValue == "." and self.Type.Default then
		rawValue = self.Type.Default(self.Executor) or ""
		self.RawSegmentsAreAutocomplete = true
	end

	if rawValue == "?" and self.Type.Autocomplete then
		const strings, options = self:GetDefaultAutocomplete()

		if not options.IsPartial and #strings > 0 then
			rawValue = strings[math.random(1, #strings)]
			self.RawSegmentsAreAutocomplete = true
		end
	end

	if self.Type.Listable and #self.RawValue > 0 then
		const randomMatch = rawValue:match("^%?(%d+)$")

		if randomMatch then
			const maxSize = tonumber(randomMatch)

			if maxSize and maxSize > 0 then
				const remainingItems, options = self:GetDefaultAutocomplete()
				const items = {}
				if not options.IsPartial and #remainingItems > 0 then
					for _ = 1, math.min(maxSize, #remainingItems) do
						table.insert(items, table.remove(remainingItems, math.random(1, #remainingItems)))
					end

					rawValue = table.concat(items, ",")
					self.RawSegmentsAreAutocomplete = true
				end
			end
		elseif rawValue == "*" or rawValue == "**" then
			const strings, options = self:GetDefaultAutocomplete()
			if not options.IsPartial and #strings > 0 then
				if rawValue == "**" and self.Type.Default then
					const defaultString = self.Type.Default(self.Executor) or ""

					for index, string in ipairs(strings) do
						if string == defaultString then
							table.remove(strings, index)
						end
					end
				end

				rawValue = table.concat(strings, ",")
				self.RawSegmentsAreAutocomplete = true
			end
		end

		rawValue = unescapeOperators(rawValue)

		local rawSegments = Util.SplitStringSimple(rawValue, ",")
		if #rawSegments == 0 then
			rawSegments = { "" }
		end

		if rawValue:sub(#rawValue, #rawValue) == "," then
			rawSegments[#rawSegments + 1] = "" -- makes auto complete tick over right after pressing ,
		end

		for index, rawSegment in ipairs(rawSegments) do
			self.RawSegments[index] = rawSegment
			self.TransformedValues[index] = { self:TransformSegment(rawSegment) }
		end

		self.TextSegmentInProgress = rawSegments[#rawSegments]
	else
		rawValue = unescapeOperators(rawValue)

		self.RawSegments[1] = unescapeOperators(rawValue)
		self.TransformedValues[1] = { self:TransformSegment(rawValue) }
		self.TextSegmentInProgress = self.RawValue
	end
end

--[=[
	@within ArgumentContext

	Returns the transformed value from this argument, see Types.
]=]
function Argument:GetTransformedValue(segment: number): ...any
	return unpack(self.TransformedValues[segment])
end

--[=[
	@within ArgumentContext
	@private

	Validates that the argument will work without any type errors.
]=]
function Argument:Validate(isFinal: boolean?): (boolean, string?)
	if not self.RawValue or #self.RawValue == 0 and self.Required == false then
		return true
	end

	if self.Required and (not self.RawSegments[1] or #self.RawSegments[1] == 0) then
		return false, "This argument is required."
	end

	if self.Type.Validate or self.Type.ValidateOnce then
		for index = 1, #self.TransformedValues do
			if self.Type.Validate then
				const valid, errorText = self.Type.Validate(self:GetTransformedValue(index))
				if not valid then
					return valid, errorText or "Invalid value"
				end
			end

			if isFinal and self.Type.ValidateOnce then
				const validOnce, errorTextOnce = self.Type.ValidateOnce(self:GetTransformedValue(index))
				if not validOnce then
					return validOnce, errorTextOnce
				end
			end
		end

		return true
	else
		return true
	end
end

--[=[
	@within ArgumentContext
	@private

	Gets a list of all possible values that could match based on the current value.
]=]
function Argument:GetAutocomplete()
	if not self.Type.Autocomplete then
		return {}
	end

	return self.Type.Autocomplete(self:GetTransformedValue(#self.TransformedValues))
end

--[=[
	@within ArgumentContext
	@private

	Parses a transformed argument segment.
]=]
function Argument:_parseValue(segment: number)
	if self.Type.Parse then
		return self.Type.Parse(self:GetTransformedValue(segment))
	else
		return self:GetTransformedValue(segment)
	end
end

--[=[
	@within ArgumentContext

	Returns the parsed (final) value for this argument.
]=]
function Argument:GetValue(): any
	if #self.RawValue == 0 and not self.Required and self.Object.Default ~= nil then
		return self.Object.Default
	end

	if not self.Type.Listable then
		return self:_parseValue(1)
	end

	const values = {}
	for index = 1, #self.TransformedValues do
		const parsedValue = self:_parseValue(index)
		assert(type(parsedValue) == "table", `[Cmdr] Listable types must return a table from Parse {self.Type.Name}`)

		for _, value in pairs(parsedValue) do
			values[value] = true
		end
	end

	const valueArray = {}
	for value in pairs(values) do
		valueArray[#valueArray + 1] = value
	end

	return valueArray
end

return Argument
]]></ProtectedString>
</Properties>
</Item>
<Item class="Folder" referent="RBX55">
<Properties>
<string name="Name">BuiltInGuards</string>
</Properties>
<Item class="ModuleScript" referent="RBX4F">
<Properties>
<string name="Name">HasCharacter</string>
<ProtectedString name="Source"><![CDATA[const Players = game:GetService("Players")
const RunService = game:GetService("RunService")

const IS_SERVER = RunService:IsServer()

const function hasValidCharacter(player: Player): boolean
	const character = player.Character
	return character ~= nil and character:FindFirstChild("HumanoidRootPart") ~= nil
end

return function(index: number?)
	return function(context: any): string?
		local target: Player | { Player } = context.Executor
		if index then
			const arg = context:GetArgument(index)
			target = if arg then arg:GetValue() else nil
		end

		const isSingle = typeof(target) == "Instance" and target:IsA("Player")
		const isList = typeof(target) == "table" and typeof(target[1]) == "Instance" and target[1]:IsA("Player")

		if not (isSingle or isList) then
			return nil
		end

		const players: { Player } = if isSingle then { target :: Player } else target :: { Player }
		const canVerifyEveryone = IS_SERVER or not workspace.StreamingEnabled

		for _, player in ipairs(players) do
			const canVerify = canVerifyEveryone or player == Players.LocalPlayer
			if not canVerify or hasValidCharacter(player) then
				continue
			end

			if isSingle then
				return if index then "Target player has no character." else "You don't have a character."
			end

			return if #players == 1
				then "Target player has no character."
				else "One or more target players don't have a character."
		end

		return nil
	end
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX50">
<Properties>
<string name="Name">IsDataStoreAvailable</string>
<ProtectedString name="Source"><![CDATA[const RunService = game:GetService("RunService")

return function(index: number)
	return function(context: any): string?
		const argContext = context:GetArgument(index)
		local key = if argContext then argContext:GetValue() else nil

		if type(key) ~= "string" then
			return nil
		end

		local saved = true

		if key:sub(1, 1) == "$" then
			key = key:sub(2)
		end

		if key:sub(1, 1) == "." then
			saved = false
		end

		if not saved then
			return nil
		end

		if RunService:IsClient() then
			if game.PlaceId == 0 then
				return "# You must publish this place to the web to use saved keys."
			end
		elseif not context.Cmdr.Util.GetDataStore() then
			return "# You must publish this place to the web to use saved keys."
		end

		return nil
	end
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX51">
<Properties>
<string name="Name">MaxArrayLength</string>
<ProtectedString name="Source"><![CDATA[return function(index: number, maxCount: number)
	return function(context: any): string?
		const argContext = context:GetArgument(index)
		const value = argContext and argContext:GetValue()

		return if typeof(value) == "table" and #value > maxCount
			then `Argument #{index} exceeds the maximum allowed limit of {maxCount} items.`
			else nil
	end
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX52">
<Properties>
<string name="Name">MaxStringLength</string>
<ProtectedString name="Source"><![CDATA[return function(index: number, maxLength: number)
	return function(context: any): string?
		const argContext = context:GetArgument(index)
		const value = argContext and argContext:GetValue()

		return if typeof(value) == "string" and #value > maxLength
			then `Argument #{index} exceeds the maximum character limit of {maxLength}`
			else nil
	end
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX53">
<Properties>
<string name="Name">NonEmptyString</string>
<ProtectedString name="Source"><![CDATA[return function(index: number)
	return function(context: any): string?
		const argContext = context:GetArgument(index)
		const value = argContext and argContext:GetValue()

		return if typeof(value) ~= "string" or value:match("^%s*$")
			then `Argument #{index} cannot be empty or blank.`
			else nil
	end
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX54">
<Properties>
<string name="Name">NotEquals</string>
<ProtectedString name="Source"><![CDATA[return function(index: number, forbiddenValue: any)
	return function(context: any): string?
		const argContext = context:GetArgument(index)
		const value = argContext and argContext:GetValue()

		return if value == forbiddenValue then `Argument #{index} cannot be "{forbiddenValue}".` else nil
	end
end
]]></ProtectedString>
