<Item class="ModuleScript" referent="RBX1E">
<Properties>
<string name="Name">alias</string>
<ProtectedString name="Source"><![CDATA[return {
	Name = "alias",
	Description = "Creates a new, single command out of a command and given arguments.",
	Group = "DefaultUtil",
	Args = {
		{
			Type = "string",
			Name = "Alias name",
			Description = "The key or input type you'd like to bind the command to.",
		},
		{
			Type = "string",
			Name = "Command string",
			Description = 'The command text you want to run. Separate multiple commands with "&&". Accept arguments with $1, $2, $3, etc.',
		},
	},

	ClientRun = function(context: any, name: string, commandString: string): string
		context.Cmdr.Registry:RegisterCommandObject(context.Cmdr.Util.MakeAliasCommand(name, commandString), true)
		return `Created alias {name}.`
	end,
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX1F">
<Properties>
<string name="Name">bind</string>
<ProtectedString name="Source"><![CDATA[const ContextActionService = game:GetService("ContextActionService")
const Players = game:GetService("Players")
const TextChatService = game:GetService("TextChatService")

local hasHelperRan = false

const function runBindHelper(Cmdr)
	Players.PlayerRemoving:Connect(function(player: Player)
		Cmdr.Registry:GetStore("CMDR_Binds")[player] = nil
	end)

	TextChatService.MessageReceived:Connect(function(message: TextChatMessage)
		const senderId = message.TextSource and message.TextSource.UserId
		const player = senderId and Players:GetPlayerByUserId(senderId)
		const playerBind = player and Cmdr.Registry:GetStore("CMDR_Binds")[player]
		if playerBind then
			playerBind(message)
		end
	end)

	hasHelperRan = true
end

return {
	Name = "bind",
	Description = "Binds a command string to a key or mouse input.",
	Group = "DefaultUtil",
	Args = {
		{
			Type = "userInput @ player",
			Name = "Input",
			Description = "The key or input type you'd like to bind the command to.",
		},
		{
			Type = "command",
			Name = "Command",
			Description = "The command you want to run on this input.",
		},
		{
			Type = "string",
			Name = "Arguments",
			Description = "The arguments for the command.",
			Default = "",
		},
	},

	ClientRun = function(
		context: any,
		bind: Enum.UserInputType | Enum.KeyCode | Player,
		command: string,
		arguments: string
	): string
		if not hasHelperRan then
			runBindHelper(context.Cmdr)
		end

		const binds = context:GetStore("CMDR_Binds")
		if type(binds[bind]) == "string" then
			ContextActionService:UnbindAction(binds[bind])
		end

		const Util = context.Cmdr.Util
		const commandString = `{command} {arguments}`

		if context:GetArgument(1).Type.Name == "userInput" then
			const actionName = `evaera/Cmdr/bind_{bind}`

			const function runCommand()
				context:Reply(
					context.Dispatcher:EvaluateAndRun(Util.RunEmbeddedCommands(context.Dispatcher, commandString))
				)
			end

			ContextActionService:BindActionAtPriority(actionName, function(_, state: Enum.UserInputState)
				if state == Enum.UserInputState.Begin then
					task.spawn(runCommand)
				end

				return Enum.ContextActionResult.Pass
			end, false, Enum.ContextActionPriority.High.Value, bind)

			binds[bind] = actionName
		else
			binds[bind] = function(message: TextChatMessage)
				const chatCommand =
					Util.RunEmbeddedCommands(context.Dispatcher, Util.SubstituteArgs(commandString, { message.Text }))
				const result = context.Dispatcher:EvaluateAndRun(chatCommand)
				context:Reply(`{bind.Name} $ {chatCommand} : {result}`, Color3.fromRGB(244, 92, 66))
			end
		end

		return "Bound command to input."
	end,
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX20">
<Properties>
<string name="Name">clear</string>
<ProtectedString name="Source"><![CDATA[return {
	Name = "clear",
	Description = "Clear all lines above the entry line of the Cmdr window.",
	Group = "DefaultUtil",
	Args = {},
	ClientRun = function(context: any): string
		const entryFrame = context.Cmdr.Gui:WaitForChild("Frame", 2)
		if not entryFrame then
			return "Failed to clear: Frame not found."
		end

		for _, child in pairs(entryFrame:GetChildren()) do
			if child.Name == "Line" and child:IsA("TextBox") then
				child:Destroy()
			end
		end

		return ""
	end,
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX21">
<Properties>
<string name="Name">convertTimestamp</string>
<ProtectedString name="Source"><![CDATA[return {
	Name = "convertTimestamp",
	Aliases = { "date" },
	Description = "Convert a timestamp to a human-readable format.",
	Group = "DefaultUtil",
	Args = {
		{
			Type = "number",
			Name = "timestamp",
			Description = "A numerical representation of a specific moment in time.",
			Optional = true,
		},
	},
	ClientRun = function(_, timestamp: number): string
		timestamp = timestamp or os.time()
		return `{os.date("%x", timestamp)} {os.date("%X", timestamp)}`
	end,
}
]]></ProtectedString>
</Properties>
</Item>
