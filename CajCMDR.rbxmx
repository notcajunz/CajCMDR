	Group = "DefaultUtil",
	Args = {
		{
			Type = "string",
			Name = "CSV",
			Description = "The comma-separated list.",
		},
	},

	ClientRun = function(_, text: string): string
		return HttpService:JSONEncode(text:split(","))
	end,
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX29">
