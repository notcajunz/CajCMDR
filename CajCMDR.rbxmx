			end,
		},
		{
			Name = "hat",
			Aliases = { "accessory" },
			Role = "Admin",
			Description = "Gives players an accessory from the catalog (by asset id).",
			Args = {
				{ Type = "targets", Name = "players", Description = "The players." },
				{ Type = "positiveInteger", Name = "assetId", Description = "Catalog asset id of the accessory." },
			},
			Run = function(_, players: { Player }, assetId: number)
				const ok, model = pcall(InsertService.LoadAsset, InsertService, assetId)
				if not ok then
					return `Could not load that asset: {model}`
				end

				const accessory = model:FindFirstChildWhichIsA("Accessory", true)
				if not accessory then
					model:Destroy()
					return "That asset is not an accessory."
				end

				const count = Admin.Each(players, function(_player, _character, humanoid)
					humanoid:AddAccessory(accessory:Clone())
				end)

				model:Destroy()
				return describe(count, "Equipped")
			end,
		},
		{
			Name = "removehats",
			Aliases = { "nohats" },
			Role = "Admin",
			Description = "Removes all accessories from players.",
			Args = { { Type = "targets", Name = "players", Description = "The players." } },
			Run = function(_, players: { Player })
				return describe(
					Admin.Each(players, function(_player, _character, humanoid)
						humanoid:RemoveAccessories()
					end),
					"Cleared"
				)
			end,
		},

		-- Tools ----------------------------------------------------------------------------------------
		{
			Name = "tools",
			Role = "Helper",
			Description = "Lists the tools that can be given with the give command.",
			Args = {},
			Run = function(context)
				const lines = {}
				for _, tool in ipairs(Admin.ListTools()) do
					table.insert(lines, tool.Name)
				end

				if not Admin.GetToolsFolder() then
					table.insert(lines, `Create a folder named "{Admin.Config.ToolsFolder}" in ServerStorage and put Tools in it.`)
				end

				return Admin.Output(context, "Available tools", lines)
			end,
		},
		{
			Name = "give",
			Aliases = { "tool" },
			Role = "Moderator",
			Description = "Gives players a tool from ServerStorage > AdminTools.",
			Args = {
				{ Type = "players", Name = "players", Description = "The players." },
				{ Type = "string", Name = "tool", Description = "Name of the tool (see the tools command)." },
			},
			Run = function(_, players: { Player }, toolName: string)
				const tool = Admin.FindTool(toolName)
				if not tool then
					return `No tool called "{toolName}". Use the tools command to see the list.`
				end

				return describe(
					Admin.EachPlayer(players, function(player)
						const backpack = player:FindFirstChildOfClass("Backpack")
						if not backpack then
							return false
						end

						tool:Clone().Parent = backpack
					end),
					`Gave {tool.Name} to`
				)
			end,
		},
		{
			Name = "ungive",
			Aliases = { "untool" },
			Role = "Moderator",
			Description = "Takes a tool away from players.",
			Args = {
				{ Type = "players", Name = "players", Description = "The players." },
				{ Type = "string", Name = "tool", Description = "Name (or part of the name) of the tool." },
			},
			Run = function(_, players: { Player }, toolName: string)
				const needle = toolName:lower()
				return describe(
					Admin.EachPlayer(players, function(player)
						local removed = false
						const containers = { player:FindFirstChildOfClass("Backpack"), player.Character }
						for _, container in pairs(containers) do
							for _, child in ipairs(container:GetChildren()) do
								if child:IsA("Tool") and child.Name:lower():find(needle, 1, true) then
									child:Destroy()
									removed = true
								end
							end
						end

						return removed
					end),
					"Took a tool from"
				)
			end,
		},
		{
			Name = "strip",
			Aliases = { "removetools", "striptools" },
			Role = "Moderator",
			Description = "Removes every tool from players.",
			Args = { { Type = "targets", Name = "players", Description = "The players." } },
			Run = function(_, players: { Player })
				return describe(
					Admin.EachPlayer(players, function(player)
						const backpack = player:FindFirstChildOfClass("Backpack")
						if backpack then
							backpack:ClearAllChildren()
						end

						const character = player.Character
						if character then
							for _, child in ipairs(character:GetChildren()) do
								if child:IsA("Tool") then
									child:Destroy()
								end
							end
						end
					end),
					"Stripped"
				)
			end,
		},

		-- Teams ----------------------------------------------------------------------------------------
		{
			Name = "team",
			Role = "Moderator",
			Description = "Moves players to a team.",
			Args = {
				{ Type = "targets", Name = "players", Description = "The players." },
				{ Type = "team", Name = "team", Description = "The team." },
			},
			Run = function(_, players: { Player }, team: Team)
				return describe(
					Admin.EachPlayer(players, function(player)
						player.Team = team
					end),
					`Moved to {team.Name}:`
				)
			end,
		},
		{
			Name = "neutral",
			Role = "Moderator",
			Description = "Removes players from their team.",
			Args = { { Type = "players", Name = "players", Description = "The players." } },
			Run = function(_, players: { Player })
				return describe(
					Admin.EachPlayer(players, function(player)
						player.Team = nil
					end),
					"Made neutral:"
				)
			end,
		},
		{
			Name = "newteam",
			Aliases = { "createteam" },
			Role = "Admin",
			Description = "Creates a new team.",
			Args = {
				{ Type = "string", Name = "name", Description = "Team name." },
				{ Type = "brickColor", Name = "color", Description = "Team color.", Optional = true },
			},
			Run = function(_, name: string, color: BrickColor?)
				if Teams:FindFirstChild(name) then
					return `A team called "{name}" already exists.`
				end

				const team = Instance.new("Team")
				team.Name = name
				team.TeamColor = color or BrickColor.Random()
				team.AutoAssignable = false
				team.Parent = Teams
				return `Created team {name}.`
			end,
		},
		{
			Name = "delteam",
			Aliases = { "removeteam" },
			Role = "Admin",
			Description = "Deletes a team.",
			Args = { { Type = "team", Name = "team", Description = "The team to delete." } },
			Run = function(_, team: Team)
				const name = team.Name
				team:Destroy()
				return `Deleted team {name}.`
			end,
		},

		-- Teleporting ----------------------------------------------------------------------------------
		{
			Name = "bring",
			Role = "Moderator",
			Description = "Teleports players to you.",
			Args = { { Type = "targets", Name = "players", Description = "The players to bring." } },
			Run = function(context, players: { Player })
				const root = Admin.GetRoot(context.Executor)
				if not root then
					return "You need a character to bring players."
				end

				return describe(teleportAround(players, root.Position, context.Executor), "Brought")
			end,
		},
		{
			Name = "goto",
			Aliases = { "to", "tpto" },
			Role = "Helper",
			Description = "Teleports you to a player.",
			Args = { { Type = "player", Name = "player", Description = "The player to go to." } },
			Run = function(context, target: Player)
				const targetRoot = Admin.GetRoot(target)
				const character = context.Executor.Character
				if not (targetRoot and character) then
					return "Both of you need a character."
				end

				Admin.Teleport(character, CFrame.lookAt(targetRoot.Position + targetRoot.CFrame.LookVector * 5, targetRoot.Position))
				return `Teleported to {target.Name}.`
			end,
		},
		{
			Name = "tp",
			Aliases = { "teleport" },
			Role = "Moderator",
			Description = "Teleports players to another player.",
			Args = {
				{ Type = "targets", Name = "players", Description = "The players to move." },
				{ Type = "player", Name = "destination", Description = "The player to teleport them to." },
			},
			Run = function(_, players: { Player }, destination: Player)
				const root = Admin.GetRoot(destination)
				if not root then
					return `{destination.Name} has no character.`
				end

				return describe(teleportAround(players, root.Position, destination), "Teleported")
			end,
		},
		{
			Name = "tppos",
			Aliases = { "tpxyz" },
			Role = "Moderator",
			Description = "Teleports players to coordinates (use ~ for relative: ~ ~10 ~).",
			Args = {
				{ Type = "targets", Name = "players", Description = "The players to move." },
				{ Type = "positionVector3", Name = "position", Description = "X, Y, Z." },
			},
			Run = function(_, players: { Player }, position: Vector3)
				return describe(
					Admin.Each(players, function(_player, character)
						Admin.Teleport(character, CFrame.new(position))
					end),
					"Teleported"
				)
			end,
		},
		{
			Name = "swap",
			Role = "Moderator",
			Description = "Swaps the positions of two players.",
			Args = {
				{ Type = "target", Name = "first", Description = "First player." },
				{ Type = "target", Name = "second", Description = "Second player." },
			},
			Run = function(_, first: Player, second: Player)
				const characterA = first.Character
				const characterB = second.Character
				if not (characterA and characterB) then
					return "Both players need a character."
				end

				const pivotA = characterA:GetPivot()
				const pivotB = characterB:GetPivot()
				Admin.Teleport(characterA, pivotB)
				Admin.Teleport(characterB, pivotA)
				return `Swapped {first.Name} and {second.Name}.`
			end,
		},
		{
			Name = "up",
			Aliases = { "rise" },
			Role = "Moderator",
			Description = "Moves players up.",
			Args = {
				{ Type = "targets", Name = "players", Description = "The players." },
				{ Type = "number", Name = "studs", Description = "How far." },
			},
			Run = function(_, players: { Player }, studs: number)
				return describe(
					Admin.Each(players, function(_player, character)
						character:PivotTo(character:GetPivot() + Vector3.new(0, studs, 0))
					end),
					"Moved"
				)
			end,
		},
		{
			Name = "down",
			Role = "Moderator",
			Description = "Moves players down.",
			Args = {
				{ Type = "targets", Name = "players", Description = "The players." },
				{ Type = "number", Name = "studs", Description = "How far." },
			},
			Run = function(_, players: { Player }, studs: number)
				return describe(
					Admin.Each(players, function(_player, character)
						character:PivotTo(character:GetPivot() - Vector3.new(0, studs, 0))
					end),
					"Moved"
				)
			end,
		},
		{
			Name = "forward",
			Aliases = { "fwd" },
			Role = "Moderator",
			Description = "Moves players forward (negative = backward).",
			Args = {
				{ Type = "targets", Name = "players", Description = "The players." },
				{ Type = "number", Name = "studs", Description = "How far." },
			},
			Run = function(_, players: { Player }, studs: number)
				return describe(
					Admin.Each(players, function(_player, character, _humanoid, root)
						character:PivotTo(character:GetPivot() + root.CFrame.LookVector * studs)
					end),
					"Moved"
				)
			end,
		},
		{
			Name = "resetstats",
			Aliases = { "defaults" },
			Role = "Moderator",
			Description = "Resets health, speed, jump, size, visibility and other changes to normal.",
			Args = { { Type = "players", Name = "players", Description = "The players." } },
			Run = function(_, players: { Player })
				return describe(
					Admin.EachPlayer(players, function(player)
						Admin.ClearStates(player)
						const character = player.Character
						const humanoid = Admin.GetHumanoid(player)
						if character and humanoid then
							giveDefaults(player, character, humanoid)
						end
					end),
					"Reset"
				)
			end,
		},
	}
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX61">
<Properties>
<string name="Name">Client</string>
<ProtectedString name="Source"><![CDATA[--[[
	Client: commands that change what a player's own screen or controls do (fly, noclip, camera, vision tools).
	The server only sends the request; the effects themselves live in the Client > Effects module.
]]

return function(Admin)
	const function targetFx(
		name: string,
		aliases: { string }?,
		role: string,
		description: string,
		extraArgs: { any }?,
		effect: string,
		verb: string,
		protected: boolean
	)
		const args = { { Type = if protected then "targets" else "players", Name = "players", Description = "The players." } }
		for _, argument in ipairs(extraArgs or {}) do
			table.insert(args, argument)
		end

		return {
			Name = name,
			Aliases = aliases,
			Role = role,
			Description = description,
			Args = args,
			Run = function(_, players: { Player }, ...)
				const extra = table.pack(...)
				return Admin.Result(
					verb,
					Admin.EachPlayer(players, function(player)
						Admin.Fx(player, effect, table.unpack(extra, 1, extra.n))
					end)
				)
			end,
		}
	end

	--[[ A command that only affects the person who ran it (vision tools for staff). ]]
	const function selfFx(name: string, aliases: { string }?, role: string, description: string, effect: string, message: string)
		return {
			Name = name,
			Aliases = aliases,
			Role = role,
			Description = description,
			Args = {},
			Run = function(context)
				Admin.Fx(context.Executor, effect)
				return message
			end,
		}
	end

	return {
		targetFx("fly", nil, "Moderator", "Lets players fly (WASD + Space/Shift).", {
			{ Type = "positiveNumber", Name = "speed", Description = "Default 60.", Optional = true },
		}, "fly", "Gave flight to", true),
		targetFx("unfly", nil, "Moderator", "Takes flight away.", nil, "unfly", "Grounded", false),
		targetFx("noclip", nil, "Moderator", "Lets players walk through walls.", nil, "noclip", "Enabled noclip for", true),
		targetFx("clip", { "unnoclip" }, "Moderator", "Turns noclip off.", nil, "clip", "Disabled noclip for", false),
		targetFx("infjump", { "infinitejump" }, "Moderator", "Lets players jump in mid-air forever.", nil, "infjump", "Enabled infinite jump for", true),
		targetFx("uninfjump", { "noinfjump" }, "Moderator", "Turns infinite jump off.", nil, "uninfjump", "Disabled infinite jump for", false),
		targetFx("fov", { "fieldofview" }, "Moderator", "Changes the camera field of view (70 is normal).", {
			{ Type = "number", Name = "degrees", Description = "1 to 120." },
		}, "fov", "Changed the view of", true),
		targetFx("firstperson", { "lockfirst" }, "Moderator", "Forces first-person view.", nil, "firstperson", "Locked first person for", true),
		targetFx("thirdperson", { "unlockfirst" }, "Moderator", "Returns the normal camera.", nil, "thirdperson", "Unlocked the camera of", false),
		targetFx("zoom", { "maxzoom" }, "Moderator", "Sets how far players can zoom out.", {
			{ Type = "positiveNumber", Name = "distance", Description = "Studs (default 128)." },
		}, "zoom", "Changed the zoom of", true),
		targetFx("blind", nil, "Moderator", "Blacks out players' screens.", nil, "blind", "Blinded", true),
		targetFx("unblind", nil, "Moderator", "Restores players' vision.", nil, "unblind", "Restored the vision of", false),
		targetFx("flash", nil, "Moderator", "Flashes players' screens white.", nil, "flash", "Flashed", true),
		targetFx("shake", { "earthquake" }, "Moderator", "Shakes players' cameras.", {
			{ Type = "positiveNumber", Name = "seconds", Description = "Default 3.", Optional = true },
			{ Type = "positiveNumber", Name = "intensity", Description = "Default 1.", Optional = true },
		}, "shake", "Shook the camera of", true),
		targetFx("blur", nil, "Moderator", "Blurs players' screens.", {
			{ Type = "positiveNumber", Name = "size", Description = "1 to 56 (default 20).", Optional = true },
		}, "blur", "Blurred", true),
		targetFx("unblur", nil, "Moderator", "Removes the blur.", nil, "unblur", "Unblurred", false),
		targetFx("hidegui", nil, "Moderator", "Hides players' game interface.", nil, "hidegui", "Hid the interface of", true),
		targetFx("showgui", nil, "Moderator", "Shows players' game interface again.", nil, "showgui", "Showed the interface of", false),
		{
			Name = "view",
			Aliases = { "spectate", "watch" },
			Role = "Helper",
			Description = "Watch the game through another player's camera.",
			Args = { { Type = "player", Name = "player", Description = "The player to watch." } },
			Run = function(context, player: Player)
				Admin.Fx(context.Executor, "view", player.UserId)
				return `Viewing {player.Name}. Use unview to stop.`
			end,
		},
		selfFx("unview", { "unspectate" }, "Helper", "Stops watching another player.", "unview", "Back to your own camera."),
		selfFx("fullbright", { "fb" }, "Helper", "Makes the whole world bright for you only.", "fullbright", "Fullbright on."),
		selfFx("unfullbright", { "unfb" }, "Helper", "Turns fullbright off.", "unfullbright", "Fullbright off."),
		selfFx("xray", nil, "Helper", "See through walls (for you only).", "xray", "X-ray on."),
		selfFx("unxray", nil, "Helper", "Turns x-ray off.", "unxray", "X-ray off."),
		selfFx("esp", { "wallhack" }, "Helper", "Highlights every player through walls (for you only).", "esp", "ESP on."),
		selfFx("unesp", nil, "Helper", "Turns ESP off.", "unesp", "ESP off."),
		targetFx("resetclient", { "resetfx" }, "Moderator", "Turns off every client effect (fly, noclip, blur, ...).", nil, "reset", "Reset the screen of", false),
	}
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX62">
<Properties>
<string name="Name">Fun</string>
<ProtectedString name="Source"><![CDATA[--[[
	Fun: effects, explosions, emotes and silly avatar changes.
]]

const Debris = game:GetService("Debris")
const RunService = game:GetService("RunService")
const TweenService = game:GetService("TweenService")

const EMOTE_IDS = {
	wave = 507770239,
	point = 507770453,
	dance = 507771019,
	dance2 = 507776043,
	dance3 = 507777268,
	laugh = 507770818,
	cheer = 507770677,
}
const DANCES = { "dance", "dance2", "dance3" }

return function(Admin)
	const rainbowPlayers: { [Player]: boolean } = {}
	local rainbowConnection: RBXScriptConnection? = nil

	----------------------------------------------------------------------------------------------------
	-- helpers
	----------------------------------------------------------------------------------------------------

	const function describe(count: number, verb: string): string
		return Admin.Result(verb, count)
	end

	const function bodyParts(character: Model): { BasePart }
		const parts = {}
		for _, child in ipairs(character:GetChildren()) do
			if child:IsA("BasePart") and child.Name ~= "HumanoidRootPart" then
				table.insert(parts, child)
			end
		end

		return parts
	end

	const function visualExplosion(position: Vector3, radius: number)
		const explosion = Instance.new("Explosion")
		explosion.Position = position
		explosion.BlastRadius = radius
		explosion.BlastPressure = 0
		explosion.DestroyJointRadiusPercent = 0
		explosion.ExplosionType = Enum.ExplosionType.NoCraters
		explosion.Parent = workspace
	end

	const function deadlyExplosion(position: Vector3, radius: number, pressure: number?)
		const explosion = Instance.new("Explosion")
		explosion.Position = position
		explosion.BlastRadius = radius
		explosion.BlastPressure = pressure or 500000
		explosion.DestroyJointRadiusPercent = 1
		explosion.ExplosionType = Enum.ExplosionType.NoCraters
		explosion.Parent = workspace
	end

	const function playEmote(humanoid: Humanoid, emote: string): boolean
		const id = EMOTE_IDS[emote]
		const animator = humanoid:FindFirstChildOfClass("Animator")
		if not id or not animator or humanoid.RigType ~= Enum.HumanoidRigType.R15 then
			return false
		end

		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			if track.Name == "CajEmote" then
				track:Stop()
			end
		end

		const animation = Instance.new("Animation")
		animation.Name = "CajEmote"
		animation.AnimationId = `rbxassetid://{id}`

		const track = animator:LoadAnimation(animation)
		track.Priority = Enum.AnimationPriority.Action
		track.Looped = emote:find("dance") ~= nil
		track:Play()
		return true
	end

	const function stopEmotes(humanoid: Humanoid)
		const animator = humanoid:FindFirstChildOfClass("Animator")
		if animator then
			for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
				if track.Name == "CajEmote" then
					track:Stop()
				end
			end
		end
	end

	const function stepRainbow()
		const hue = (os.clock() * 0.4) % 1
		const color = Color3.fromHSV(hue, 1, 1)
		local active = false

		for player in pairs(rainbowPlayers) do
			const character = player.Character
			if player.Parent and character then
				active = true
				for _, part in ipairs(bodyParts(character)) do
					part.Color = color
				end
			else
				rainbowPlayers[player] = nil
			end
		end

		if not active and rainbowConnection then
			rainbowConnection:Disconnect()
			rainbowConnection = nil
		end
	end

	const function firework(position: Vector3)
		const anchor = Instance.new("Part")
		anchor.Anchored = true
		anchor.CanCollide = false
		anchor.Transparency = 1
		anchor.Size = Vector3.one
		anchor.Position = position
		anchor.Parent = Admin.GetObjectsFolder()

		const emitter = Instance.new("ParticleEmitter")
		emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		emitter.Color = ColorSequence.new(Color3.fromHSV(math.random(), 1, 1))
		emitter.Lifetime = NumberRange.new(1, 2)
		emitter.Speed = NumberRange.new(30, 50)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Acceleration = Vector3.new(0, -20, 0)
		emitter.Size = NumberSequence.new(1.5, 0)
		emitter.LightEmission = 1
		emitter.Rate = 0
		emitter.Enabled = false
		emitter.Parent = anchor
		emitter:Emit(150)

		visualExplosion(position, 1)
		Debris:AddItem(anchor, 3)
	end

	--[[ Builds the on/off pair for a simple attached effect (fire, smoke, ...). ]]
	const function effectPair(
		name: string,
		offName: string,
		aliasesOn: { string }?,
		description: string,
		className: string,
		effectName: string,
		configure: (Instance, Color3?) -> (),
		colorOptional: boolean
	)
		const args = { { Type = "targets", Name = "players", Description = "The players." } }
		if colorOptional then
			table.insert(args, { Type = "color3", Name = "color", Description = "Optional color.", Optional = true })
		end

		return {
			Name = name,
			Aliases = aliasesOn,
			Role = "Moderator",
			Description = description,
			Args = args,
			Run = function(_, players: { Player }, color: Color3?)
				return describe(
					Admin.Each(players, function(_player, character)
						const instance = Admin.AddEffect(character, className, effectName, nil, "HumanoidRootPart")
						if instance then
							configure(instance, color)
						end
					end),
					"Applied the effect to"
				)
			end,
		},
			{
				Name = offName,
				Role = "Moderator",
				Description = `Removes the {name} effect.`,
				Args = { { Type = "players", Name = "players", Description = "The players." } },
				Run = function(_, players: { Player })
					return describe(
						Admin.Each(players, function(_player, character)
							Admin.RemoveEffect(character, effectName)
						end),
						"Cleared"
					)
				end,
			}
	end

	const function materialLook(name: string, description: string, apply: (Model) -> ())
		return {
			Name = name,
			Role = "Moderator",
			Description = description,
			Args = { { Type = "targets", Name = "players", Description = "The players." } },
			Run = function(_, players: { Player })
				return describe(Admin.Each(players, function(_player, character)
					apply(character)
				end), "Transformed")
			end,
		}
	end

	const function scaleLook(name: string, aliases: { string }?, description: string, height: number?, width: number?, head: number?)
		return {
			Name = name,
			Aliases = aliases,
			Role = "Moderator",
			Description = description,
			Args = { { Type = "targets", Name = "players", Description = "The players." } },
			Run = function(_, players: { Player })
				const count = Admin.Each(players, function(_player, _character, humanoid)
					return Admin.SetScale(humanoid, height, width, head)
				end)

				if count == 0 then
					return "Nobody was changed (this only works on R15 avatars)."
				end

				return describe(count, "Transformed")
			end,
		}
	end

	----------------------------------------------------------------------------------------------------
	-- commands
	----------------------------------------------------------------------------------------------------

	const commands = {}

	const function add(...: any)
		for _, spec in ipairs({ ... }) do
			table.insert(commands, spec)
		end
	end

	add(effectPair("fire", "unfire", { "burn" }, "Sets players on fire (harmless).", "Fire", "CajFire", function(instance, color)
		const fire = instance :: Fire
		fire.Size = 8
		fire.Heat = 10
		if color then
			fire.Color = color
			fire.SecondaryColor = color
		end
	end, true))

	add(effectPair("smoke", "unsmoke", nil, "Surrounds players with smoke.", "Smoke", "CajSmoke", function(instance, color)
		const smoke = instance :: Smoke
		smoke.Size = 10
		smoke.RiseVelocity = 8
		smoke.Opacity = 0.5
		if color then
			smoke.Color = color
		end
	end, true))

	add(effectPair("sparkles", "unsparkles", { "sparkle" }, "Makes players sparkle.", "Sparkles", "CajSparkles", function(instance, color)
		if color then
			(instance :: Sparkles).SparkleColor = color
		end
	end, true))

	add(effectPair("light", "unlight", { "glow" }, "Makes players glow.", "PointLight", "CajLight", function(instance, color)
		const light = instance :: PointLight
		light.Range = 24
		light.Brightness = 3
		if color then
			light.Color = color
		end
	end, true))

	add({
		Name = "trail",
		Role = "Moderator",
		Description = "Gives players a colored trail.",
		Args = {
			{ Type = "targets", Name = "players", Description = "The players." },
			{ Type = "color3", Name = "color", Description = "Trail color.", Optional = true },
		},
		Run = function(_, players: { Player }, color: Color3?)
			return describe(
				Admin.Each(players, function(_player, character, _humanoid, root)
					Admin.RemoveEffect(character, "CajTrail")
					Admin.RemoveEffect(character, "CajTrailA")
					Admin.RemoveEffect(character, "CajTrailB")

					const top = Instance.new("Attachment")
					top.Name = "CajTrailA"
					top.Position = Vector3.new(0, 1, 0)
					top.Parent = root

					const bottom = Instance.new("Attachment")
					bottom.Name = "CajTrailB"
					bottom.Position = Vector3.new(0, -1, 0)
					bottom.Parent = root

					const trail = Instance.new("Trail")
					trail.Name = "CajTrail"
					trail.Attachment0 = top
					trail.Attachment1 = bottom
					trail.Lifetime = 0.9
					trail.LightEmission = 1
					trail.Color = ColorSequence.new(color or Color3.fromHSV(math.random(), 1, 1))
					trail.Transparency = NumberSequence.new(0, 1)
					trail.Parent = root
				end),
				"Gave a trail to"
			)
		end,
	}, {
		Name = "untrail",
		Role = "Moderator",
		Description = "Removes trails.",
		Args = { { Type = "players", Name = "players", Description = "The players." } },
		Run = function(_, players: { Player })
			return describe(
				Admin.Each(players, function(_player, character)
					Admin.RemoveEffect(character, "CajTrail")
					Admin.RemoveEffect(character, "CajTrailA")
					Admin.RemoveEffect(character, "CajTrailB")
				end),
				"Cleared"
			)
		end,
	})

	add({
		Name = "explode",
		Role = "Admin",
		Description = "Blows players up (also hurts people standing next to them).",
		Args = { { Type = "targets", Name = "players", Description = "The players." } },
		Run = function(_, players: { Player })
			return describe(
				Admin.Each(players, function(_player, _character, _humanoid, root)
					deadlyExplosion(root.Position, 8)
				end),
				"Exploded"
			)
		end,
	}, {
		Name = "nuke",
		Role = "Admin",
		Description = "Drops a huge explosion on players. Everyone nearby will die.",
		Args = { { Type = "targets", Name = "players", Description = "The players." } },
		Run = function(_, players: { Player })
			return describe(
				Admin.Each(players, function(_player, _character, _humanoid, root)
					const position = root.Position

					const sphere = Instance.new("Part")
					sphere.Shape = Enum.PartType.Ball
					sphere.Anchored = true
					sphere.CanCollide = false
					sphere.Material = Enum.Material.Neon
					sphere.Color = Color3.fromRGB(255, 170, 40)
					sphere.Size = Vector3.one * 4
					sphere.Position = position
					sphere.Parent = Admin.GetObjectsFolder()

					TweenService:Create(sphere, TweenInfo.new(1.2), { Size = Vector3.one * 90, Transparency = 1 }):Play()
					Debris:AddItem(sphere, 1.4)

					deadlyExplosion(position, 60, 800000)
				end),
				"Nuked"
			)
		end,
	}, {
		Name = "lightning",
		Aliases = { "smite", "strike" },
		Role = "Moderator",
		Description = "Strikes players with a bolt of lightning (25 damage).",
		Args = { { Type = "targets", Name = "players", Description = "The players." } },
		Run = function(_, players: { Player })
			return describe(
				Admin.Each(players, function(_player, _character, humanoid, root)
					const position = root.Position

					const bolt = Instance.new("Part")
					bolt.Anchored = true
					bolt.CanCollide = false
					bolt.CanQuery = false
					bolt.Material = Enum.Material.Neon
					bolt.Color = Color3.fromRGB(190, 220, 255)
					bolt.Size = Vector3.new(1.2, 300, 1.2)
					bolt.Position = position + Vector3.new(0, 150, 0)
					bolt.Parent = Admin.GetObjectsFolder()
					Debris:AddItem(bolt, 0.25)

					visualExplosion(position, 6)
					humanoid:TakeDamage(25)
				end),
				"Struck"
			)
		end,
	}, {
		Name = "meteor",
		Role = "Admin",
		Description = "Drops a flaming meteor on players.",
		Args = { { Type = "targets", Name = "players", Description = "The players." } },
		Run = function(_, players: { Player })
			return describe(
				Admin.Each(players, function(_player, _character, _humanoid, root)
					const rock = Instance.new("Part")
					rock.Shape = Enum.PartType.Ball
					rock.Size = Vector3.one * 10
					rock.Material = Enum.Material.Slate
					rock.Color = Color3.fromRGB(70, 40, 30)
					rock.Position = root.Position + Vector3.new(0, 200, 0)
					rock.Parent = Admin.GetObjectsFolder()
					rock:SetNetworkOwner(nil)
					rock.AssemblyLinearVelocity = Vector3.new(0, -220, 0)

					const fire = Instance.new("Fire")
					fire.Size = 18
					fire.Parent = rock

					local landed = false
					rock.Touched:Connect(function(other)
						if landed or other:IsDescendantOf(Admin.GetObjectsFolder()) then
							return
						end

						landed = true
						deadlyExplosion(rock.Position, 18, 300000)
						rock:Destroy()
					end)

					Debris:AddItem(rock, 12)
				end),
				"Sent a meteor at"
			)
		end,
	}, {
		Name = "fireworks",
		Role = "Moderator",
		Description = "Shoots a fireworks show above players.",
		Args = { { Type = "players", Name = "players", Description = "The players." } },
		Run = function(_, players: { Player })
			return describe(
				Admin.Each(players, function(_player, _character, _humanoid, root)
					const origin = root.Position
					for index = 1, 7 do
						task.delay(index * 0.45, function()
							firework(origin + Vector3.new(math.random(-14, 14), math.random(24, 38), math.random(-14, 14)))
						end)
					end
				end),
				"Launched fireworks for"
			)
		end,
	})

	add({
		Name = "fling",
		Role = "Moderator",
		Description = "Flings players across the map.",
		Args = {
			{ Type = "targets", Name = "players", Description = "The players." },
			{ Type = "positiveNumber", Name = "power", Description = "Default 150.", Optional = true },
		},
		Run = function(_, players: { Player }, power: number?)
			const strength = math.min(power or 150, 1000)
			return describe(
				Admin.Each(players, function(_player, _character, humanoid, root)
					const direction = Vector3.new(math.random() - 0.5, 0.6, math.random() - 0.5).Unit
					humanoid.PlatformStand = true
					root.AssemblyLinearVelocity = direction * strength
					root.AssemblyAngularVelocity = Vector3.new(math.random(-20, 20), math.random(-20, 20), math.random(-20, 20))

					task.delay(2, function()
						if humanoid.Parent then
							humanoid.PlatformStand = false
						end
					end)
				end),
				"Flung"
			)
		end,
	}, {
		Name = "launch",
		Role = "Moderator",
		Description = "Launches players straight up.",
		Args = {
			{ Type = "targets", Name = "players", Description = "The players." },
			{ Type = "positiveNumber", Name = "power", Description = "Default 120.", Optional = true },
		},
		Run = function(_, players: { Player }, power: number?)
			return describe(
				Admin.Each(players, function(_player, _character, _humanoid, root)
					root.AssemblyLinearVelocity = Vector3.new(0, math.min(power or 120, 1000), 0)
				end),
				"Launched"
			)
		end,
	}, {
		Name = "rocket",
		Role = "Admin",
		Description = "Straps a rocket to players: up they go, then boom.",
		Args = { { Type = "targets", Name = "players", Description = "The players." } },
		Run = function(_, players: { Player })
			return describe(
				Admin.Each(players, function(_player, character, humanoid, root)
					Admin.AddEffect(character, "Fire", "CajFire", { Size = 14 }, "HumanoidRootPart")
					root.AssemblyLinearVelocity = Vector3.new(0, 260, 0)

					task.delay(2, function()
						if character.Parent and humanoid.Parent then
							const top = character:FindFirstChild("HumanoidRootPart")
							if top and top:IsA("BasePart") then
								deadlyExplosion(top.Position, 8)
							end
							humanoid.Health = 0
						end
					end)
				end),
				"Launched a rocket with"
			)
		end,
	}, {
		Name = "slap",
		Role = "Moderator",
		Description = "Slaps players (10 damage and a shove).",
		Args = { { Type = "targets", Name = "players", Description = "The players." } },
		Run = function(_, players: { Player })
			return describe(
				Admin.Each(players, function(_player, _character, humanoid, root)
					humanoid:TakeDamage(10)
					root.AssemblyLinearVelocity = Vector3.new(math.random(-60, 60), 70, math.random(-60, 60))
				end),
				"Slapped"
			)
		end,
	}, {
		Name = "spin",
		Role = "Moderator",
		Description = "Spins players around.",
		Args = {
			{ Type = "targets", Name = "players", Description = "The players." },
			{ Type = "number", Name = "speed", Description = "Radians per second (default 12).", Optional = true },
		},
		Run = function(_, players: { Player }, speed: number?)
			return describe(
				Admin.Each(players, function(_player, character, humanoid, root)
					Admin.RemoveEffect(character, "CajSpin")
					Admin.RemoveEffect(character, "CajSpinA")

					const attachment = Instance.new("Attachment")
					attachment.Name = "CajSpinA"
					attachment.Parent = root

					const spinner = Instance.new("AngularVelocity")
					spinner.Name = "CajSpin"
					spinner.Attachment0 = attachment
					spinner.MaxTorque = math.huge
					spinner.AngularVelocity = Vector3.new(0, math.clamp(speed or 12, -100, 100), 0)
					spinner.RelativeTo = Enum.ActuatorRelativeTo.World
					spinner.Parent = root

					humanoid.PlatformStand = true
				end),
				"Spun"
			)
		end,
	}, {
		Name = "unspin",
		Role = "Moderator",
		Description = "Stops players from spinning.",
		Args = { { Type = "players", Name = "players", Description = "The players." } },
		Run = function(_, players: { Player })
			return describe(
				Admin.Each(players, function(_player, character, humanoid)
					Admin.RemoveEffect(character, "CajSpin")
					Admin.RemoveEffect(character, "CajSpinA")
					humanoid.PlatformStand = false
				end),
				"Stopped"
			)
		end,
	}, {
		Name = "trip",
		Role = "Moderator",
		Description = "Makes players trip and fall over for a few seconds.",
		Args = { { Type = "targets", Name = "players", Description = "The players." } },
		Run = function(_, players: { Player })
			return describe(
				Admin.Each(players, function(_player, _character, humanoid, root)
					humanoid:ChangeState(Enum.HumanoidStateType.Ragdoll)
					root.AssemblyLinearVelocity = root.CFrame.LookVector * 30 + Vector3.new(0, 12, 0)

					task.delay(3, function()
						if humanoid.Parent then
							humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
						end
					end)
				end),
				"Tripped"
			)
		end,
	})

	add({
		Name = "rainbow",
		Role = "Moderator",
		Description = "Cycles players' body color through the rainbow.",
		Args = { { Type = "targets", Name = "players", Description = "The players." } },
		Run = function(_, players: { Player })
			const count = Admin.EachPlayer(players, function(player)
				rainbowPlayers[player] = true
			end)

			if not rainbowConnection and count > 0 then
				rainbowConnection = RunService.Heartbeat:Connect(stepRainbow)
			end

			return describe(count, "Made rainbow:")
		end,
	}, {
		Name = "unrainbow",
		Role = "Moderator",
		Description = "Stops the rainbow effect.",
		Args = { { Type = "players", Name = "players", Description = "The players." } },
		Run = function(_, players: { Player })
			return describe(
				Admin.EachPlayer(players, function(player)
					rainbowPlayers[player] = nil
				end),
				"Stopped the rainbow for"
			)
		end,
	})

	add(
		materialLook("neon", "Turns players into glowing neon.", function(character)
			for _, part in ipairs(bodyParts(character)) do
				part.Material = Enum.Material.Neon
			end
		end),
		materialLook("glass", "Turns players into glass.", function(character)
			for _, part in ipairs(bodyParts(character)) do
				part.Material = Enum.Material.Glass
				part.Transparency = 0.4
				part.Reflectance = 0.2
			end
		end),
		materialLook("gold", "Turns players into shiny gold statues.", function(character)
			for _, part in ipairs(bodyParts(character)) do
				part.Material = Enum.Material.Metal
				part.Color = Color3.fromRGB(255, 200, 40)
				part.Reflectance = 0.3
			end
		end),
		materialLook("ghost", "Turns players into see-through ghosts.", function(character)
			Admin.SetTransparency(character, 0.6)
			for _, part in ipairs(bodyParts(character)) do
				part.Material = Enum.Material.ForceField
			end
		end),
		materialLook("ice", "Freezes players solid in a block of ice.", function(character)
			for _, part in ipairs(bodyParts(character)) do
				part.Material = Enum.Material.Ice
				part.Color = Color3.fromRGB(170, 220, 255)
			end

			const root = character:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") then
				root.Anchored = true
			end

			Admin.RemoveEffect(character, "CajIce")
			const marker = Instance.new("BoolValue")
			marker.Name = "CajIce"
			marker.Parent = character
		end),
		scaleLook("bighead", { "megahead" }, "Gives players a giant head.", nil, nil, 3),
		scaleLook("giant", { "huge" }, "Makes players 3x bigger.", 3, 3, 3),
		scaleLook("tiny", { "small", "mini" }, "Makes players tiny.", 0.4, 0.4, 0.4)
	)

	add({
		Name = "emote",
		Role = "Moderator",
		Description = "Makes players play an emote (R15 only).",
		Args = {
			{ Type = "targets", Name = "players", Description = "The players." },
			{ Type = "emote", Name = "emote", Description = "wave, point, dance, dance2, dance3, laugh, cheer." },
		},
		Run = function(_, players: { Player }, emote: string)
			const count = Admin.Each(players, function(_player, _character, humanoid)
				return playEmote(humanoid, emote)
			end)

			if count == 0 then
				return "Nobody could play the emote (it only works on R15 avatars)."
			end

			return describe(count, "Made emote:")
		end,
	}, {
		Name = "dance",
		Role = "Moderator",
		Description = "Makes players dance (R15 only).",
		Args = { { Type = "targets", Name = "players", Description = "The players." } },
		Run = function(_, players: { Player })
			const count = Admin.Each(players, function(_player, _character, humanoid)
				return playEmote(humanoid, DANCES[math.random(1, #DANCES)])
			end)

			if count == 0 then
				return "Nobody could dance (it only works on R15 avatars)."
			end

			return describe(count, "Made dance:")
		end,
	}, {
		Name = "stopemote",
		Aliases = { "undance" },
		Role = "Moderator",
		Description = "Stops emotes started by commands.",
		Args = { { Type = "players", Name = "players", Description = "The players." } },
		Run = function(_, players: { Player })
			return describe(
				Admin.Each(players, function(_player, _character, humanoid)
					stopEmotes(humanoid)
				end),
				"Stopped the emote of"
			)
		end,
	}, {
		Name = "clone",
		Role = "Moderator",
		Description = "Creates a statue-like copy of players next to them.",
		Args = { { Type = "players", Name = "players", Description = "The players." } },
		Run = function(_, players: { Player })
			return describe(
				Admin.Each(players, function(player, character, _humanoid, root)
					character.Archivable = true
					const copy = character:Clone()
					if not copy then
						return false
					end

					copy.Name = `{player.Name} (clone)`
					copy:SetAttribute("CajClone", true)
					for _, descendant in ipairs(copy:GetDescendants()) do
						if descendant:IsA("Script") or descendant:IsA("LocalScript") then
							descendant:Destroy()
						end
					end

					copy:PivotTo(root.CFrame * CFrame.new(5, 0, 0))
					copy.Parent = Admin.GetObjectsFolder()
				end),
				"Cloned"
			)
		end,
	}, {
		Name = "clearclones",
		Role = "Moderator",
		Description = "Removes every clone made with the clone command.",
		Args = {},
		Run = function()
			local count = 0
			for _, child in ipairs(Admin.GetObjectsFolder():GetChildren()) do
				if child:GetAttribute("CajClone") then
					child:Destroy()
					count += 1
				end
			end

			return `Removed {Admin.Plural(count, "clone")}.`
		end,
	})

	return commands
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX63">
<Properties>
<string name="Name">Info</string>
<ProtectedString name="Source"><![CDATA[--[[
	Info: look things up. Mostly harmless, mostly available to everyone.
]]

const MarketplaceService = game:GetService("MarketplaceService")
const Players = game:GetService("Players")
const Stats = game:GetService("Stats")
const TextChatService = game:GetService("TextChatService")

return function(Admin)
	const Roles = Admin.Roles

	const function roleLine(player: Player): string
		const role = Roles.GetRole(player)
		return `{role.Name} ({role.Level})`
	end

	return {
		{
			Name = "whoami",
			Aliases = { "myrole" },
			Role = "Player",
			Description = "Shows your role and where it comes from.",
			Args = {},
			Run = function(context)
				const player = context.Executor
				const role = Roles.GetRole(player)
				return `You are {role.Name} (level {role.Level}). Source: {Roles.GetSource(player)}.`
			end,
		},
		{
			Name = "roles",
			Role = "Player",
			Description = "Lists every role and how many players have it.",
			Args = {},
			Run = function(context)
				const lines = {}
				const list = Roles.List()
				for index = #list, 1, -1 do
					const role = list[index]
					local online = 0
					for _, player in ipairs(Players:GetPlayers()) do
						if player:GetAttribute("CajRole") == role.Name then
							online += 1
						end
					end

					table.insert(lines, `{role.Name} - level {role.Level} - {online} online`)
				end

				return Admin.Output(context, "Roles", lines)
			end,
		},
		{
			Name = "getrole",
			Aliases = { "rolecheck" },
			Role = "Player",
			Description = "Shows the role of a player.",
			Args = {
				{ Type = "player", Name = "player", Description = "The player to check." },
			},
			Run = function(_, player: Player)
				const role = Roles.GetRole(player)
				return `{player.Name} is {role.Name} (level {role.Level}). Source: {Roles.GetSource(player)}.`
			end,
		},
		{
			Name = "admins",
			Aliases = { "staff", "mods" },
			Role = "Player",
			Description = "Lists staff members who are in this server.",
			Args = {},
			Run = function(context)
				const staff = {}
				for _, player in ipairs(Players:GetPlayers()) do
					if Roles.IsStaff(player) then
						table.insert(staff, player)
					end
				end

				table.sort(staff, function(a, b)
					return Roles.GetLevel(a) > Roles.GetLevel(b)
				end)

				const lines = {}
				for _, player in ipairs(staff) do
					table.insert(lines, `{player.Name} - {Roles.GetRole(player).Name}`)
				end

				return Admin.Output(context, "Staff online", lines)
			end,
		},
		{
			Name = "players",
			Aliases = { "plist" },
			Role = "Player",
			Description = "Lists every player in the server.",
			Args = {},
			Run = function(context)
				const lines = {}
				for _, player in ipairs(Players:GetPlayers()) do
					table.insert(
						lines,
						`{player.Name} (@{player.DisplayName}) - {roleLine(player)} - {if player.Team then player.Team.Name else "no team"}`
					)
				end

				return Admin.Output(context, `Players ({#lines})`, lines)
			end,
		},
		{
			Name = "count",
			Role = "Player",
			Description = "Shows how many players are in the server.",
			Args = {},
			Run = function()
				return `{#Players:GetPlayers()} / {Players.MaxPlayers} players.`
			end,
		},
		{
			Name = "whois",
			Aliases = { "pinfo", "playerinfo" },
			Role = "Helper",
			Description = "Shows detailed information about a player.",
			Args = {
				{ Type = "player", Name = "player", Description = "The player to inspect." },
			},
			Run = function(context, player: Player)
				const humanoid = Admin.GetHumanoid(player)
				const root = Admin.GetRoot(player)
				const muted, reason = Admin.Chat.IsMuted(player.UserId)

				local healthText = "no character"
				if humanoid then
					healthText = `{math.floor(humanoid.Health)} / {math.floor(humanoid.MaxHealth)}`
				end

				local positionText = "n/a"
				if root then
					const position = root.Position
					positionText = `{math.floor(position.X)}, {math.floor(position.Y)}, {math.floor(position.Z)}`
				end

				const mutedText = if muted then `yes ({reason})` else "no"

				const lines = {
					`Name: {player.Name} (@{player.DisplayName})`,
					`UserId: {player.UserId}`,
					`Account age: {player.AccountAge} days`,
					`Membership: {player.MembershipType.Name}`,
					`Role: {roleLine(player)} - {Roles.GetSource(player)}`,
					`Team: {if player.Team then player.Team.Name else "none"}`,
					`Health: {healthText}`,
					`Position: {positionText}`,
					`Ping: {math.floor(player:GetNetworkPing() * 1000)} ms`,
					`Locale: {player.LocaleId}`,
					`Muted: {mutedText}`,
				}

				return Admin.Output(context, `Who is {player.Name}`, lines)
			end,
		},
		{
			Name = "userid",
			Aliases = { "getid" },
			Role = "Player",
			Description = "Looks up the UserId of a Roblox username.",
			Args = {
				{ Type = "string", Name = "username", Description = "The Roblox username." },
			},
			Run = function(_, username: string)
				const ok, userId = pcall(Players.GetUserIdFromNameAsync, Players, username)
				if not ok then
					return `No Roblox user called "{username}" was found.`
				end

				return `{username} has the UserId {userId}.`
			end,
		},
		{
			Name = "username",
			Aliases = { "getname" },
			Role = "Player",
			Description = "Looks up the username that belongs to a UserId.",
			Args = {
				{ Type = "positiveInteger", Name = "userId", Description = "The UserId." },
			},
			Run = function(_, userId: number)
				const ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
				if not ok then
					return `No Roblox user with the UserId {userId} was found.`
				end

				return `UserId {userId} is {name}.`
			end,
		},
		{
			Name = "serverinfo",
			Aliases = { "sinfo" },
			Role = "Player",
			Description = "Shows information about this server.",
			Args = {},
			Run = function(context)
				const lock = Admin.ServerLock
				const lockText = if lock.Level > 0 then `yes (needs {Roles.GetRoleForLevel(lock.Level).Name}+)` else "no"
				const lines = {
					`Place: {game.PlaceId} (version {game.PlaceVersion})`,
					`Server id: {if game.JobId == "" then "Studio" else game.JobId}`,
					`Players: {#Players:GetPlayers()} / {Players.MaxPlayers}`,
					`Uptime: {Admin.FormatDuration(os.time() - Admin.StartTime)}`,
					`Private server: {if game.PrivateServerId ~= "" then "yes" else "no"}`,
					`Locked: {lockText}`,
					`Chat system: {TextChatService.ChatVersion.Name}`,
					`Saved data: {if Admin.Store.IsPersistent() then "DataStore" else "memory only"}`,
				}

				return Admin.Output(context, "Server", lines)
			end,
		},
		{
			Name = "uptime",
			Role = "Player",
			Description = "Shows how long this server has been running.",
			Args = {},
			Run = function()
				return `This server has been running for {Admin.FormatDuration(os.time() - Admin.StartTime)}.`
			end,
		},
		{
			Name = "servertime",
			Aliases = { "date" },
			Role = "Player",
			Description = "Shows the current server date and time (UTC).",
			Args = {},
			Run = function()
				return os.date("!%Y-%m-%d %H:%M:%S UTC") :: string
			end,
		},
		{
			Name = "ping",
			Role = "Player",
			Description = "Shows the network ping of a player (default: you).",
			Args = {
				{ Type = "player", Name = "player", Description = "The player to check.", Optional = true },
			},
			Run = function(context, player: Player?)
				const target = player or context.Executor
				return `{target.Name}'s ping is {math.floor(target:GetNetworkPing() * 1000)} ms.`
			end,
		},
		{
			Name = "position",
			Aliases = { "pos", "where" },
			Role = "Helper",
			Description = "Shows where a player is standing.",
			Args = {
				{ Type = "player", Name = "player", Description = "The player to locate." },
			},
			Run = function(_, player: Player)
				const root = Admin.GetRoot(player)
				if not root then
					return `{player.Name} has no character.`
				end

				const position = root.Position
				return `{player.Name} is at {math.floor(position.X)}, {math.floor(position.Y)}, {math.floor(position.Z)}.`
			end,
		},
		{
			Name = "teams",
			Role = "Player",
			Description = "Lists the teams in the game.",
			Args = {},
			Run = function(context)
				const lines = {}
				for _, team in ipairs(game:GetService("Teams"):GetTeams()) do
					table.insert(lines, `{team.Name} - {#team:GetPlayers()} players`)
				end

				return Admin.Output(context, "Teams", lines)
			end,
		},
		{
			Name = "prefix",
			Role = "Player",
			Description = "Shows how to open the console and the chat command prefix.",
			Args = {},
			Run = function()
				const chatConfig = Admin.Config.Chat
				const keys = table.concat(Admin.Config.ConsoleKeys or { "F2" }, " or ")
				if chatConfig and chatConfig.Enabled then
					return `Open the console with {keys}, or type {chatConfig.Prefix}command in chat.`
				end

				return `Open the console with {keys}.`
			end,
		},
		{
			Name = "about",
			Aliases = { "caj" },
			Role = "Player",
			Description = "Shows which admin system this is.",
			Args = {},
			Run = function()
				local count = 0
				for _ in pairs(Admin.Specs) do
					count += 1
				end

				return `CajCMDR {Admin.Version}, built on Cmdr. {count} commands loaded. Type help for the list.`
			end,
		},
		{
			Name = "perms",
			Aliases = { "access" },
			Role = "Player",
			Description = "Shows which role is needed for a command.",
			Args = {
				{ Type = "command", Name = "command", Description = "The command to check." },
			},
			Run = function(context, commandName: string)
				const key = commandName:lower()
				const level = Admin.CommandLevels[key]
				if level == nil then
					return `"{commandName}" is not managed by CajCMDR.`
				end

				if level < 0 then
					return `"{commandName}" is disabled.`
				end

				const role = Roles.GetRoleForLevel(level)
				const allowed = Roles.GetLevel(context.Executor) >= level
				return `"{commandName}" needs {role.Name} or higher. {if allowed then "You can use it." else "You cannot use it."}`
			end,
		},
		{
			Name = "gameinfo",
			Aliases = { "placeinfo" },
			Role = "Player",
			Description = "Shows the name and creator of this experience.",
			Args = {},
			Run = function(context)
				const ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, game.PlaceId)
				if not ok or type(info) ~= "table" then
					return "No published info available (is the place published?)."
				end

				return Admin.Output(context, info.Name or "Game", {
					`Creator: {if info.Creator then info.Creator.Name else "unknown"}`,
					`Updated: {tostring(info.Updated)}`,
					`Description: {Admin.Truncate(tostring(info.Description or ""), 160)}`,
				})
			end,
		},
		{
			Name = "serverstats",
			Aliases = { "perf" },
			Role = "Admin",
			Description = "Shows memory, physics and instance statistics of the server.",
			Args = {},
			Run = function(context)
				const lines = {}

				const okMemory, memory = pcall(function()
					return Stats:GetTotalMemoryUsageMb()
				end)
				if okMemory then
					table.insert(lines, `Memory: {math.floor(memory)} MB`)
				end

				const okInstances, instances = pcall(function()
					return Stats.InstanceCount
				end)
				if okInstances then
					table.insert(lines, `Instances: {instances}`)
				end

				const okHeartbeat, heartbeat = pcall(function()
					return Stats.HeartbeatTimeMs
				end)
				if okHeartbeat then
					table.insert(lines, `Heartbeat: {string.format("%.2f", heartbeat)} ms`)
				end

				table.insert(lines, `Physics FPS: {math.floor(workspace:GetRealPhysicsFPS())}`)
				table.insert(lines, `Players: {#Players:GetPlayers()}`)

				return Admin.Output(context, "Server stats", lines)
			end,
		},
		{
			Name = "logs",
			Aliases = { "cmdlogs" },
			Role = "Admin",
			Description = "Shows the most recent commands that were run in this server.",
			Args = {
				{ Type = "positiveInteger", Name = "count", Description = "How many entries (default 25).", Optional = true },
			},
			Run = function(context, count: number?)
				const lines = {}
				for _, entry in ipairs(Admin.Log.GetCommands(math.min(count or 25, 80))) do
					table.insert(lines, `[{os.date("!%H:%M:%S", entry.Time)}] {entry.Executor}: {entry.Text}`)
				end

				return Admin.Output(context, "Command log", lines)
			end,
		},
		{
			Name = "clearlogs",
			Role = "Admin",
			Description = "Clears the in-memory command log.",
			Args = {},
			Run = function()
				Admin.Log.ClearCommands()
				return "Command log cleared."
			end,
		},
		{
			Name = "chatlogs",
			Role = "Moderator",
			Description = "Shows the most recent chat messages.",
			Args = {
				{ Type = "positiveInteger", Name = "count", Description = "How many messages (default 25).", Optional = true },
			},
			Run = function(context, count: number?)
				const lines = {}
				for _, entry in ipairs(Admin.Log.GetChat(math.min(count or 25, 80))) do
					table.insert(lines, `[{os.date("!%H:%M:%S", entry.Time)}] {entry.Player}: {entry.Text}`)
				end

				return Admin.Output(context, "Chat log", lines)
			end,
		},
		{
			Name = "auditlog",
			Aliases = { "audit" },
			Role = "Moderator",
			Description = "Shows the saved moderation history (kicks, bans, warnings, ...).",
			Args = {
				{ Type = "positiveInteger", Name = "count", Description = "How many entries (default 20).", Optional = true },
			},
			Run = function(context, count: number?)
				const entries = Admin.Log.GetAudit()
				const lines = {}
				for index = math.max(1, #entries - (count or 20) + 1), #entries do
					const entry = entries[index]
					table.insert(lines, `[{Admin.Timestamp(entry.Time)}] {entry.Executor}: {entry.Text} -> {entry.Response or ""}`)
				end

				return Admin.Output(context, "Moderation history", lines)
			end,
		},
	}
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX64">
<Properties>
<string name="Name">Moderation</string>
<ProtectedString name="Source"><![CDATA[--[[
	Moderation: kicks, bans, warnings, mutes, jails, server lock, reports.
	Bans use Roblox's official Players:BanAsync, so they persist across servers and cover alt accounts.
]]

const Players = game:GetService("Players")
const ServerStorage = game:GetService("ServerStorage")

const DEFAULT_REASON = "No reason given"
const JAIL_SIZE = 12

return function(Admin)
	const Roles = Admin.Roles
	const Chat = Admin.Chat
	const Store = Admin.Store
	const Config = Admin.Config

	const jails: { [Player]: { Cage: Model, Center: CFrame, Connection: RBXScriptConnection } } = {}
	const punished: { [Player]: Model } = {}

	----------------------------------------------------------------------------------------------------
	-- helpers
	----------------------------------------------------------------------------------------------------

	const function levelForRoleName(roleName: string?, fallbackIndex: number): number
		const role = Roles.Get(roleName)
		if role then
			return role.Level
		end

		const list = Roles.List()
		return list[math.min(fallbackIndex, #list)].Level
	end

	--[[ Splits user ids into the ones the executor may act on and a list of names that are protected. ]]
	const function filterUserIds(executor: Player, userIds: { number }): ({ number }, { string })
		const allowed = {}
		const blocked = {}
		for _, userId in ipairs(userIds) do
			if Admin.CanAffectUserId(executor, userId) then
				table.insert(allowed, userId)
			else
				table.insert(blocked, Admin.NameFromUserId(userId))
			end
		end

		return allowed, blocked
	end

	const function namesOf(userIds: { number }): string
		const names = {}
		for index, userId in ipairs(userIds) do
			if index > 5 then
				table.insert(names, `+{#userIds - 5} more`)
				break
			end
			table.insert(names, Admin.NameFromUserId(userId))
		end

		return table.concat(names, ", ")
	end

	const function protectedMessage(blocked: { string }): string
		return `You cannot act on {table.concat(blocked, ", ")} (equal or higher role).`
	end

	const function banUsers(context: any, userIds: { number }, duration: number, reason: string): string
		const executor = context.Executor
		const allowed, blocked = filterUserIds(executor, userIds)
		if #allowed == 0 then
			return protectedMessage(blocked)
		end

		const displayReason = Admin.Truncate(reason, 380)
		const ok, err = pcall(Players.BanAsync, Players, {
			UserIds = allowed,
			Duration = duration,
			DisplayReason = displayReason,
			PrivateReason = Admin.Truncate(`{executor.Name}: {reason}`, 950),
			ExcludeAltAccounts = Config.Bans.ExcludeAltAccounts == true,
			ApplyToUniverse = Config.Bans.ApplyToUniverse ~= false,
		})

		local note = ""
		if not ok then
			-- BanAsync is unavailable (for example in Studio): fall back to banning for this server only.
			for _, userId in ipairs(allowed) do
				Admin.ServerBans[userId] = reason
				const online = Players:GetPlayerByUserId(userId)
				if online then
					online:Kick(`Banned: {reason}`)
				end
			end
			note = ` (BanAsync failed: {err}. Applied as a server ban instead.)`
		end

		const length = if duration < 0 then "permanently" else `for {Admin.FormatDuration(duration)}`
		Admin.Audit(context, `banned {namesOf(allowed)} {length}: {reason}`)

		local message = `Banned {namesOf(allowed)} {length}.{note}`
		if #blocked > 0 then
			message ..= ` Skipped: {table.concat(blocked, ", ")}.`
		end

		return message
	end

	const function addEntry(storeName: string, userId: number, entry: any): number
		local total = 0
		Store.Update(storeName, tostring(userId), function(old)
			const list = if type(old) == "table" then old else {}
			table.insert(list, entry)
			total = #list
			return list
		end)

		return total
	end

	const function listEntries(context: any, storeName: string, title: string, userId: number): string
		const entries = Store.Get(storeName, tostring(userId), {})
		const lines = {}
		for index, entry in ipairs(entries) do
			table.insert(lines, `#{index} [{Admin.Timestamp(entry.Time)}] {entry.By}: {entry.Text}`)
		end

		return Admin.Output(context, `{title} for {Admin.NameFromUserId(userId)}`, lines)
	end

	const function shutdownServer(reason: string)
		Admin.ServerLock.Level = Roles.MaxLevel + 1
		Admin.ServerLock.Reason = `Server shut down: {reason}`

		Admin.Announce("Server shutting down", reason, 6)
		task.delay(4, function()
			for _, player in ipairs(Players:GetPlayers()) do
				player:Kick(`Server shut down: {reason}`)
			end
		end)
	end

	-- Cross-server actions
	Admin.OnGlobal("kick", function(data)
		const player = Players:GetPlayerByUserId(data.UserId)
		if player then
			player:Kick(data.Reason or DEFAULT_REASON)
		end
	end)

	Admin.OnGlobal("shutdown", function(data)
		shutdownServer(data.Reason or "Maintenance")
	end)

	----------------------------------------------------------------------------------------------------
	-- jail / punish
	----------------------------------------------------------------------------------------------------

	const function buildCage(center: Vector3): Model
		const model = Instance.new("Model")
		model.Name = "CajJail"

		const function wall(size: Vector3, offset: Vector3)
			const part = Instance.new("Part")
			part.Anchored = true
			part.Size = size
			part.Position = center + offset
			part.Material = Enum.Material.Metal
			part.Color = Color3.fromRGB(60, 60, 70)
			part.Transparency = 0.25
			part.Parent = model
		end

		const half = JAIL_SIZE / 2
		wall(Vector3.new(JAIL_SIZE, 1, JAIL_SIZE), Vector3.new(0, -3.5, 0))
		wall(Vector3.new(JAIL_SIZE, 1, JAIL_SIZE), Vector3.new(0, 8.5, 0))
		wall(Vector3.new(JAIL_SIZE, 12, 1), Vector3.new(0, 2.5, half))
		wall(Vector3.new(JAIL_SIZE, 12, 1), Vector3.new(0, 2.5, -half))
		wall(Vector3.new(1, 12, JAIL_SIZE), Vector3.new(half, 2.5, 0))
		wall(Vector3.new(1, 12, JAIL_SIZE), Vector3.new(-half, 2.5, 0))

		model.Parent = Admin.GetObjectsFolder()
		return model
	end

	const function unjailPlayer(player: Player): boolean
		const jail = jails[player]
		if not jail then
			return false
		end

		jail.Connection:Disconnect()
		jail.Cage:Destroy()
		jails[player] = nil
		return true
	end

	Players.PlayerRemoving:Connect(function(player)
		unjailPlayer(player)
		punished[player] = nil
	end)

	----------------------------------------------------------------------------------------------------
	-- commands
	----------------------------------------------------------------------------------------------------

	return {
		{
			Name = "kick",
			Aliases = { "boot" },
			Role = "Helper",
			Description = "Kicks players from the server.",
			Args = {
				{ Type = "targets", Name = "players", Description = "The players to kick." },
				{ Type = "string", Name = "reason", Description = "Shown to the player.", Optional = true },
			},
			Run = function(context, players: { Player }, reason: string?)
				const why = reason or DEFAULT_REASON
				const names = Admin.Names(players)
				const count = Admin.EachPlayer(players, function(player)
					player:Kick(`You were kicked. Reason: {why}`)
				end)

				Admin.Audit(context, `kicked {names}: {why}`)
				return Admin.Result("Kicked", count)
			end,
		},
		{
			Name = "kickall",
			Role = "Admin",
			Description = "Kicks every player with a lower role than you.",
			Args = {
				{ Type = "string", Name = "reason", Description = "Shown to the players.", Optional = true },
			},
			Run = function(context, reason: string?)
				const why = reason or "The server is being cleared"
				const executorLevel = Roles.GetLevel(context.Executor)
				local count = 0
				for _, player in ipairs(Players:GetPlayers()) do
					if player ~= context.Executor and Roles.GetLevel(player) < executorLevel then
						player:Kick(`You were kicked. Reason: {why}`)
						count += 1
					end
				end

				Admin.Audit(context, `kicked everyone below their rank ({count}): {why}`)
				return Admin.Result("Kicked", count)
			end,
		},
		{
			Name = "ban",
			Role = "Admin",
			Description = "Permanently bans players (works on offline users too).",
			Args = {
				{ Type = "playerIds", Name = "players", Description = "Players or UserIds (#123) to ban." },
				{ Type = "string", Name = "reason", Description = "Shown to the player.", Optional = true },
			},
			Run = function(context, userIds: { number }, reason: string?)
				return banUsers(context, userIds, -1, reason or DEFAULT_REASON)
			end,
		},
		{
			Name = "tempban",
			Aliases = { "tban" },
			Role = "Moderator",
			Description = "Bans players for a limited time, e.g. 1d12h.",
			Args = {
				{ Type = "playerIds", Name = "players", Description = "Players or UserIds (#123) to ban." },
				{ Type = "duration", Name = "duration", Description = "How long, e.g. 30m, 2h, 7d." },
				{ Type = "string", Name = "reason", Description = "Shown to the player.", Optional = true },
			},
			Run = function(context, userIds: { number }, duration: number, reason: string?)
				if duration <= 0 then
					return "The duration must be longer than zero. Use ban for permanent bans."
				end

				return banUsers(context, userIds, duration, reason or DEFAULT_REASON)
			end,
		},
		{
			Name = "unban",
			Role = "Admin",
			Description = "Removes bans (works on offline users).",
			Args = {
				{ Type = "playerIds", Name = "players", Description = "Players or UserIds (#123) to unban." },
			},
			Run = function(context, userIds: { number })
				const ok, err = pcall(Players.UnbanAsync, Players, {
					UserIds = userIds,
					ApplyToUniverse = Config.Bans.ApplyToUniverse ~= false,
				})

				for _, userId in ipairs(userIds) do
					Admin.ServerBans[userId] = nil
				end

				if not ok then
					return `Server bans were lifted, but UnbanAsync failed: {err}`
				end

				Admin.Audit(context, `unbanned {namesOf(userIds)}`)
				return `Unbanned {namesOf(userIds)}.`
			end,
		},
		{
			Name = "baninfo",
			Aliases = { "banhistory" },
			Role = "Moderator",
			Description = "Shows the ban history of a user.",
			Args = {
				{ Type = "playerId", Name = "player", Description = "Player or UserId (#123)." },
			},
			Run = function(context, userId: number)
				const ok, pages = pcall(Players.GetBanHistoryAsync, Players, userId)
				if not ok then
					return `Could not read the ban history: {pages}`
				end

				const lines = {}
				for _, item in ipairs(pages:GetCurrentPage()) do
					table.insert(
						lines,
						`{if item.Ban then "BAN" else "UNBAN"} {tostring(item.StartTime or "")} - {tostring(item.DurationSeconds or "?")}s - {tostring(item.DisplayReason or "")} | {tostring(item.PrivateReason or "")}`
					)
				end

				return Admin.Output(context, `Ban history of {Admin.NameFromUserId(userId)}`, lines)
			end,
		},
		{
			Name = "serverban",
			Aliases = { "sban" },
			Role = "Moderator",
			Description = "Bans players from this server only (until it closes).",
			Args = {
				{ Type = "playerIds", Name = "players", Description = "Players or UserIds (#123)." },
				{ Type = "string", Name = "reason", Description = "Shown to the player.", Optional = true },
			},
			Run = function(context, userIds: { number }, reason: string?)
				const why = reason or DEFAULT_REASON
				const allowed, blocked = filterUserIds(context.Executor, userIds)
				if #allowed == 0 then
					return protectedMessage(blocked)
				end

				for _, userId in ipairs(allowed) do
					Admin.ServerBans[userId] = why
					const online = Players:GetPlayerByUserId(userId)
					if online then
						online:Kick(`Banned from this server: {why}`)
					end
				end

				Admin.Audit(context, `server-banned {namesOf(allowed)}: {why}`)
				return `Server-banned {namesOf(allowed)}.`
			end,
		},
		{
			Name = "unserverban",
			Aliases = { "unsban" },
			Role = "Moderator",
			Description = "Lifts a server-only ban.",
			Args = {
				{ Type = "playerIds", Name = "players", Description = "Players or UserIds (#123)." },
			},
			Run = function(context, userIds: { number })
				local count = 0
				for _, userId in ipairs(userIds) do
					if Admin.ServerBans[userId] then
						Admin.ServerBans[userId] = nil
						count += 1
					end
				end

				Admin.Audit(context, `lifted server bans ({count})`)
				return `Lifted {count} server ban(s).`
			end,
		},
		{
			Name = "warn",
			Role = "Helper",
			Description = "Gives players a saved warning.",
			Args = {
				{ Type = "targets", Name = "players", Description = "The players to warn." },
				{ Type = "string", Name = "reason", Description = "Why they are being warned." },
			},
			Run = function(context, players: { Player }, reason: string)
				const limit = Config.Warnings.AutoKickAt or 0
				const count = Admin.EachPlayer(players, function(player)
					const total = addEntry("Warnings", player.UserId, {
						Time = os.time(),
						By = context.Executor.Name,
						Text = reason,
					})

					Admin.Notify(player, `Warning #{total}: {reason}`, "warn")
					if limit > 0 and total >= limit then
						player:Kick(`You reached {limit} warnings. Last reason: {reason}`)
					end
				end)

				Admin.Audit(context, `warned {Admin.Names(players)}: {reason}`)
				return Admin.Result("Warned", count)
			end,
		},
		{
			Name = "warnings",
			Aliases = { "warns" },
			Role = "Helper",
			Description = "Lists the saved warnings of a user.",
			Args = {
				{ Type = "playerId", Name = "player", Description = "Player or UserId (#123)." },
			},
			Run = function(context, userId: number)
				return listEntries(context, "Warnings", "Warnings", userId)
			end,
		},
		{
			Name = "clearwarnings",
			Aliases = { "clearwarns" },
			Role = "Moderator",
			Description = "Deletes every warning of a user.",
			Args = {
				{ Type = "playerId", Name = "player", Description = "Player or UserId (#123)." },
			},
			Run = function(context, userId: number)
				Store.Remove("Warnings", tostring(userId))
				Admin.Audit(context, `cleared the warnings of {Admin.NameFromUserId(userId)}`)
				return `Cleared the warnings of {Admin.NameFromUserId(userId)}.`
			end,
		},
		{
			Name = "note",
			Role = "Helper",
			Description = "Saves a private staff note about a user.",
			Args = {
				{ Type = "playerId", Name = "player", Description = "Player or UserId (#123)." },
				{ Type = "string", Name = "note", Description = "The note." },
			},
			Run = function(context, userId: number, text: string)
				const total = addEntry("Notes", userId, { Time = os.time(), By = context.Executor.Name, Text = text })
				return `Saved note #{total} for {Admin.NameFromUserId(userId)}.`
			end,
		},
		{
			Name = "notes",
			Role = "Helper",
			Description = "Lists the staff notes about a user.",
			Args = {
				{ Type = "playerId", Name = "player", Description = "Player or UserId (#123)." },
			},
			Run = function(context, userId: number)
				return listEntries(context, "Notes", "Notes", userId)
			end,
		},
		{
			Name = "clearnotes",
			Role = "Admin",
			Description = "Deletes every staff note about a user.",
			Args = {
				{ Type = "playerId", Name = "player", Description = "Player or UserId (#123)." },
			},
			Run = function(context, userId: number)
				Store.Remove("Notes", tostring(userId))
				Admin.Audit(context, `cleared the notes of {Admin.NameFromUserId(userId)}`)
				return `Cleared the notes of {Admin.NameFromUserId(userId)}.`
			end,
		},
		{
			Name = "mute",
			Role = "Helper",
			Description = "Stops players from using chat (optionally for a limited time).",
			Args = {
				{ Type = "targets", Name = "players", Description = "The players to mute." },
				{ Type = "duration", Name = "duration", Description = "How long, e.g. 10m. Default: until the server closes.", Optional = true },
				{ Type = "string", Name = "reason", Description = "Why they are muted.", Optional = true },
			},
			Run = function(context, players: { Player }, duration: number?, reason: string?)
				const why = reason or DEFAULT_REASON
				const count = Admin.EachPlayer(players, function(player)
					Chat.Mute(player.UserId, duration, why)
					Admin.Notify(player, `You were muted. Reason: {why}`, "warn")
				end)

				Admin.Audit(context, `muted {Admin.Names(players)}: {why}`)
				return Admin.Result("Muted", count)
			end,
		},
		{
			Name = "unmute",
			Role = "Helper",
			Description = "Lets muted players chat again.",
			Args = {
				{ Type = "players", Name = "players", Description = "The players to unmute." },
			},
			Run = function(context, players: { Player })
				const count = Admin.EachPlayer(players, function(player)
					if Chat.Unmute(player.UserId) then
						Admin.Notify(player, "You were unmuted.", "success")
						return true
					end

					return false
				end)

				Admin.Audit(context, `unmuted {Admin.Names(players)}`)
				return Admin.Result("Unmuted", count)
			end,
		},
		{
			Name = "muted",
			Role = "Helper",
			Description = "Lists the currently muted players.",
			Args = {},
			Run = function(context)
				const lines = {}
				for userId in pairs(Chat.Muted) do
					const muted, reason, remaining = Chat.IsMuted(userId)
					if muted then
						table.insert(lines, `{Admin.NameFromUserId(userId)} - {Admin.FormatDuration(remaining)} - {reason}`)
					end
				end

				return Admin.Output(context, "Muted players", lines)
			end,
		},
		{
			Name = "lockchat",
			Role = "Moderator",
			Description = "Only lets the given role (and above) chat. Default: Helper.",
			Args = {
				{ Type = "role", Name = "role", Description = "Minimum role allowed to chat.", Optional = true },
			},
			Run = function(context, roleName: string?)
				Chat.LockLevel = levelForRoleName(roleName or "Helper", 2)
				Admin.Audit(context, `locked chat for roles below {Roles.GetRoleForLevel(Chat.LockLevel).Name}`)
				return `Chat is now locked for roles below {Roles.GetRoleForLevel(Chat.LockLevel).Name}.`
			end,
		},
		{
			Name = "unlockchat",
			Role = "Moderator",
			Description = "Unlocks the chat again.",
			Args = {},
			Run = function(context)
				Chat.LockLevel = 0
				Admin.Audit(context, "unlocked chat")
				return "Chat unlocked."
			end,
		},
		{
			Name = "slowmode",
			Role = "Moderator",
			Description = "Limits how often normal players can chat (0 = off).",
			Args = {
				{ Type = "nonNegativeInteger", Name = "seconds", Description = "Seconds between messages." },
			},
			Run = function(context, seconds: number)
				Chat.SlowSeconds = seconds
				Admin.Audit(context, `set slow mode to {seconds}s`)
				return if seconds == 0 then "Slow mode disabled." else `Slow mode: one message every {seconds}s.`
			end,
		},
		{
			Name = "jail",
			Role = "Moderator",
			Description = "Locks players inside a cage.",
			Args = {
				{ Type = "targets", Name = "players", Description = "The players to jail." },
			},
			Run = function(context, players: { Player })
				const count = Admin.Each(players, function(player, _character, _humanoid, root)
					if jails[player] then
						return false
					end

					const center = root.Position + Vector3.new(0, 2, 0)
					const cage = buildCage(center)
					const spot = CFrame.new(center)

					jails[player] = {
						Cage = cage,
						Center = spot,
						Connection = player.CharacterAdded:Connect(function(character)
							const newRoot = character:WaitForChild("HumanoidRootPart", 10)
							if newRoot and jails[player] then
								task.wait()
								character:PivotTo(spot)
							end
						end),
					}
				end)

				Admin.Audit(context, `jailed {Admin.Names(players)}`)
				return Admin.Result("Jailed", count)
			end,
		},
		{
			Name = "unjail",
			Role = "Moderator",
			Description = "Releases players from jail.",
			Args = {
				{ Type = "players", Name = "players", Description = "The players to release." },
			},
			Run = function(context, players: { Player })
				const count = Admin.EachPlayer(players, unjailPlayer)
				Admin.Audit(context, `released {Admin.Names(players)} from jail`)
				return Admin.Result("Released", count)
			end,
		},
		{
			Name = "punish",
			Role = "Moderator",
			Description = "Removes players' characters from the world until unpunished.",
			Args = {
				{ Type = "targets", Name = "players", Description = "The players to punish." },
			},
			Run = function(context, players: { Player })
				const count = Admin.Each(players, function(player, character)
					punished[player] = character
					character.Parent = ServerStorage
				end)

				Admin.Audit(context, `punished {Admin.Names(players)}`)
				return Admin.Result("Punished", count)
			end,
		},
		{
			Name = "unpunish",
			Role = "Moderator",
			Description = "Puts punished players back into the world.",
			Args = {
				{ Type = "players", Name = "players", Description = "The players to restore." },
			},
			Run = function(_, players: { Player })
				const count = Admin.EachPlayer(players, function(player)
					const character = punished[player]
					punished[player] = nil
					if character and character.Parent == ServerStorage then
						character.Parent = workspace
						return true
					end

					return false
				end)

				return Admin.Result("Restored", count)
			end,
		},
		{
			Name = "slock",
			Aliases = { "serverlock" },
			Role = "Moderator",
			Description = "Stops players below a role from joining this server. Default: Helper.",
			Args = {
				{ Type = "role", Name = "role", Description = "Minimum role allowed to join.", Optional = true },
			},
			Run = function(context, roleName: string?)
				Admin.ServerLock.Level = levelForRoleName(roleName or "Helper", 2)
				Admin.ServerLock.Reason = "This server is locked."
				Admin.Audit(context, `locked the server for roles below {Roles.GetRoleForLevel(Admin.ServerLock.Level).Name}`)
				return `Server locked. Players below {Roles.GetRoleForLevel(Admin.ServerLock.Level).Name} can no longer join.`
			end,
		},
		{
			Name = "unslock",
			Aliases = { "unlockserver" },
			Role = "Moderator",
			Description = "Unlocks the server.",
			Args = {},
			Run = function(context)
				Admin.ServerLock.Level = 0
				Admin.ServerLock.Reason = ""
				Admin.Audit(context, "unlocked the server")
				return "Server unlocked."
			end,
		},
		{
			Name = "shutdown",
			Role = "Admin",
			Description = "Kicks everyone and locks this server.",
			Args = {
				{ Type = "string", Name = "reason", Description = "Shown to the players.", Optional = true },
			},
			Run = function(context, reason: string?)
				const why = reason or "Maintenance"
				Admin.Audit(context, `shut down the server: {why}`)
				shutdownServer(why)
				return "Shutting down in 4 seconds..."
			end,
		},
		{
			Name = "globalshutdown",
			Aliases = { "gshutdown" },
			Role = "Owner",
			Description = "Shuts down EVERY server of this experience.",
			Args = {
				{ Type = "string", Name = "reason", Description = "Shown to the players.", Optional = true },
			},
			Run = function(context, reason: string?)
				const why = reason or "Maintenance"
				Admin.Audit(context, `shut down all servers: {why}`)

				const ok, err = Admin.PublishGlobal("shutdown", { Reason = why })
				if not ok then
					Admin.RunGlobalLocally("shutdown", { Reason = why })
					return `Could not reach other servers ({err}). Shut down this server only.`
				end

				return "Shutdown sent to all servers."
			end,
		},
		{
			Name = "gkick",
			Aliases = { "globalkick" },
			Role = "Admin",
			Description = "Kicks a user from whichever server they are in.",
			Args = {
				{ Type = "playerId", Name = "player", Description = "Player or UserId (#123)." },
				{ Type = "string", Name = "reason", Description = "Shown to the player.", Optional = true },
			},
			Run = function(context, userId: number, reason: string?)
				if not Admin.CanAffectUserId(context.Executor, userId) then
					return "You cannot act on someone with an equal or higher role."
				end

				const data = { UserId = userId, Reason = `You were kicked. Reason: {reason or DEFAULT_REASON}` }
				const ok = Admin.PublishGlobal("kick", data)
				if not ok then
					Admin.RunGlobalLocally("kick", data)
				end

				Admin.Audit(context, `global-kicked {Admin.NameFromUserId(userId)}: {reason or DEFAULT_REASON}`)
				return `Sent a kick for {Admin.NameFromUserId(userId)} to all servers.`
			end,
		},
		{
			Name = "report",
			Aliases = { "callmod" },
			Role = "Player",
			Description = "Reports a player to the staff in this server.",
			Args = {
				{ Type = "player", Name = "player", Description = "The player you are reporting." },
				{ Type = "string", Name = "reason", Description = "What happened." },
			},
			Run = function(context, player: Player, reason: string)
				if player == context.Executor then
					return "You cannot report yourself."
				end

				const ready, wait = Admin.Cooldown(`report{context.Executor.UserId}`, Config.ReportCooldown or 60)
				if not ready then
					return `Please wait {math.ceil(wait)} more seconds before sending another report.`
				end

				const text = `REPORT: {context.Executor.Name} reported {player.Name}: {Admin.Truncate(reason, 200)}`
				Admin.Log.Audit({ Time = os.time(), Executor = context.Executor.Name, UserId = context.Executor.UserId, Text = text })
				Admin.NotifyStaff(text, "warn", 1)
				Admin.Log.Webhook(text)
				return "Your report was sent to the staff. Thank you!"
			end,
		},
	}
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX65">
<Properties>
<string name="Name">Staff</string>
<ProtectedString name="Source"><![CDATA[--[[
	Staff: manage roles and command permissions while the game is running.
]]

const Players = game:GetService("Players")

-- These can never be disabled or re-ranked at runtime, so nobody can lock the owner out.
const PROTECTED_COMMANDS = { setcmdrole = true, disablecmd = true, enablecmd = true, resetcmdroles = true }

return function(Admin)
	const Roles = Admin.Roles

	--[[ Roles at or above the executor's own cannot be handed out (the top role may hand out anything). ]]
	const function canGrant(executor: Player, role: any): boolean
		const level = Roles.GetLevel(executor)
		return level >= Roles.MaxLevel or role.Level < level
	end

	return {
		{
			Name = "setrole",
			Aliases = { "giverole" },
			Role = "Admin",
			Description = "Gives players a role until this server closes.",
			Args = {
				{ Type = "targets", Name = "players", Description = "The players." },
				{ Type = "role", Name = "role", Description = "The role to give." },
			},
			Run = function(context, players: { Player }, roleName: string)
				const role = Roles.Get(roleName)
				if not role or not canGrant(context.Executor, role) then
					return "You can only hand out roles that are lower than your own."
				end

				const count = Admin.EachPlayer(players, function(player)
					Roles.SetTemp(player.UserId, role.Name)
					Admin.Notify(player, `You were given the {role.Name} role.`, "success")
				end)

				Admin.Audit(context, `gave {role.Name} to {Admin.Names(players)} (temporary)`)
				return Admin.Result(`Gave {role.Name} to`, count)
			end,
		},
		{
			Name = "saverole",
			Role = "HeadAdmin",
			Description = "Gives a user a role that is saved forever (works on offline users).",
			Args = {
				{ Type = "playerId", Name = "player", Description = "Player or UserId (#123)." },
				{ Type = "role", Name = "role", Description = "The role to give." },
			},
			Run = function(context, userId: number, roleName: string)
				const role = Roles.Get(roleName)
				if not role or not canGrant(context.Executor, role) then
					return "You can only hand out roles that are lower than your own."
				end

				if not Admin.CanAffectUserId(context.Executor, userId) then
					return "You cannot change the role of someone with an equal or higher role."
				end

				const name = Admin.NameFromUserId(userId)
				const saved = Roles.SetSaved(userId, role.Name)
				Admin.Audit(context, `saved the {role.Name} role for {name}`)

				if not saved then
					return `Gave {name} the {role.Name} role for now, but saving failed (check DataStore access).`
				end

				return `{name} now has the {role.Name} role permanently.`
			end,
		},
		{
			Name = "removerole",
			Aliases = { "unrole" },
			Role = "Admin",
			Description = "Removes temporary and saved roles from a user (community ranks still apply).",
			Args = {
				{ Type = "playerId", Name = "player", Description = "Player or UserId (#123)." },
			},
			Run = function(context, userId: number)
				if not Admin.CanAffectUserId(context.Executor, userId) then
					return "You cannot change the role of someone with an equal or higher role."
				end

				Roles.Clear(userId)
				Admin.Audit(context, `removed the custom roles of {Admin.NameFromUserId(userId)}`)
				return `Removed the custom roles of {Admin.NameFromUserId(userId)}.`
			end,
		},
		{
			Name = "refreshroles",
			Aliases = { "refreshranks" },
			Role = "Moderator",
			Description = "Re-checks community ranks right now (default: everyone).",
			Args = {
				{ Type = "players", Name = "players", Description = "The players (default: all).", Optional = true },
			},
			Run = function(_, players: { Player }?)
				const list = players or Players:GetPlayers()
				local count = 0
				for _, player in ipairs(list) do
					task.spawn(Roles.Resolve, player)
					count += 1
				end

				return `Refreshing the roles of {Admin.Plural(count, "player")}.`
			end,
		},
		{
			Name = "staffchat",
			Aliases = { "sc", "a" },
			Role = "Helper",
			Description = "Sends a message that only staff can see.",
			Args = { { Type = "string", Name = "message", Description = "The message." } },
			Run = function(context, message: string)
				Admin.NotifyStaff(`[Staff] {context.Executor.DisplayName}: {message}`, "info", 1)
				return ""
			end,
		},
		{
			Name = "setcmdrole",
			Aliases = { "cmdrole" },
			Role = "Owner",
			Description = "Changes which role is needed for a command until the server closes.",
			Args = {
				{ Type = "command", Name = "command", Description = "The command." },
				{ Type = "role", Name = "role", Description = "The minimum role." },
			},
			Run = function(context, commandName: string, roleName: string)
				const key = commandName:lower()
				const role = Roles.Get(roleName)
				if PROTECTED_COMMANDS[key] or not role or Admin.CommandLevels[key] == nil then
					return "That command cannot be changed."
				end

				Admin.CommandLevels[key] = role.Level
				Admin.PublishCommandLevels()
				Admin.Audit(context, `set {commandName} to {role.Name}`)
				return `{commandName} now needs {role.Name} or higher.`
			end,
		},
		{
			Name = "disablecmd",
			Aliases = { "disablecommand" },
			Role = "Owner",
			Description = "Turns a command off until the server closes.",
			Args = { { Type = "command", Name = "command", Description = "The command." } },
			Run = function(context, commandName: string)
				const key = commandName:lower()
				if PROTECTED_COMMANDS[key] or Admin.CommandLevels[key] == nil then
					return "That command cannot be disabled."
				end

				Admin.CommandLevels[key] = -1
				Admin.PublishCommandLevels()
				Admin.Audit(context, `disabled {commandName}`)
				return `{commandName} is now disabled.`
			end,
		},
		{
			Name = "enablecmd",
			Aliases = { "enablecommand" },
			Role = "Owner",
			Description = "Turns a disabled command back on with its normal role.",
			Args = { { Type = "command", Name = "command", Description = "The command." } },
			Run = function(context, commandName: string)
				const key = commandName:lower()
				const spec = Admin.Specs[key]
				if not spec then
					return "That command is not managed by CajCMDR."
				end

				Admin.CommandLevels[key] = spec.Level
				Admin.PublishCommandLevels()
				Admin.Audit(context, `enabled {commandName}`)
				return `{commandName} now needs {spec.Role} or higher.`
			end,
		},
		{
			Name = "resetcmdroles",
			Role = "Owner",
			Description = "Restores every command to the role from the Config.",
			Args = {},
			Run = function(context)
				for key, spec in pairs(Admin.Specs) do
					Admin.CommandLevels[key] = spec.Level
				end

				Admin.PublishCommandLevels()
				Admin.Audit(context, "reset all command roles")
				return "All command roles were reset."
			end,
		},
		{
			Name = "setprefix",
			Role = "Owner",
			Description = "Changes the chat command prefix until the server closes.",
			Args = { { Type = "string", Name = "prefix", Description = "One to three characters, e.g. !" } },
			Run = function(context, prefix: string)
				if #prefix < 1 or #prefix > 3 or prefix:find("%s") then
					return "The prefix must be 1 to 3 characters without spaces."
				end

				Admin.Config.Chat = Admin.Config.Chat or { Enabled = true, HideCommands = true }
				Admin.Config.Chat.Enabled = true
				Admin.Config.Chat.Prefix = prefix
				if Admin.DataFolder then
					Admin.DataFolder:SetAttribute("ChatPrefix", prefix)
				end

				Admin.Audit(context, `changed the chat prefix to {prefix}`)
				return `Chat commands now start with {prefix}`
			end,
		},
	}
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX66">
<Properties>
<string name="Name">Utility</string>
<ProtectedString name="Source"><![CDATA[--[[
	Utility: teleporting between servers/places and saved positions.
]]

const TeleportService = game:GetService("TeleportService")

return function(Admin)
	const savedPositions: { [Player]: CFrame } = {}

	game:GetService("Players").PlayerRemoving:Connect(function(player)
		savedPositions[player] = nil
	end)

	const function teleportPlayers(players: { Player }, placeId: number, options: TeleportOptions?): string
		local list = {}
		for _, player in ipairs(players) do
			table.insert(list, player)
		end

		if #list == 0 then
			return "Nobody to teleport."
		end

		const ok, err = pcall(TeleportService.TeleportAsync, TeleportService, placeId, list, options)
		if not ok then
			return `Teleport failed: {err}`
		end

		return `Teleporting {Admin.Plural(#list, "player")}...`
	end

	return {
		{
			Name = "rejoin",
			Role = "Moderator",
			Description = "Sends players back into this same server (fixes stuck characters).",
			Args = { { Type = "players", Name = "players", Description = "The players." } },
			Run = function(_, players: { Player })
				const options = Instance.new("TeleportOptions")
				options.ServerInstanceId = game.JobId
				return teleportPlayers(players, game.PlaceId, options)
			end,
		},
		{
			Name = "serverhop",
			Aliases = { "newserver" },
			Role = "Moderator",
			Description = "Sends players to another server of this place.",
			Args = { { Type = "targets", Name = "players", Description = "The players." } },
			Run = function(_, players: { Player })
				return teleportPlayers(players, game.PlaceId, nil)
			end,
		},
		{
			Name = "place",
			Aliases = { "gotoplace" },
			Role = "Admin",
			Description = "Teleports players to another place of this experience.",
			Args = {
				{ Type = "targets", Name = "players", Description = "The players." },
				{ Type = "positiveInteger", Name = "placeId", Description = "The destination place id." },
			},
			Run = function(context, players: { Player }, placeId: number)
				Admin.Audit(context, `sent {Admin.Names(players)} to place {placeId}`)
				return teleportPlayers(players, placeId, nil)
			end,
		},
		{
			Name = "savepos",
			Aliases = { "setpos" },
			Role = "Helper",
			Description = "Remembers where you are standing.",
			Args = {},
			Run = function(context)
				const root = Admin.GetRoot(context.Executor)
				if not root then
					return "You need a character."
				end

				savedPositions[context.Executor] = root.CFrame
				return "Position saved. Use loadpos to return."
			end,
		},
		{
			Name = "loadpos",
			Aliases = { "backpos" },
			Role = "Helper",
			Description = "Teleports you back to the position saved with savepos.",
			Args = {},
			Run = function(context)
				const spot = savedPositions[context.Executor]
				const character = context.Executor.Character
				if not spot then
					return "You have not saved a position yet."
				end

				if not character then
					return "You need a character."
				end

				Admin.Teleport(character, spot)
				return "Teleported to your saved position."
			end,
		},
	}
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX67">
<Properties>
<string name="Name">World</string>
<ProtectedString name="Source"><![CDATA[--[[
	World: messages, lighting, gravity, music, loops and small utilities.
]]

const InsertService = game:GetService("InsertService")
const Lighting = game:GetService("Lighting")
const RunService = game:GetService("RunService")

const MAX_LOOP_RUNS = 100

return function(Admin)
	----------------------------------------------------------------------------------------------------
	-- state
	----------------------------------------------------------------------------------------------------

	const originals = {
		Brightness = Lighting.Brightness,
		ClockTime = Lighting.ClockTime,
		Ambient = Lighting.Ambient,
		OutdoorAmbient = Lighting.OutdoorAmbient,
		FogEnd = Lighting.FogEnd,
		FogStart = Lighting.FogStart,
		FogColor = Lighting.FogColor,
		GlobalShadows = Lighting.GlobalShadows,
		Gravity = workspace.Gravity,
		FallenPartsDestroyHeight = workspace.FallenPartsDestroyHeight,
	}

	const loopKill: { [Player]: boolean } = {}
	const loopHeal: { [Player]: boolean } = {}
	local playerLoopRunning = false
	local timelapseConnection: RBXScriptConnection? = nil
	const activeLoops: { [number]: { Cancelled: boolean } } = {}
	local nextLoopId = 0

	----------------------------------------------------------------------------------------------------
	-- helpers
	----------------------------------------------------------------------------------------------------

	const function describe(count: number, verb: string): string
		return Admin.Result(verb, count)
	end

	const function getSound(): Sound
		local sound = workspace:FindFirstChild("CajMusic")
		if not sound or not sound:IsA("Sound") then
			sound = Instance.new("Sound")
			sound.Name = "CajMusic"
			sound.Looped = true
			sound.Volume = 1
			sound.Parent = workspace
		end

		return sound :: Sound
	end

	const function runPlayerLoop()
		if playerLoopRunning then
			return
		end

		playerLoopRunning = true
		task.spawn(function()
			while next(loopKill) ~= nil or next(loopHeal) ~= nil do
				for player in pairs(loopKill) do
					const humanoid = if player.Parent then Admin.GetHumanoid(player) else nil
					if not player.Parent then
						loopKill[player] = nil
					elseif humanoid and humanoid.Health > 0 then
						humanoid.Health = 0
					end
				end

				for player in pairs(loopHeal) do
					const humanoid = if player.Parent then Admin.GetHumanoid(player) else nil
					if not player.Parent then
						loopHeal[player] = nil
					elseif humanoid and humanoid.Health > 0 then
						humanoid.Health = humanoid.MaxHealth
					end
				end

				task.wait(0.5)
			end

			playerLoopRunning = false
		end)
	end

	const function firstWord(text: string): string
		return (text:match("^%s*(%S+)") or ""):lower()
	end

	const function roll(context: any, text: string): string
		const ready, wait = Admin.Cooldown(`roll{context.Executor.UserId}`, 3)
		if not ready then
			return `Please wait {math.ceil(wait)}s.`
		end

		Admin.NotifyAll(`{context.Executor.Name} {text}`, "info")
		return ""
	end

	Admin.OnGlobal("announce", function(data)
		Admin.Announce(tostring(data.Title or "Announcement"), tostring(data.Text or ""), 10)
	end)

	----------------------------------------------------------------------------------------------------
	-- commands
	----------------------------------------------------------------------------------------------------

	const commands = {}

	const function add(...: any)
		for _, spec in ipairs({ ... }) do
			table.insert(commands, spec)
		end
	end

	-- Messages -------------------------------------------------------------------------------------
	add({
		Name = "announce",
		Aliases = { "m", "message", "shout" },
		Role = "Moderator",
		Description = "Shows a big announcement banner to every player.",
		Args = { { Type = "string", Name = "message", Description = "The announcement." } },
		Run = function(context, message: string)
			Admin.Announce(`Announcement from {context.Executor.DisplayName}`, message, 10)
			return "Announcement sent."
		end,
	}, {
		Name = "globalannounce",
		Aliases = { "gannounce", "gm" },
		Role = "Admin",
		Description = "Shows an announcement banner in EVERY server of this experience.",
		Args = { { Type = "string", Name = "message", Description = "The announcement." } },
		Run = function(context, message: string)
			const data = { Title = `Global announcement from {context.Executor.DisplayName}`, Text = message }
			const ok, err = Admin.PublishGlobal("announce", data)
			if not ok then
				Admin.RunGlobalLocally("announce", data)
				return `Could not reach other servers ({err}). Announced in this server only.`
			end

			return "Announcement sent to all servers."
		end,
	}, {
		Name = "hint",
		Aliases = { "h", "broadcast" },
		Role = "Moderator",
		Description = "Shows a small notification to every player.",
		Args = { { Type = "string", Name = "message", Description = "The message." } },
		Run = function(context, message: string)
			Admin.NotifyAll(`{context.Executor.DisplayName}: {message}`, "info")
			return "Hint sent."
		end,
	}, {
		Name = "notify",
		Role = "Helper",
		Description = "Sends a notification to specific players.",
		Args = {
			{ Type = "players", Name = "players", Description = "Who gets it." },
			{ Type = "string", Name = "message", Description = "The message." },
		},
		Run = function(_, players: { Player }, message: string)
			return describe(
				Admin.EachPlayer(players, function(player)
					Admin.Notify(player, message, "info")
				end),
				"Notified"
			)
		end,
	}, {
		Name = "pm",
		Aliases = { "whisper" },
		Role = "Helper",
		Description = "Sends a private message to players.",
		Args = {
			{ Type = "players", Name = "players", Description = "Who gets it." },
			{ Type = "string", Name = "message", Description = "The message." },
		},
		Run = function(context, players: { Player }, message: string)
			return describe(
				Admin.EachPlayer(players, function(player)
					Admin.Notify(player, `[PM from {context.Executor.DisplayName}] {message}`, "success")
				end),
				"Messaged"
			)
		end,
	}, {
		Name = "countdown",
		Aliases = { "timer" },
		Role = "Moderator",
		Description = "Shows a big countdown to every player.",
		Args = {
			{ Type = "integer", Name = "seconds", Description = "1 to 300." },
			{ Type = "string", Name = "label", Description = "Text shown under the number.", Optional = true },
		},
		Run = function(_, seconds: number, label: string?)
			Admin.FxAll("countdown", math.clamp(seconds, 1, 300), label or "")
			return `Countdown started ({seconds}s).`
		end,
	})

	-- Time and lighting ----------------------------------------------------------------------------
	const function timeCommand(name: string, aliases: { string }?, description: string, hour: number)
		return {
			Name = name,
			Aliases = aliases,
			Role = "Moderator",
			Description = description,
			Args = {},
			Run = function()
				Lighting.ClockTime = hour
				return `Time set to {hour}:00.`
			end,
		}
	end

	add({
		Name = "settime",
		Aliases = { "clocktime" },
		Role = "Moderator",
		Description = "Sets the time of day (0-24).",
		Args = { { Type = "number", Name = "hour", Description = "0-24, e.g. 14.5 = 2:30 PM." } },
		Run = function(_, hour: number)
			Lighting.ClockTime = hour % 24
			return `Time set to {string.format("%.1f", hour % 24)}.`
		end,
	}, timeCommand("day", nil, "Sets the time to 2 PM.", 14), timeCommand("night", nil, "Sets the time to midnight.", 0), timeCommand(
		"dawn",
		{ "sunrise" },
		"Sets the time to 6 AM.",
		6
	), timeCommand("dusk", { "sunset" }, "Sets the time to 6 PM.", 18), {
		Name = "timelapse",
		Role = "Moderator",
		Description = "Makes time pass faster (game hours per second, 0 = stop).",
		Args = { { Type = "number", Name = "speed", Description = "0 to 24." } },
		Run = function(_, speed: number)
			if timelapseConnection then
				timelapseConnection:Disconnect()
				timelapseConnection = nil
			end

			const rate = math.clamp(speed, 0, 24)
			if rate == 0 then
				return "Time lapse stopped."
			end

			timelapseConnection = RunService.Heartbeat:Connect(function(dt)
				Lighting.ClockTime = (Lighting.ClockTime + dt * rate) % 24
			end)

			return `Time is passing at {rate} hours per second.`
		end,
	}, {
		Name = "brightness",
		Role = "Moderator",
		Description = "Sets the brightness of the world.",
		Args = { { Type = "number", Name = "brightness", Description = "0 to 10 (default 2)." } },
		Run = function(_, value: number)
			Lighting.Brightness = math.clamp(value, 0, 10)
			return "Brightness updated."
		end,
	}, {
		Name = "ambient",
		Role = "Moderator",
		Description = "Sets the ambient light color.",
		Args = { { Type = "color3", Name = "color", Description = "e.g. 80,80,255." } },
		Run = function(_, color: Color3)
			Lighting.Ambient = color
			return "Ambient color updated."
		end,
	}, {
		Name = "outdoorambient",
		Role = "Moderator",
		Description = "Sets the outdoor ambient light color.",
		Args = { { Type = "color3", Name = "color", Description = "e.g. 80,80,255." } },
		Run = function(_, color: Color3)
			Lighting.OutdoorAmbient = color
			return "Outdoor ambient color updated."
		end,
	}, {
		Name = "fog",
		Role = "Moderator",
		Description = "Adds fog that fades out at the given distance.",
		Args = {
			{ Type = "positiveNumber", Name = "end", Description = "Where the fog is fully thick." },
			{ Type = "number", Name = "start", Description = "Where the fog begins (default 0).", Optional = true },
		},
		Run = function(_, fogEnd: number, fogStart: number?)
			Lighting.FogEnd = fogEnd
			Lighting.FogStart = math.clamp(fogStart or 0, 0, fogEnd)
			return "Fog enabled."
		end,
	}, {
		Name = "nofog",
		Role = "Moderator",
		Description = "Removes the fog.",
		Args = {},
		Run = function()
			Lighting.FogEnd = 100000
			Lighting.FogStart = 0
			return "Fog removed."
		end,
	}, {
		Name = "fogcolor",
		Role = "Moderator",
		Description = "Sets the fog color.",
		Args = { { Type = "color3", Name = "color", Description = "e.g. 200,200,220." } },
		Run = function(_, color: Color3)
			Lighting.FogColor = color
			return "Fog color updated."
		end,
	}, {
		Name = "shadows",
		Role = "Moderator",
		Description = "Turns global shadows on or off.",
		Args = { { Type = "boolean", Name = "enabled", Description = "true or false." } },
		Run = function(_, enabled: boolean)
			Lighting.GlobalShadows = enabled
			return `Shadows {if enabled then "enabled" else "disabled"}.`
		end,
	}, {
		Name = "resetlighting",
		Aliases = { "resetworld" },
		Role = "Moderator",
		Description = "Restores the lighting, gravity and fall height from when the server started.",
		Args = {},
		Run = function()
			if timelapseConnection then
				timelapseConnection:Disconnect()
				timelapseConnection = nil
			end

			for property, value in pairs(originals) do
				if property == "Gravity" or property == "FallenPartsDestroyHeight" then
					(workspace :: any)[property] = value
				else
					(Lighting :: any)[property] = value
				end
			end

			return "Lighting and physics restored."
		end,
	}, {
		Name = "gravity",
		Role = "Admin",
		Description = "Sets the world gravity (default 196.2).",
		Args = { { Type = "number", Name = "gravity", Description = "0 = floaty, 196.2 = normal." } },
		Run = function(_, value: number)
			workspace.Gravity = math.clamp(value, 0, 1000)
			return `Gravity set to {workspace.Gravity}.`
		end,
	}, {
		Name = "fallheight",
		Role = "Admin",
		Description = "Sets the height below which things are destroyed (void kill height).",
		Args = { { Type = "number", Name = "height", Description = "Y position, e.g. -500." } },
		Run = function(_, value: number)
			workspace.FallenPartsDestroyHeight = value
			return `Fall height set to {value}.`
		end,
	})

	-- Music ----------------------------------------------------------------------------------------
	add({
		Name = "music",
		Aliases = { "play" },
		Role = "Moderator",
		Description = "Plays a sound or song for everyone (audio asset id).",
		Args = { { Type = "positiveInteger", Name = "assetId", Description = "Audio asset id." } },
		Run = function(_, assetId: number)
			const sound = getSound()
			sound:Stop()
			sound.SoundId = `rbxassetid://{assetId}`
			sound:Play()
			return `Playing {assetId}.`
		end,
	}, {
		Name = "stopmusic",
		Aliases = { "stop" },
		Role = "Moderator",
		Description = "Stops the music.",
		Args = {},
		Run = function()
			getSound():Stop()
			return "Music stopped."
		end,
	}, {
		Name = "pausemusic",
		Aliases = { "pause" },
		Role = "Moderator",
		Description = "Pauses the music.",
		Args = {},
		Run = function()
			getSound():Pause()
			return "Music paused."
		end,
	}, {
		Name = "resumemusic",
		Aliases = { "resume" },
		Role = "Moderator",
		Description = "Resumes the music.",
		Args = {},
		Run = function()
			getSound():Resume()
			return "Music resumed."
		end,
	}, {
		Name = "volume",
		Role = "Moderator",
		Description = "Sets the music volume.",
		Args = { { Type = "number", Name = "volume", Description = "0 to 10 (default 1)." } },
		Run = function(_, value: number)
			getSound().Volume = math.clamp(value, 0, 10)
			return "Volume updated."
		end,
	}, {
		Name = "pitch",
		Aliases = { "musicspeed" },
		Role = "Moderator",
		Description = "Changes how fast the music plays.",
		Args = { { Type = "positiveNumber", Name = "speed", Description = "0.1 to 5 (default 1)." } },
		Run = function(_, value: number)
			getSound().PlaybackSpeed = math.clamp(value, 0.1, 5)
			return "Playback speed updated."
		end,
	})

	-- Cleanup and loading --------------------------------------------------------------------------
	add({
		Name = "cleanup",
		Aliases = { "clean" },
		Role = "Moderator",
		Description = "Removes dropped tools, hats and everything spawned by commands (cages, clones, ...).",
		Args = {},
		Run = function()
			local count = 0
			for _, child in ipairs(workspace:GetChildren()) do
				if child:IsA("Tool") or child:IsA("Accessory") or child:IsA("Hat") then
					child:Destroy()
					count += 1
				end
			end

			const objects = Admin.GetObjectsFolder()
			count += #objects:GetChildren()
			objects:ClearAllChildren()

			return `Removed {count} objects.`
		end,
	}, {
		Name = "insert",
		Role = "Owner",
		Description = "Loads a model from the catalog next to you. Disabled by default (see Config).",
		Args = { { Type = "positiveInteger", Name = "assetId", Description = "Model asset id." } },
		Run = function(context, assetId: number)
			const ok, model = pcall(InsertService.LoadAsset, InsertService, assetId)
			if not ok then
				return `Could not load that asset: {model}`
			end

			const root = Admin.GetRoot(context.Executor)
			model.Name = `Inserted {assetId}`
			if root then
				model:PivotTo(root.CFrame * CFrame.new(0, 0, -12))
			end
			model.Parent = Admin.GetObjectsFolder()

			Admin.Audit(context, `inserted asset {assetId}`)
			return `Inserted asset {assetId}.`
		end,
	})

	-- Loops ----------------------------------------------------------------------------------------
	add({
		Name = "loopkill",
		Role = "Admin",
		Description = "Kills players over and over (until unloopkill).",
		Args = { { Type = "targets", Name = "players", Description = "The players." } },
		Run = function(_, players: { Player })
			const count = Admin.EachPlayer(players, function(player)
				loopKill[player] = true
			end)
			runPlayerLoop()
			return describe(count, "Loop-killing")
		end,
	}, {
		Name = "unloopkill",
		Role = "Admin",
		Description = "Stops loop-killing players.",
		Args = { { Type = "players", Name = "players", Description = "The players." } },
		Run = function(_, players: { Player })
			return describe(
				Admin.EachPlayer(players, function(player)
					loopKill[player] = nil
				end),
				"Stopped loop-killing"
			)
		end,
	}, {
		Name = "loopheal",
		Role = "Moderator",
		Description = "Keeps players at full health (until unloopheal).",
		Args = { { Type = "players", Name = "players", Description = "The players." } },
		Run = function(_, players: { Player })
			const count = Admin.EachPlayer(players, function(player)
				loopHeal[player] = true
			end)
			runPlayerLoop()
			return describe(count, "Loop-healing")
		end,
	}, {
		Name = "unloopheal",
		Role = "Moderator",
		Description = "Stops loop-healing players.",
		Args = { { Type = "players", Name = "players", Description = "The players." } },
		Run = function(_, players: { Player })
			return describe(
				Admin.EachPlayer(players, function(player)
					loopHeal[player] = nil
				end),
				"Stopped loop-healing"
			)
		end,
	}, {
		Name = "loop",
		Aliases = { "repeat" },
		Role = "Admin",
		Description = "Runs a command several times, e.g.  loop 5 2 announce hello",
		Args = {
			{ Type = "integer", Name = "times", Description = `1 to {MAX_LOOP_RUNS}.` },
			{ Type = "number", Name = "delay", Description = "Seconds between runs (min 0.1)." },
			{ Type = "string", Name = "command", Description = "The command to repeat." },
		},
		Run = function(context, times: number, delay: number, commandText: string)
			if firstWord(commandText) == "loop" or firstWord(commandText) == "repeat" or firstWord(commandText) == "delay" then
				return "You cannot nest loops."
			end

			const runs = math.clamp(times, 1, MAX_LOOP_RUNS)
			const wait = math.max(delay, 0.1)
			const executor = context.Executor

			nextLoopId += 1
			const id = nextLoopId
			const token = { Cancelled = false }
			activeLoops[id] = token

			task.spawn(function()
				for _ = 1, runs do
					if token.Cancelled or not executor.Parent then
						break
					end

					Admin.Run(commandText, executor)
					task.wait(wait)
				end

				activeLoops[id] = nil
			end)

			return `Running "{commandText}" {runs} times. Use stoploops to cancel.`
		end,
	}, {
		Name = "delay",
		Aliases = { "later" },
		Role = "Admin",
		Description = "Runs a command after a delay, e.g.  delay 30 shutdown",
		Args = {
			{ Type = "number", Name = "seconds", Description = "Up to 3600." },
			{ Type = "string", Name = "command", Description = "The command to run later." },
		},
		Run = function(context, seconds: number, commandText: string)
			if firstWord(commandText) == "loop" or firstWord(commandText) == "repeat" or firstWord(commandText) == "delay" then
				return "You cannot nest delayed commands."
			end

			const executor = context.Executor
			nextLoopId += 1
			const id = nextLoopId
			const token = { Cancelled = false }
			activeLoops[id] = token

			task.delay(math.clamp(seconds, 0, 3600), function()
				activeLoops[id] = nil
				if not token.Cancelled and executor.Parent then
					Admin.Run(commandText, executor)
				end
			end)

			return `Will run "{commandText}" in {Admin.FormatDuration(seconds)}. Use stoploops to cancel.`
		end,
	}, {
		Name = "stoploops",
		Aliases = { "cancelloops" },
		Role = "Admin",
		Description = "Cancels every running loop and delayed command (including loopkill/loopheal).",
		Args = {},
		Run = function()
			local count = 0
			for id, token in pairs(activeLoops) do
				token.Cancelled = true
				activeLoops[id] = nil
				count += 1
			end

			table.clear(loopKill)
			table.clear(loopHeal)
			return `Cancelled {count} loops.`
		end,
	})

	-- Randomizers (open to everyone) ---------------------------------------------------------------
	add({
		Name = "random",
		Aliases = { "rng" },
		Role = "Player",
		Description = "Picks a random number and shows it to everyone.",
		Args = {
			{ Type = "integer", Name = "min", Description = "Lowest number." },
			{ Type = "integer", Name = "max", Description = "Highest number." },
		},
		Run = function(context, minimum: number, maximum: number)
			if maximum < minimum then
				minimum, maximum = maximum, minimum
			end

			return roll(context, `picked {math.random(minimum, maximum)} (random {minimum}-{maximum})`)
		end,
	}, {
		Name = "roll",
		Aliases = { "dice" },
		Role = "Player",
		Description = "Rolls a dice and shows the result to everyone.",
		Args = { { Type = "integer", Name = "sides", Description = "Default 6.", Optional = true } },
		Run = function(context, sides: number?)
			const count = math.clamp(sides or 6, 2, 1000000)
			return roll(context, `rolled a {math.random(1, count)} (d{count})`)
		end,
	}, {
		Name = "coinflip",
		Aliases = { "flip" },
		Role = "Player",
		Description = "Flips a coin and shows the result to everyone.",
		Args = {},
		Run = function(context)
			return roll(context, `flipped a coin: {if math.random(1, 2) == 1 then "heads" else "tails"}`)
		end,
	})

	return commands
end
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="ModuleScript" referent="RBX69">
<Properties>
<string name="Name">Config</string>
<ProtectedString name="Source"><![CDATA[--[[
	CajCMDR - CONFIG
	================
	This is the only file most developers ever need to touch.

	QUICK START
	  1. Put your Roblox community (group) id in the `Groups` table below and map your community's
	     rank ids to the roles you want them to receive (Owner, Admin, Moderator, ...).
	  2. Put your own UserId in `Users` if you want to be staff even when you are not in the community.
	  3. Publish and play. Press F2 (or the ` key) to open the console, or type ;cmds in chat.

	Find a community id:  roblox.com/communities/<THIS NUMBER>/name
	Find a rank id:       Community > Configure > Roles > the "Rank" number next to each role (1-255).
]]

return {
	----------------------------------------------------------------------------------------------------
	-- 1. ROLES
	-- Higher `Level` = more power. Anyone can use commands of their own level and below.
	-- You can rename roles, change levels/colours, add roles or remove roles. Keep one role at Level 0.
	-- Role names are used everywhere else in this file, so spell them exactly the same.
	----------------------------------------------------------------------------------------------------
	Roles = {
		{ Name = "Player", Level = 0, Color = Color3.fromRGB(190, 190, 190) },
		{ Name = "Helper", Level = 25, Color = Color3.fromRGB(110, 220, 140) },
		{ Name = "Moderator", Level = 50, Color = Color3.fromRGB(80, 170, 255) },
		{ Name = "Admin", Level = 75, Color = Color3.fromRGB(255, 170, 60) },
		{ Name = "HeadAdmin", Level = 90, Color = Color3.fromRGB(255, 100, 100) },
		{ Name = "Owner", Level = 100, Color = Color3.fromRGB(255, 215, 0) },
	},

	----------------------------------------------------------------------------------------------------
	-- 2. COMMUNITY (GROUP) BINDINGS   <-- the part you probably came here for
	--
	-- Format:   [communityId] = { [rankId] = "RoleName", ... }
	--
	-- * The key on the left is the rank id (0-255) from your community's role list.
	--   You can also use the exact role *name* in quotes instead:  ["Head Moderator"] = "Moderator"
	-- * With GroupRankMatching = "AtOrAbove" (default) a member whose rank is 150 or higher gets the
	--   role bound to 150 (as long as no higher binding also matches), so you only list the ranks
	--   that matter. Use "Exact" if only that exact rank should receive the role.
	-- * You can bind as many communities as you like. The highest role a player qualifies for wins.
	-- * Entries with community id 0 are ignored, so the example below does nothing until you edit it.
	----------------------------------------------------------------------------------------------------
	Groups = {
		[0] = { -- <-- replace 0 with your community id, e.g. [1234567] = { ... }
			[255] = "Owner",
			[254] = "HeadAdmin",
			[200] = "Admin",
			[150] = "Moderator",
			[100] = "Helper",
		},

		-- A second community, uncomment and edit to use:
		-- [7654321] = {
		-- 	[255] = "Owner",
		-- 	[50] = "Helper",
		-- },
	},
	GroupRankMatching = "AtOrAbove", -- "AtOrAbove" or "Exact"

	----------------------------------------------------------------------------------------------------
	-- 3. OTHER WAYS TO GET A ROLE
	----------------------------------------------------------------------------------------------------

	-- Specific people by UserId. Great for yourself and trusted friends.
	Users = {
		-- [123456789] = "Owner", -- YourUsername
	},

	-- Own a game pass -> get a role. [GamePassId] = "RoleName"
	GamePasses = {
		-- [11111111] = "Helper",
	},

	-- The experience creator (or the owner of the community that owns the experience) gets this role.
	-- Set to nil / false to turn it off.
	GameOwnerRole = "Owner",

	-- Everyone gets this role while testing in Roblox Studio so you can try every command.
	-- Set to nil / false before publishing if you want Studio to behave like a live server.
	StudioRole = "Owner",

	-- How often (in seconds) community ranks are re-checked for players already in the server.
	-- Players can also be refreshed instantly with the `refreshroles` command.
	RoleRefreshSeconds = 300,

	----------------------------------------------------------------------------------------------------
	-- 4. COMMAND PERMISSIONS
	-- Every command has a default role. Override them here: ["commandName"] = "RoleName".
	----------------------------------------------------------------------------------------------------
	CommandRoles = {
		-- kick = "Helper",
		-- fly = "Admin",
	},

	-- Commands that should not exist at all in your game.
	DisabledCommands = {
		"insert", -- loads free models from the catalog; enable only if you really want it
	},

	-- Whole categories you do not want: "Info", "Moderation", "Character", "Fun", "World", "Client",
	-- "Staff", "Utility"
	DisabledCategories = {},

	-- Roles for Cmdr's built-in command groups (help, alias, bind, ...).
	DefaultGroupRoles = {
		DefaultUtil = "Player",
		Help = "Player",
		UserAlias = "Player",
	},

	-- Players cannot use harmful commands on players of an equal or higher role (the top role may target anyone).
	ProtectHigherRanks = true,

	----------------------------------------------------------------------------------------------------
	-- 5. INTERFACE
	----------------------------------------------------------------------------------------------------
	PlaceName = "CajCMDR", -- shown in the console prompt
	ConsoleKeys = { "F2", "Backquote" }, -- Enum.KeyCode names that open the console

	Chat = {
		Enabled = true, -- allow running commands from chat, e.g.  ;kill me
		Prefix = ";",
		HideCommands = true, -- do not show staff command messages in the public chat
	},

	----------------------------------------------------------------------------------------------------
	-- 6. MODERATION
	----------------------------------------------------------------------------------------------------
	Bans = {
		ApplyToUniverse = true, -- ban from every place in the experience
		ExcludeAltAccounts = false, -- true = do not also ban alt accounts
	},

	Warnings = {
		AutoKickAt = 0, -- kick a player automatically when they reach this many warnings (0 = off)
	},

	ReportCooldown = 60, -- seconds between `report` uses per player

	----------------------------------------------------------------------------------------------------
	-- 7. TOOLS
	-- Put Tool objects in ServerStorage > AdminTools and staff can hand them out with `give`.
	----------------------------------------------------------------------------------------------------
	ToolsFolder = "AdminTools",

	----------------------------------------------------------------------------------------------------
	-- 8. LOGGING
	-- Optional webhook. Discord blocks Roblox servers, so use a relay/proxy url that forwards to Discord.
	----------------------------------------------------------------------------------------------------
	Webhook = {
		Enabled = false,
		Url = "",
		MinLevel = 25, -- only commands run by staff of this level or higher are sent
	},
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="Folder" referent="RBX70">
<Properties>
<string name="Name">Core</string>
</Properties>
<Item class="ModuleScript" referent="RBX6A">
<Properties>
<string name="Name">Admin</string>
<ProtectedString name="Source"><![CDATA[--[[
	Helper API shared by every command module.  Command files receive this table as their only argument:

		return function(Admin)
			return {
				{ Name = "example", Role = "Moderator", Description = "...", Args = { ... }, Run = function(context, ...) end },
			}
		end
]]

const HttpService = game:GetService("HttpService")
const MessagingService = game:GetService("MessagingService")
const Players = game:GetService("Players")
const ServerStorage = game:GetService("ServerStorage")

const GLOBAL_TOPIC = "CajAdminGlobal"

const Admin = {
	Version = "1.0.0",

	Colors = {
		Header = Color3.fromRGB(230, 126, 34),
		Good = Color3.fromRGB(120, 220, 130),
		Warn = Color3.fromRGB(255, 228, 26),
		Bad = Color3.fromRGB(255, 110, 110),
		Dim = Color3.fromRGB(170, 170, 170),
	},

	-- Filled in by Admin.Init
	Cmdr = nil :: any,
	Config = nil :: any,
	Roles = nil :: any,
	Store = nil :: any,
	Log = nil :: any,
	Chat = nil :: any,
	Specs = {} :: { [string]: any }, -- lower-case command name -> { Name, Role, Category, Audit }
	CommandLevels = {} :: { [string]: number }, -- lower-case command name -> level required (-1 = disabled)
	DataFolder = nil :: Folder?, -- ReplicatedStorage.CajAdminData

	-- Server-wide state shared by several commands
	StartTime = os.time(),
	ServerLock = { Level = 0, Reason = "" },
	ServerBans = {} :: { [number]: string }, -- UserId -> reason (this server only)
}

local objectsFolder: Folder? = nil
const states: { [Player]: { [string]: (Player, Model, Humanoid) -> () } } = {}
const globalHandlers: { [string]: (any, string) -> () } = {}
const cooldowns: { [string]: number } = {}
const nameCache: { [number]: string } = {}

function Admin.Init(env: any)
	Admin.Cmdr = env.Cmdr
	Admin.Config = env.Config
	Admin.Roles = env.Roles
	Admin.Store = env.Store
	Admin.Log = env.Log
	Admin.Chat = env.Chat
	Admin.DataFolder = env.DataFolder
end

--[[ Pushes Admin.CommandLevels to the clients and the permission hooks. Call after changing it. ]]
function Admin.PublishCommandLevels()
	if Admin.DataFolder then
		Admin.DataFolder:SetAttribute("CommandLevels", HttpService:JSONEncode(Admin.CommandLevels))
	end
end

----------------------------------------------------------------------------------------------------
-- Messaging the client
----------------------------------------------------------------------------------------------------

--[[ kind: "info" | "success" | "warn" | "error" ]]
function Admin.Notify(player: Player, text: string, kind: string?)
	Admin.Cmdr.Dispatcher:SendEvent(player, "CajNotify", tostring(text), kind or "info")
end

function Admin.NotifyAll(text: string, kind: string?)
	Admin.Cmdr.Dispatcher:BroadcastEvent("CajNotify", tostring(text), kind or "info")
end

function Admin.NotifyStaff(text: string, kind: string?, minLevel: number?)
	for _, player in ipairs(Players:GetPlayers()) do
		if Admin.Roles.GetLevel(player) >= (minLevel or 1) then
			Admin.Notify(player, text, kind)
		end
	end
end

function Admin.Announce(title: string, text: string, duration: number?)
	Admin.Cmdr.Dispatcher:BroadcastEvent("CajAnnounce", title, text, duration or 8)
end

--[[ Runs a client-side effect (fly, noclip, fov, ...) on one player. See CajAdminClient/Effects. ]]
function Admin.Fx(player: Player, effect: string, ...: any)
	Admin.Cmdr.Dispatcher:SendEvent(player, "CajFx", effect, ...)
end

function Admin.FxAll(effect: string, ...: any)
	Admin.Cmdr.Dispatcher:BroadcastEvent("CajFx", effect, ...)
end

function Admin.Reply(context: any, text: string, color: Color3?)
	context:Reply(text, color)
end

--[[ Prints a titled list to the executor's console and returns "" so the command shows no extra line. ]]
function Admin.Output(context: any, title: string, lines: { string }, maxLines: number?): string
	context:Reply(title, Admin.Colors.Header)

	const limit = maxLines or 80
	for index, line in ipairs(lines) do
		if index > limit then
			context:Reply(`... and {#lines - limit} more`, Admin.Colors.Dim)
			break
		end

		context:Reply(line)
	end

	if #lines == 0 then
		context:Reply("(nothing to show)", Admin.Colors.Dim)
	end

	return ""
end

----------------------------------------------------------------------------------------------------
-- Formatting
----------------------------------------------------------------------------------------------------

function Admin.FormatDuration(seconds: number): string
	if seconds == math.huge then
		return "forever"
	end

	seconds = math.floor(seconds)
	if seconds < 1 then
		return "0s"
	end

	const parts = {}
	for _, unit in ipairs({ { "d", 86400 }, { "h", 3600 }, { "m", 60 }, { "s", 1 } }) do
		const count = math.floor(seconds / unit[2])
		if count > 0 then
			table.insert(parts, `{count}{unit[1]}`)
			seconds -= count * unit[2]
		end
	end

	return table.concat(parts, " ")
end

function Admin.Plural(count: number, word: string): string
	return `{count} {word}{if count == 1 then "" else "s"}`
end

function Admin.Result(verb: string, count: number): string
	if count == 0 then
		return "No players were affected."
	end

	return `{verb} {Admin.Plural(count, "player")}.`
end

function Admin.Names(players: { Player }, limit: number?): string
	const names = {}
	const max = limit or 5
	for index, player in ipairs(players) do
		if index > max then
			table.insert(names, `+{#players - max} more`)
			break
		end

		table.insert(names, player.Name)
	end

	return table.concat(names, ", ")
end

function Admin.Timestamp(unixTime: number): string
	return os.date("!%Y-%m-%d %H:%M UTC", unixTime) :: string
end

function Admin.Truncate(text: string, length: number): string
	if #text <= length then
		return text
	end

	return `{text:sub(1, length - 3)}...`
end

--[[ Returns false (and the seconds left) when `key` was used less than `seconds` ago. ]]
function Admin.Cooldown(key: string, seconds: number): (boolean, number)
	const now = os.clock()
	const last = cooldowns[key]
	if last and now - last < seconds then
		return false, seconds - (now - last)
	end

	cooldowns[key] = now
	return true, 0
end

function Admin.NameFromUserId(userId: number): string
	const online = Players:GetPlayerByUserId(userId)
	if online then
		return online.Name
	end

	if nameCache[userId] then
		return nameCache[userId]
	end

	const ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	if ok then
		nameCache[userId] = name
		return name
	end

	return `User{userId}`
end

----------------------------------------------------------------------------------------------------
-- Characters
----------------------------------------------------------------------------------------------------

function Admin.GetHumanoid(player: Player): Humanoid?
	const character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

function Admin.GetRoot(player: Player): BasePart?
	const character = player.Character
	return character and (character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart) :: BasePart?
end

--[[
	Calls fn(player, character, humanoid, root) for every player that currently has a living-capable character.
	Errors inside fn are caught. Returns how many players were handled (fn can return false to not count one).
]]
function Admin.Each(players: { Player }, fn: (Player, Model, Humanoid, BasePart) -> any?): number
	local count = 0

	for _, player in ipairs(players) do
		const character = player.Character
		const humanoid = character and character:FindFirstChildOfClass("Humanoid")
		const root = character and character:FindFirstChild("HumanoidRootPart")

		if humanoid and root then
			const ok, result = pcall(fn, player, character, humanoid, root)
			if not ok then
				warn(`[CajAdmin] Command error for {player.Name}: {result}`)
			elseif result ~= false then
				count += 1
			end
		end
	end

	return count
end

--[[ Same as Each but for commands that do not need a character. ]]
function Admin.EachPlayer(players: { Player }, fn: (Player) -> any?): number
	local count = 0

	for _, player in ipairs(players) do
		const ok, result = pcall(fn, player)
		if not ok then
			warn(`[CajAdmin] Command error for {player.Name}: {result}`)
		elseif result ~= false then
			count += 1
		end
	end

	return count
end

function Admin.Teleport(character: Model, cframe: CFrame)
	const humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Sit then
		humanoid.Sit = false

		const deadline = os.clock() + 1
		while humanoid.SeatPart and os.clock() < deadline do
			task.wait()
		end
	end

	if character:IsDescendantOf(workspace) then
		character:PivotTo(cframe)
	end
end

--[[ Adds (replacing any old copy) an effect instance named `name` to a body part of the character. ]]
function Admin.AddEffect(character: Model, className: string, name: string, properties: { [string]: any }?, partName: string?): Instance?
	const parent = character:FindFirstChild(partName or "HumanoidRootPart")
	if not parent then
		return nil
	end

	const existing = parent:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end

	const instance = Instance.new(className)
	instance.Name = name
	for key, value in pairs(properties or {}) do
		(instance :: any)[key] = value
	end
	instance.Parent = parent

	return instance
end

--[[ Removes every descendant of the character with this name. Returns how many were removed. ]]
function Admin.RemoveEffect(character: Model, name: string): number
	local count = 0
	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant.Name == name then
			descendant:Destroy()
			count += 1
		end
	end

	return count
end

--[[ Sets the transparency of the whole avatar. Pass nil to restore the original look. ]]
function Admin.SetTransparency(character: Model, value: number?)
	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant.Name == "HumanoidRootPart" then
			continue
		end

		if descendant:IsA("BasePart") or descendant:IsA("Decal") then
			if value == nil then
				const original = descendant:GetAttribute("CajOrigT")
				if original ~= nil then
					descendant.Transparency = original
					descendant:SetAttribute("CajOrigT", nil)
				end
			else
				if descendant:GetAttribute("CajOrigT") == nil then
					descendant:SetAttribute("CajOrigT", descendant.Transparency)
				end
				descendant.Transparency = value
			end
		end
	end
end

--[[ Resizes an R15 avatar. 1 = normal. Returns false for R6 avatars. ]]
function Admin.SetScale(humanoid: Humanoid, height: number?, width: number?, head: number?): boolean
	const heightValue = humanoid:FindFirstChild("BodyHeightScale")
	if not heightValue then
		return false
	end

	const function set(name: string, value: number?)
		const object = humanoid:FindFirstChild(name)
		if object and value and object:IsA("NumberValue") then
			object.Value = math.clamp(value, 0.1, 12)
		end
	end

	set("BodyHeightScale", height)
	set("BodyWidthScale", width)
	set("BodyDepthScale", width)
	set("HeadScale", head)

	return true
end

----------------------------------------------------------------------------------------------------
-- Effects that should survive respawning (god mode, speed, ...)
----------------------------------------------------------------------------------------------------

function Admin.SetState(player: Player, key: string, apply: (Player, Model, Humanoid) -> ())
	if not states[player] then
		states[player] = {}
	end
	states[player][key] = apply

	const character = player.Character
	const humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if character and humanoid then
		pcall(apply, player, character, humanoid)
	end
end

function Admin.ClearState(player: Player, key: string)
	if states[player] then
		states[player][key] = nil
	end
end

function Admin.ClearStates(player: Player)
	states[player] = nil
end

const function onCharacterAdded(player: Player, character: Model)
	const humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid then
		return
	end

	character:WaitForChild("HumanoidRootPart", 10)
	task.wait()

	const applied = states[player]
	if not applied then
		return
	end

	for _, apply in pairs(applied) do
		pcall(apply, player, character, humanoid)
	end
end

----------------------------------------------------------------------------------------------------
-- Tools
----------------------------------------------------------------------------------------------------

function Admin.GetToolsFolder(): Instance?
	return ServerStorage:FindFirstChild(Admin.Config.ToolsFolder or "AdminTools")
end

function Admin.ListTools(): { Tool }
	const folder = Admin.GetToolsFolder()
	const tools = {}
	if folder then
		for _, child in ipairs(folder:GetChildren()) do
			if child:IsA("Tool") then
				table.insert(tools, child)
			end
		end
	end

	return tools
end

function Admin.FindTool(name: string): Tool?
	const lowered = name:lower()
	local partial: Tool? = nil

	for _, tool in ipairs(Admin.ListTools()) do
		if tool.Name:lower() == lowered then
			return tool
		elseif not partial and tool.Name:lower():find(lowered, 1, true) then
			partial = tool
		end
	end

	return partial
end

----------------------------------------------------------------------------------------------------
-- World objects created by commands (cages, clones, ...)
----------------------------------------------------------------------------------------------------

function Admin.GetObjectsFolder(): Folder
	if not objectsFolder or not objectsFolder.Parent then
		const folder = Instance.new("Folder")
		folder.Name = "CajAdminObjects"
		folder.Parent = workspace
		objectsFolder = folder
	end

	return objectsFolder :: Folder
end

----------------------------------------------------------------------------------------------------
-- Running other commands / logging
----------------------------------------------------------------------------------------------------

function Admin.Run(commandText: string, executor: Player): string
	return Admin.Cmdr.Dispatcher:EvaluateAndRun(commandText, executor)
end

--[[ Records a moderation action in the persistent audit log (viewable with `auditlog`). ]]
function Admin.Audit(context: any, details: string)
	Admin.Log.Audit({
		Time = os.time(),
		Executor = context.Executor.Name,
		UserId = context.Executor.UserId,
		Text = context.RawText,
		Response = details,
	})

	Admin.NotifyStaff(`{context.Executor.Name}: {details}`, "info", Admin.Roles.Get("Moderator") and Admin.Roles.Get("Moderator").Level or 1)
end

--[[ True when `executor` is allowed to act on an offline/online user id. Yields. ]]
function Admin.CanAffectUserId(executor: Player, userId: number): boolean
	if executor.UserId == userId then
		return true
	end

	if Admin.Config.ProtectHigherRanks == false then
		return true
	end

	const executorLevel = Admin.Roles.GetLevel(executor)
	if executorLevel >= Admin.Roles.MaxLevel then
		return true
	end

	return executorLevel > Admin.Roles.GetLevelForUserId(userId)
end

----------------------------------------------------------------------------------------------------
-- Cross-server messaging
----------------------------------------------------------------------------------------------------

function Admin.OnGlobal(kind: string, handler: (any, string) -> ())
	globalHandlers[kind] = handler
end

--[[ Returns ok, errorMessage. Handlers also run on the sending server (delivered through MessagingService). ]]
function Admin.PublishGlobal(kind: string, data: any): (boolean, string?)
	const ok, err = pcall(function()
		MessagingService:PublishAsync(GLOBAL_TOPIC, HttpService:JSONEncode({ Kind = kind, Data = data, JobId = game.JobId }))
	end)

	return ok, if ok then nil else tostring(err)
end

--[[ Runs the handler directly on this server (used when MessagingService is unavailable, e.g. in Studio). ]]
function Admin.RunGlobalLocally(kind: string, data: any)
	const handler = globalHandlers[kind]
	if handler then
		handler(data, game.JobId)
	end
end

function Admin.Start()
	const function track(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacterAdded(player, character)
		end)
	end

	Players.PlayerAdded:Connect(track)
	for _, player in ipairs(Players:GetPlayers()) do
		track(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
	end)

	task.spawn(function()
		pcall(function()
			MessagingService:SubscribeAsync(GLOBAL_TOPIC, function(message)
				const ok, payload = pcall(HttpService.JSONDecode, HttpService, message.Data)
				if not ok or type(payload) ~= "table" then
					return
				end

				const handler = globalHandlers[payload.Kind]
				if handler then
					handler(payload.Data, payload.JobId)
				end
			end)
		end)
	end)
end

return Admin
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX6B">
<Properties>
<string name="Name">Chat</string>
<ProtectedString name="Source"><![CDATA[--[[
	Chat integration:
	  * runs commands typed in chat (";kill me")
	  * enforces mutes, chat lock and slow mode
	  * keeps the chat log used by the `chatlogs` command

	With TextChatService, TextChannel.ShouldDeliverCallback is called once per recipient, so every decision
	is cached by MessageId and only evaluated for the first recipient.
]]

const Players = game:GetService("Players")
const TextChatService = game:GetService("TextChatService")

const MAX_CACHED_DECISIONS = 400

const Chat = {
	Muted = {} :: { [number]: { Until: number, Reason: string } },
	LockLevel = 0, -- players below this level cannot chat
	SlowSeconds = 0,
}

local env: any = nil
const decisions: { [string]: boolean } = {}
const decisionOrder: { string } = {}
const lastMessageTime: { [number]: number } = {}

----------------------------------------------------------------------------------------------------
-- Mute helpers
----------------------------------------------------------------------------------------------------

function Chat.Mute(userId: number, duration: number?, reason: string?)
	Chat.Muted[userId] = {
		Until = if duration and duration > 0 then os.time() + duration else math.huge,
		Reason = reason or "No reason given",
	}
end

function Chat.Unmute(userId: number): boolean
	const wasMuted = Chat.Muted[userId] ~= nil
	Chat.Muted[userId] = nil
	return wasMuted
end

--[[ Returns isMuted, reason, secondsRemaining (math.huge when permanent). ]]
function Chat.IsMuted(userId: number): (boolean, string?, number)
	const entry = Chat.Muted[userId]
	if not entry then
		return false, nil, 0
	end

	if entry.Until ~= math.huge and os.time() >= entry.Until then
		Chat.Muted[userId] = nil
		return false, nil, 0
	end

	return true, entry.Reason, entry.Until - os.time()
end

----------------------------------------------------------------------------------------------------
-- Chat commands
----------------------------------------------------------------------------------------------------

const function runChatCommand(player: Player, commandLine: string)
	if env.Roles.GetLevel(player) <= 0 then
		return
	end

	for _, part in ipairs(commandLine:split(" && ")) do
		const trimmed = part:match("^%s*(.-)%s*$")
		if trimmed and trimmed ~= "" then
			const response = env.Cmdr.Dispatcher:EvaluateAndRun(trimmed, player)
			if response and response ~= "" and response ~= "Command executed." then
				env.Admin.Notify(player, response, "info")
			end
		end
	end
end

const function tryChatCommand(player: Player, text: string): boolean
	const chatConfig = env.Config.Chat
	if not (chatConfig and chatConfig.Enabled) then
		return false
	end

	const prefix = chatConfig.Prefix or ";"
	if text:sub(1, #prefix) ~= prefix or #text == #prefix then
		return false
	end

	if env.Roles.GetLevel(player) <= 0 then
		return false
	end

	task.spawn(runChatCommand, player, text:sub(#prefix + 1))
	return true
end

----------------------------------------------------------------------------------------------------
-- Delivery callback (TextChatService)
----------------------------------------------------------------------------------------------------

const function evaluate(message: TextChatMessage, source: TextSource): boolean
	const player = Players:GetPlayerByUserId(source.UserId)
	if not player then
		return true
	end

	const level = env.Roles.GetLevel(player)

	env.Log.Chat({ Time = os.time(), Player = player.Name, UserId = player.UserId, Text = message.Text })

	-- Staff commands: run them and keep them out of public chat.
	if tryChatCommand(player, message.Text) then
		return not (env.Config.Chat and env.Config.Chat.HideCommands)
	end

	const muted, reason, remaining = Chat.IsMuted(player.UserId)
	if muted then
		const when = if remaining == math.huge then "permanently" else `for {env.Admin.FormatDuration(remaining)}`
		env.Admin.Notify(player, `You are muted {when}. Reason: {reason}`, "warn")
		return false
	end

	if Chat.LockLevel > 0 and level < Chat.LockLevel then
		env.Admin.Notify(player, "Chat is locked right now.", "warn")
		return false
	end

	if Chat.SlowSeconds > 0 and level <= 0 then
		const now = os.clock()
		const last = lastMessageTime[player.UserId]
		if last and now - last < Chat.SlowSeconds then
			env.Admin.Notify(player, `Slow mode is on. Wait {math.ceil(Chat.SlowSeconds - (now - last))}s.`, "warn")
			return false
		end

		lastMessageTime[player.UserId] = now
	end

	return true
end

const function shouldDeliver(message: TextChatMessage, _recipient: TextSource): boolean
	const source = message.TextSource
	if not source then
		return true
	end

	const id = message.MessageId
	const cached = decisions[id]
	if cached ~= nil then
		return cached
	end

	const ok, result = pcall(evaluate, message, source)
	const decision = if ok then result else true
	if not ok then
		warn(`[CajAdmin] Chat handler error: {result}`)
	end

	decisions[id] = decision
	table.insert(decisionOrder, id)
	if #decisionOrder > MAX_CACHED_DECISIONS then
		decisions[table.remove(decisionOrder, 1) :: string] = nil
	end

	return decision
end

const function hookChannel(channel: Instance)
	if channel:IsA("TextChannel") then
		channel.ShouldDeliverCallback = shouldDeliver
	end
end

----------------------------------------------------------------------------------------------------
-- Legacy chat (Player.Chatted)
----------------------------------------------------------------------------------------------------

const function hookLegacyPlayer(player: Player)
	player.Chatted:Connect(function(text)
		env.Log.Chat({ Time = os.time(), Player = player.Name, UserId = player.UserId, Text = text })
		tryChatCommand(player, text)
	end)
end

function Chat.Start(environment: any)
	env = environment

	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		task.spawn(function()
			const channels = TextChatService:WaitForChild("TextChannels", 15)
			if not channels then
				warn("[CajAdmin] TextChatService has no TextChannels; chat commands, mutes and slow mode are disabled.")
				return
			end

			for _, channel in ipairs(channels:GetChildren()) do
				hookChannel(channel)
			end
			channels.ChildAdded:Connect(hookChannel)
		end)
	else
		Players.PlayerAdded:Connect(hookLegacyPlayer)
		for _, player in ipairs(Players:GetPlayers()) do
			hookLegacyPlayer(player)
		end

		warn("[CajAdmin] Legacy chat detected: mutes and slow mode cannot be enforced. Switch the experience to TextChatService.")
	end
end

return Chat
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX6C">
<Properties>
<string name="Name">CommandStub</string>
<ProtectedString name="Source"><![CDATA[--[[
	Template cloned once per command. The loader stores the command's public definition (name, description,
	arguments, ...) as JSON in the "Def" attribute, Cmdr replicates the clone to every client, and this tiny
	script turns it back into the definition table Cmdr expects.  The server-side Run function never leaves
	the server.
]]

return game:GetService("HttpService"):JSONDecode(script:GetAttribute("Def"))
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX6D">
<Properties>
<string name="Name">Log</string>
<ProtectedString name="Source"><![CDATA[--[[
	Command log (memory), chat log (memory), audit log (DataStore) and the optional webhook.
]]

const HttpService = game:GetService("HttpService")

const Store = require(script.Parent.Store)

const MAX_COMMANDS = 300
const MAX_CHAT = 200
const MAX_AUDIT = 100
const AUDIT_FLUSH_SECONDS = 30
const WEBHOOK_INTERVAL = 1.2

const Log = {}

local config: any = nil
const commands: { any } = {}
const chat: { any } = {}
const auditQueue: { any } = {}
const webhookQueue: { string } = {}
local webhookRunning = false

const function push(list: { any }, entry: any, max: number)
	table.insert(list, entry)
	if #list > max then
		table.remove(list, 1)
	end
end

function Log.Init(cfg: any)
	config = cfg

	task.spawn(function()
		while true do
			task.wait(AUDIT_FLUSH_SECONDS)
			Log.Flush()
		end
	end)

	game:BindToClose(function()
		Log.Flush()
	end)
end

----------------------------------------------------------------------------------------------------
-- Webhook
----------------------------------------------------------------------------------------------------

const function runWebhookQueue()
	if webhookRunning then
		return
	end

	webhookRunning = true
	task.spawn(function()
		while #webhookQueue > 0 do
			const content = table.remove(webhookQueue, 1) :: string
			const ok, err = pcall(function()
				HttpService:PostAsync(
					config.Webhook.Url,
					HttpService:JSONEncode({ username = "CajCMDR", content = content:sub(1, 1900) }),
					Enum.HttpContentType.ApplicationJson
				)
			end)

			if not ok then
				warn(`[CajAdmin] Webhook failed: {err}`)
			end

			task.wait(WEBHOOK_INTERVAL)
		end

		webhookRunning = false
	end)
end

function Log.Webhook(content: string)
	if not (config.Webhook and config.Webhook.Enabled and config.Webhook.Url ~= "") then
		return
	end

	if #webhookQueue > 50 then
		return
	end

	table.insert(webhookQueue, content)
	runWebhookQueue()
end

----------------------------------------------------------------------------------------------------
-- Commands
----------------------------------------------------------------------------------------------------

function Log.Command(entry: { Time: number, Executor: string, UserId: number, Level: number, Text: string, Response: string?, Command: string })
	push(commands, entry, MAX_COMMANDS)

	if config.Webhook and config.Webhook.Enabled and entry.Level >= (config.Webhook.MinLevel or 0) then
		Log.Webhook(`**{entry.Executor}** ran: {entry.Text}\n{entry.Response or ""}`)
	end
end

function Log.GetCommands(count: number?): { any }
	const result = {}
	const total = #commands
	for index = math.max(1, total - (count or 25) + 1), total do
		table.insert(result, commands[index])
	end

	return result
end

function Log.ClearCommands()
	table.clear(commands)
end

----------------------------------------------------------------------------------------------------
-- Chat
----------------------------------------------------------------------------------------------------

function Log.Chat(entry: { Time: number, Player: string, UserId: number, Text: string })
	push(chat, entry, MAX_CHAT)
end

function Log.GetChat(count: number?): { any }
	const result = {}
	const total = #chat
	for index = math.max(1, total - (count or 25) + 1), total do
		table.insert(result, chat[index])
	end

	return result
end

----------------------------------------------------------------------------------------------------
-- Audit (persistent)
----------------------------------------------------------------------------------------------------

function Log.Audit(entry: { Time: number, Executor: string, UserId: number, Text: string, Response: string? })
	table.insert(auditQueue, entry)
end

function Log.Flush()
	if #auditQueue == 0 then
		return
	end

	const batch = table.clone(auditQueue)
	table.clear(auditQueue)

	Store.Update("Audit", "recent", function(old)
		const list = if type(old) == "table" then old else {}
		for _, entry in ipairs(batch) do
			table.insert(list, entry)
		end

		while #list > MAX_AUDIT do
			table.remove(list, 1)
		end

		return list
	end)
end

function Log.GetAudit(): { any }
	Log.Flush()
	return Store.Get("Audit", "recent", {})
end

return Log
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX6E">
<Properties>
<string name="Name">Roles</string>
<ProtectedString name="Source"><![CDATA[--[[
	Turns Config bindings (communities, users, game passes, ...) into a role for every player.

	The result is stored on the Player as attributes so the client can read it too:
		CajRole  - role name
		CajLevel - role level (number)
]]

const GroupService = game:GetService("GroupService")
const HttpService = game:GetService("HttpService")
const MarketplaceService = game:GetService("MarketplaceService")
const Players = game:GetService("Players")
const RunService = game:GetService("RunService")

const Store = require(script.Parent.Store)

const GROUP_CACHE_SECONDS = 20
const OWNER_RANK = 255

type RoleDefinition = { Name: string, Level: number, Color: Color3 }

const Roles = {
	MaxLevel = 0,
	Resolved = Instance.new("BindableEvent"), -- (player, role) first time a player's role is known
	Changed = Instance.new("BindableEvent"), -- (player, role) whenever a player's role level changes
}

local config: any = nil
local roleList: { RoleDefinition } = {} -- ascending by level
const rolesByName: { [string]: RoleDefinition } = {} -- lower-case name
const tempRoles: { [number]: string } = {} -- UserId -> role name (this server only)
const savedRoleCache: { [number]: any } = {} -- role name, or false when the user has no saved role
const sources: { [Player]: string } = {}
const resolvedOnce: { [Player]: boolean } = {}
const groupCache: { [number]: { Time: number, Groups: { [number]: { Rank: number, Role: string } } } } = {}

const function warnOnce(message: string)
	warn(`[CajAdmin] Config: {message}`)
end

function Roles.Init(cfg: any)
	config = cfg

	table.clear(rolesByName)
	roleList = {}

	for _, definition in ipairs(cfg.Roles or {}) do
		if type(definition.Name) == "string" and type(definition.Level) == "number" then
			const lowered = definition.Name:lower()
			if rolesByName[lowered] then
				warnOnce(`role "{definition.Name}" is defined twice.`)
			else
				const role: RoleDefinition = {
					Name = definition.Name,
					Level = definition.Level,
					Color = definition.Color or Color3.fromRGB(200, 200, 200),
				}
				rolesByName[lowered] = role
				table.insert(roleList, role)
			end
		end
	end

	table.sort(roleList, function(a, b)
		return a.Level < b.Level
	end)

	if #roleList == 0 or roleList[1].Level > 0 then
		warnOnce('there is no Level 0 role, adding a default "Player" role.')
		const fallback: RoleDefinition = { Name = "Player", Level = 0, Color = Color3.fromRGB(190, 190, 190) }
		rolesByName["player"] = rolesByName["player"] or fallback
		table.insert(roleList, 1, fallback)
	end

	Roles.MaxLevel = roleList[#roleList].Level

	-- Check that every role name used in the config actually exists.
	const function check(name: any, where: string)
		if name and not rolesByName[tostring(name):lower()] then
			warnOnce(`unknown role "{tostring(name)}" in {where}.`)
		end
	end

	for groupId, bindings in pairs(cfg.Groups or {}) do
		for rank, roleName in pairs(bindings) do
			check(roleName, `Groups[{groupId}][{tostring(rank)}]`)
		end
	end
	for userId, roleName in pairs(cfg.Users or {}) do
		check(roleName, `Users[{userId}]`)
	end
	for passId, roleName in pairs(cfg.GamePasses or {}) do
		check(roleName, `GamePasses[{passId}]`)
	end
	check(cfg.GameOwnerRole, "GameOwnerRole")
	check(cfg.StudioRole, "StudioRole")
	for commandName, roleName in pairs(cfg.CommandRoles or {}) do
		check(roleName, `CommandRoles.{commandName}`)
	end
end

----------------------------------------------------------------------------------------------------
-- Lookups
----------------------------------------------------------------------------------------------------

function Roles.List(): { RoleDefinition }
	return roleList
end

function Roles.Get(name: string?): RoleDefinition?
	if not name then
		return nil
	end

	return rolesByName[tostring(name):lower()]
end

function Roles.GetBaseRole(): RoleDefinition
	return roleList[1]
end

--[[ Lowest role whose level is at least `level` (used for error messages). ]]
function Roles.GetRoleForLevel(level: number): RoleDefinition
	for _, role in ipairs(roleList) do
		if role.Level >= level then
			return role
		end
	end

	return roleList[#roleList]
end

function Roles.GetLevel(player: Player): number
	return player:GetAttribute("CajLevel") or 0
end

function Roles.GetRole(player: Player): RoleDefinition
	return Roles.Get(player:GetAttribute("CajRole")) or roleList[1]
end

function Roles.GetSource(player: Player): string
	return sources[player] or "Unknown"
end

function Roles.IsStaff(player: Player): boolean
	return Roles.GetLevel(player) > 0
end

function Roles.ToJson(): string
	const list = {}
	for _, role in ipairs(roleList) do
		table.insert(list, {
			Name = role.Name,
			Level = role.Level,
			Color = { math.floor(role.Color.R * 255 + 0.5), math.floor(role.Color.G * 255 + 0.5), math.floor(role.Color.B * 255 + 0.5) },
		})
	end

	return HttpService:JSONEncode(list)
end

----------------------------------------------------------------------------------------------------
-- Binding evaluation
----------------------------------------------------------------------------------------------------

const function fetchGroups(userId: number, player: Player?): { [number]: { Rank: number, Role: string } }
	const cached = groupCache[userId]
	if cached and os.clock() - cached.Time < GROUP_CACHE_SECONDS then
		return cached.Groups
	end

	const result = {}
	const ok, groups = pcall(GroupService.GetGroupsAsync, GroupService, userId)
	if ok and type(groups) == "table" then
		for _, group in ipairs(groups) do
			result[group.Id] = { Rank = group.Rank, Role = group.Role }
		end
	elseif player then
		-- Fallback: ask about each configured community one by one.
		for groupId in pairs(config.Groups or {}) do
			if type(groupId) == "number" and groupId > 0 then
				const okRank, rank = pcall(player.GetRankInGroup, player, groupId)
				if okRank and rank > 0 then
					const okRole, roleName = pcall(player.GetRoleInGroup, player, groupId)
					result[groupId] = { Rank = rank, Role = if okRole then roleName else "" }
				end
			end
		end
	end

	groupCache[userId] = { Time = os.clock(), Groups = result }
	return result
end

const function loadSavedRole(userId: number): string?
	if savedRoleCache[userId] == nil then
		const stored = Store.Get("Roles", tostring(userId), false)
		savedRoleCache[userId] = if type(stored) == "string" then stored else false
	end

	const value = savedRoleCache[userId]
	if value == false then
		return nil
	end

	return value
end

--[[
	Works out the role for any UserId (online or not).
	Returns the role and a human readable description of where it came from.
]]
function Roles.Compute(userId: number, player: Player?): (RoleDefinition, string)
	local best: RoleDefinition = roleList[1]
	local source = "Default"

	const function consider(roleName: any, description: string)
		const role = Roles.Get(roleName)
		if role and role.Level > best.Level then
			best = role
			source = description
		end
	end

	if RunService:IsStudio() and config.StudioRole then
		consider(config.StudioRole, "Roblox Studio")
	end

	consider((config.Users or {})[userId], "Users list")

	if game.CreatorId ~= 0 and game.CreatorType == Enum.CreatorType.User and game.CreatorId == userId then
		consider(config.GameOwnerRole, "Experience creator")
	end

	if player and next(config.GamePasses or {}) ~= nil then
		for passId, roleName in pairs(config.GamePasses) do
			const ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, userId, passId)
			if ok and owns then
				consider(roleName, `Game pass {passId}`)
			end
		end
	end

	const memberships = fetchGroups(userId, player)

	if game.CreatorId ~= 0 and game.CreatorType == Enum.CreatorType.Group then
		const membership = memberships[game.CreatorId]
		if membership and membership.Rank == OWNER_RANK then
			consider(config.GameOwnerRole, "Experience community owner")
		end
	end

	const atOrAbove = config.GroupRankMatching ~= "Exact"
	for groupId, bindings in pairs(config.Groups or {}) do
		const membership = if type(groupId) == "number" and groupId > 0 then memberships[groupId] else nil
		if not membership then
			continue
		end

		for key, roleName in pairs(bindings) do
			local matches = false
			if type(key) == "number" then
				matches = if atOrAbove then membership.Rank >= key else membership.Rank == key
			elseif type(key) == "string" then
				matches = membership.Role:lower() == key:lower()
			end

			if matches then
				consider(roleName, `Community {groupId} ({membership.Role}, rank {membership.Rank})`)
			end
		end
	end

	consider(tempRoles[userId], "Temporary role (setrole)")
	consider(loadSavedRole(userId), "Saved role (saverole)")

	return best, source
end

function Roles.GetLevelForUserId(userId: number): number
	const online = Players:GetPlayerByUserId(userId)
	if online then
		return Roles.GetLevel(online)
	end

	const role = Roles.Compute(userId, nil)
	return role.Level
end

--[[ Recomputes a player's role and updates their attributes. Yields. ]]
function Roles.Resolve(player: Player)
	const role, source = Roles.Compute(player.UserId, player)
	if not player.Parent then
		return
	end

	sources[player] = source

	const previousLevel = player:GetAttribute("CajLevel")
	player:SetAttribute("CajRole", role.Name)
	player:SetAttribute("CajLevel", role.Level)

	if not resolvedOnce[player] then
		resolvedOnce[player] = true
		Roles.Resolved:Fire(player, role)
	end

	if previousLevel ~= role.Level then
		Roles.Changed:Fire(player, role)
	end
end

function Roles.IsResolved(player: Player): boolean
	return resolvedOnce[player] == true
end

----------------------------------------------------------------------------------------------------
-- Overrides made by commands
----------------------------------------------------------------------------------------------------

--[[ Gives a role for the rest of this server's lifetime. Pass nil to remove it. ]]
function Roles.SetTemp(userId: number, roleName: string?)
	tempRoles[userId] = roleName

	const player = Players:GetPlayerByUserId(userId)
	if player then
		task.spawn(Roles.Resolve, player)
	end
end

--[[ Gives a role that is saved to the DataStore. Pass nil to remove it. ]]
function Roles.SetSaved(userId: number, roleName: string?): boolean
	const ok = if roleName then Store.Set("Roles", tostring(userId), roleName) else Store.Remove("Roles", tostring(userId))
	savedRoleCache[userId] = if roleName then roleName else false

	const player = Players:GetPlayerByUserId(userId)
	if player then
		task.spawn(Roles.Resolve, player)
	end

	return ok
end

function Roles.Clear(userId: number)
	tempRoles[userId] = nil
	Roles.SetSaved(userId, nil)
end

----------------------------------------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------------------------------------

function Roles.Start()
	const function track(player: Player)
		task.spawn(Roles.Resolve, player)
	end

	Players.PlayerAdded:Connect(track)
	for _, player in ipairs(Players:GetPlayers()) do
		track(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		sources[player] = nil
		resolvedOnce[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(math.max(30, config.RoleRefreshSeconds or 300))
			for _, player in ipairs(Players:GetPlayers()) do
				task.spawn(Roles.Resolve, player)
			end
		end
	end)
end

return Roles
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX6F">
<Properties>
<string name="Name">Store</string>
<ProtectedString name="Source"><![CDATA[--[[
	Thin DataStore wrapper. Every call is wrapped in pcall with retries, and everything falls back to an
	in-memory table when DataStores are unavailable (for example Studio without API access), so a missing
	DataStore never breaks a command.
]]

const DataStoreService = game:GetService("DataStoreService")

const RETRIES = 3

const Store = {}

const stores: { [string]: DataStore } = {}
const memory: { [string]: { [string]: any } } = {}
local available: boolean? = nil

const function memoryFor(name: string): { [string]: any }
	if not memory[name] then
		memory[name] = {}
	end

	return memory[name]
end

const function checkAvailable(): boolean
	if available ~= nil then
		return available
	end

	const ok = pcall(function()
		DataStoreService:GetDataStore("CajAdmin_Probe"):GetAsync("probe")
	end)

	available = ok
	if not ok then
		warn("[CajAdmin] DataStores are unavailable (enable API access in Studio). Persistent data will only last until the server closes.")
	end

	return ok
end

const function getStore(name: string): DataStore
	if not stores[name] then
		stores[name] = DataStoreService:GetDataStore(`CajAdmin_{name}`)
	end

	return stores[name]
end

--[[ Returns true when real DataStores are being used. ]]
function Store.IsPersistent(): boolean
	return checkAvailable()
end

function Store.Get(name: string, key: string, default: any?): any
	if not checkAvailable() then
		const value = memoryFor(name)[key]
		if value == nil then
			return default
		end

		return value
	end

	const dataStore = getStore(name)
	for attempt = 1, RETRIES do
		const ok, value = pcall(dataStore.GetAsync, dataStore, key)
		if ok then
			if value == nil then
				return default
			end

			return value
		end

		if attempt < RETRIES then
			task.wait(attempt)
		end
	end

	warn(`[CajAdmin] Could not read {name}/{key} from the DataStore.`)
	return default
end

function Store.Set(name: string, key: string, value: any): boolean
	if not checkAvailable() then
		memoryFor(name)[key] = value
		return true
	end

	const dataStore = getStore(name)
	for attempt = 1, RETRIES do
		const ok = pcall(dataStore.SetAsync, dataStore, key, value)
		if ok then
			return true
		end

		if attempt < RETRIES then
			task.wait(attempt)
		end
	end

	warn(`[CajAdmin] Could not write {name}/{key} to the DataStore.`)
	return false
end

--[[ `transform` receives the old value (or nil) and returns the new value. Returning nil cancels the write. ]]
function Store.Update(name: string, key: string, transform: (any) -> any): boolean
	if not checkAvailable() then
		const memoryStore = memoryFor(name)
		const newValue = transform(memoryStore[key])
		if newValue ~= nil then
			memoryStore[key] = newValue
		end

		return true
	end

	const dataStore = getStore(name)
	for attempt = 1, RETRIES do
		const ok = pcall(dataStore.UpdateAsync, dataStore, key, transform)
		if ok then
			return true
		end

		if attempt < RETRIES then
			task.wait(attempt)
		end
	end

	warn(`[CajAdmin] Could not update {name}/{key} in the DataStore.`)
	return false
end

function Store.Remove(name: string, key: string): boolean
	if not checkAvailable() then
		memoryFor(name)[key] = nil
		return true
	end

	const dataStore = getStore(name)
	for attempt = 1, RETRIES do
		const ok = pcall(dataStore.RemoveAsync, dataStore, key)
		if ok then
			return true
		end

		if attempt < RETRIES then
			task.wait(attempt)
		end
	end

	return false
end

return Store
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX76">
<Properties>
<string name="Name">Shared</string>
</Properties>
<Item class="Folder" referent="RBX72">
<Properties>
<string name="Name">Hooks</string>
</Properties>
<Item class="ModuleScript" referent="RBX71">
<Properties>
<string name="Name">Permissions</string>
<ProtectedString name="Source"><![CDATA[--[[
	Role based permissions for every command.

	Runs on the server (the real enforcement) and on the client (instant feedback + hides commands the
	player cannot use from autocomplete and `help`).  The data it reads is published by the server in
	ReplicatedStorage.CajAdminData and on each Player as the CajLevel / CajRole attributes.
]]

const HttpService = game:GetService("HttpService")
const ReplicatedStorage = game:GetService("ReplicatedStorage")
const RunService = game:GetService("RunService")

const DISABLED = -1

return function(registry: any)
	const data = ReplicatedStorage:WaitForChild("CajAdminData")

	local commandLevels: { [string]: number } = {}
	local groupLevels: { [string]: number } = {}
	local roles: { { Name: string, Level: number } } = {}

	const function decode(attribute: string): any
		const raw = data:GetAttribute(attribute)
		if typeof(raw) ~= "string" then
			return {}
		end

		const ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
		return if ok and type(decoded) == "table" then decoded else {}
	end

	const function refresh()
		commandLevels = decode("CommandLevels")
		groupLevels = decode("GroupLevels")
		roles = decode("Roles")
	end

	refresh()
	data:GetAttributeChangedSignal("CommandLevels"):Connect(function()
		refresh()
		if RunService:IsClient() then
			-- Commands may have been enabled/disabled or re-ranked: re-evaluate what the player can see.
			task.defer(function()
				registry.Cmdr.Dispatcher:RunBeforeCommandRegisterHooks()
			end)
		end
	end)
	data:GetAttributeChangedSignal("Roles"):Connect(refresh)
	data:GetAttributeChangedSignal("GroupLevels"):Connect(refresh)

	const function requiredLevel(context: any): number
		const own = commandLevels[context.Name:lower()]
		if own ~= nil then
			return own
		end

		const group = groupLevels[context.Group or ""]
		if group ~= nil then
			return group
		end

		-- Unknown command from an unknown source: only the highest role may run it.
		return data:GetAttribute("MaxLevel") or 100
	end

	const function roleNameForLevel(level: number): string
		for _, role in ipairs(roles) do
			if role.Level >= level then
				return role.Name
			end
		end

		return "a higher role"
	end

	registry:RegisterHook("BeforeRun", function(context: any): string?
		const needed = requiredLevel(context)
		if needed == DISABLED then
			return `The "{context.Name}" command is disabled.`
		end

		const level = context.Executor:GetAttribute("CajLevel") or 0
		if level < needed then
			return `You need the {roleNameForLevel(needed)} role or higher to use "{context.Name}".`
		end

		return nil
	end, -100)

	if RunService:IsClient() then
		registry:RegisterHook("BeforeCommandRegister", function(context: any): boolean?
			const needed = requiredLevel(context)
			if needed == DISABLED then
				return false
			end

			const level = context.Executor:GetAttribute("CajLevel") or 0
			if level < needed then
				return false
			end

			return nil
		end)
	end
end
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX75">
<Properties>
<string name="Name">Types</string>
</Properties>
<Item class="ModuleScript" referent="RBX73">
<Properties>
<string name="Name">Extras</string>
<ProtectedString name="Source"><![CDATA[--[[
	Extra argument types used by CajCMDR commands:
		role      - one of the roles from Config.Roles (returns the role name)
		material  - an Enum.Material
		emote     - a built-in R15 emote name
		positiveNumber - a number greater than 0
]]

const HttpService = game:GetService("HttpService")
const ReplicatedStorage = game:GetService("ReplicatedStorage")

const EMOTES = { "wave", "point", "dance", "dance2", "dance3", "laugh", "cheer" }

return function(registry: any)
	const Util = registry.Cmdr.Util
	const data = ReplicatedStorage:WaitForChild("CajAdminData")

	const function getRoles(): { { Name: string, Level: number } }
		const raw = data:GetAttribute("Roles")
		if typeof(raw) ~= "string" then
			return {}
		end

		const ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
		return if ok and type(decoded) == "table" then decoded else {}
	end

	const roleType = {
		Transform = function(text: string): { any }
			return Util.MakeFuzzyFinder(getRoles())(text)
		end,

		Validate = function(roles: { any }): (boolean, string?)
			return #roles > 0, "No role with that name could be found."
		end,

		Autocomplete = function(roles: { any }): { string }
			return Util.GetNames(roles)
		end,

		Parse = function(roles: { any }): string
			return roles[1].Name
		end,
	}

	const positiveNumberType = {
		Transform = function(text: string): number?
			return tonumber(text)
		end,

		Validate = function(value: number?): (boolean, string?)
			return value ~= nil and value > 0, "The number must be greater than 0."
		end,

		Parse = function(value: number): number
			return value
		end,
	}

	registry:RegisterType("role", roleType)
	registry:RegisterType("material", Util.MakeEnumType("Material", Enum.Material))
	registry:RegisterType("emote", Util.MakeEnumType("Emote", EMOTES))
	registry:RegisterType("positiveNumber", positiveNumberType)
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX74">
<Properties>
<string name="Name">Targets</string>
<ProtectedString name="Source"><![CDATA[--[[
	Rank-aware player selectors.

	"target" / "targets" work like Cmdr's "player" / "players" (me, all, others, random, %Team) but
	automatically leave out players who have an equal or higher role than the person running the command,
	and add an @Role selector:   ;kill @Moderator    ;bring %Red,Bob    ;kick all

	This module runs on both the server and the client (Cmdr replicates it), so it only reads attributes.
]]

const Players = game:GetService("Players")
const HttpService = game:GetService("HttpService")
const ReplicatedStorage = game:GetService("ReplicatedStorage")
const Teams = game:GetService("Teams")

return function(registry: any)
	const Util = registry.Cmdr.Util
	const data = ReplicatedStorage:WaitForChild("CajAdminData")

	const function levelOf(player: Player): number
		return player:GetAttribute("CajLevel") or 0
	end

	const function canTarget(executor: Player, target: Player): boolean
		if executor == target then
			return true
		end

		if data:GetAttribute("Protect") ~= true then
			return true
		end

		const executorLevel = levelOf(executor)
		if executorLevel >= (data:GetAttribute("MaxLevel") or 100) then
			return true
		end

		return executorLevel > levelOf(target)
	end

	const function filterTargets(executor: Player, players: { Player }): { Player }
		const result = {}
		for _, player in ipairs(players) do
			if canTarget(executor, player) then
				table.insert(result, player)
			end
		end

		return result
	end

	const function getRoles(): { { Name: string, Level: number } }
		const raw = data:GetAttribute("Roles")
		if typeof(raw) ~= "string" then
			return {}
		end

		const ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
		return if ok and type(decoded) == "table" then decoded else {}
	end

	const targetType = {
		Transform = function(text: string, executor: Player): { Player }
			const find = Util.MakeFuzzyFinder(Players:GetPlayers())
			return filterTargets(executor, find(text))
		end,

		Validate = function(players: { Player }): (boolean, string?)
			return #players > 0, "No player with that name could be found (or their rank is too high to target)."
		end,

		Autocomplete = function(players: { Player }): { string }
			return Util.GetNames(players)
		end,

		Parse = function(players: { Player }): Player?
			return players[1]
		end,

		Default = function(player: Player): string
			return player.Name
		end,

		ArgumentOperatorAliases = {
			me = ".",
			all = "*",
			others = "**",
			random = "?",
		},
	}

	-- %TeamName
	const teamTargetsType = {
		Listable = true,

		Transform = function(text: string, executor: Player): ({ Team }, Player)
			return Util.MakeFuzzyFinder(Teams:GetTeams())(text), executor
		end,

		Validate = function(teams: { Team }): (boolean, string?)
			return #teams > 0, "No team with that name could be found."
		end,

		Autocomplete = function(teams: { Team }): { string }
			return Util.GetNames(teams)
		end,

		Parse = function(teams: { Team }, executor: Player): { Player }
			return filterTargets(executor, teams[1]:GetPlayers())
		end,
	}

	-- @RoleName
	const roleTargetsType = {
		Listable = true,

		Transform = function(text: string, executor: Player): ({ any }, Player)
			return Util.MakeFuzzyFinder(getRoles())(text), executor
		end,

		Validate = function(roles: { any }): (boolean, string?)
			return #roles > 0, "No role with that name could be found."
		end,

		Autocomplete = function(roles: { any }): { string }
			return Util.GetNames(roles)
		end,

		Parse = function(roles: { any }, executor: Player): { Player }
			const result = {}
			for _, player in ipairs(Players:GetPlayers()) do
				if player:GetAttribute("CajRole") == roles[1].Name and canTarget(executor, player) then
					table.insert(result, player)
				end
			end

			return result
		end,
	}

	registry:RegisterType("target", targetType)
	registry:RegisterType("targets", Util.MakeListableType(targetType, { Prefixes = "% teamTargets @ roleTargets" }))
	registry:RegisterType("teamTargets", teamTargetsType)
	registry:RegisterType("roleTargets", roleTargetsType)
end
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
<Item class="ModuleScript" referent="RBX5C">
<Properties>
<string name="Name">Cmdr</string>
<ProtectedString name="Source"><![CDATA[const ReplicatedStorage = game:GetService("ReplicatedStorage")
const RunService = game:GetService("RunService")

const IS_SERVER_CONTAINER = script:FindFirstAncestorWhichIsA("ServerScriptService")
	or script:FindFirstAncestorWhichIsA("ServerStorage")
const IS_SERVER = RunService:IsServer()

if not IS_SERVER_CONTAINER then
	warn(
		"[Cmdr] The package should be kept within a server-side location. Future versions of Cmdr will require the server library be kept within ServerScriptService or ServerStorage."
	)
end

assert(
	IS_SERVER,
	"[Cmdr] The Cmdr server library cannot be required by the client. Please require the client libary instead."
)

const Dispatcher = require("@self/CmdrClient/Shared/Dispatcher")
const Registry = require("@self/CmdrClient/Shared/Registry")
const Util = require("@self/CmdrClient/Shared/Util")

const function createObject(className: string, name: string, parent: Instance): Instance
	const object = Instance.new(className)
	object.Name = name
	object.Parent = parent

	return object
end

--[=[
	@class Cmdr
	@server

	The Cmdr server object and entry point.
]=]

--[=[
	@within Cmdr
	@readonly

	@prop Registry Registry

	Refers to the command Registry.
]=]

--[=[
	@within Cmdr
	@readonly

	@prop Dispatcher Dispatcher

	Refers to the command Dispatcher.
]=]

--[=[
	@within Cmdr
	@readonly

	@prop Util Util

	Refers to a table containing many useful utility functions.
]=]

--[=[
	@within Cmdr
	@readonly
	@private

	@prop _remoteEvent RemoteEvent

	Refers to the CmdrEvent RemoteEvent found within CmdrClient.
]=]

--[=[
	@within Cmdr
	@readonly
	@private

	@prop _remoteFunction RemoteFunction

	Refers to the CmdrFunction RemoteFunction found within CmdrClient.
]=]

--[=[
	@within Cmdr
	@readonly
	@private

	@prop _replicatedRoot ModuleScript

	Refers to the CmdrClient modulescript containing all shared functionality.
]=]

--[=[
	@within Cmdr
	@readonly
	@private

	@prop _defaultCommandsFolder Folder

	Refers to the BuiltInCommands folder containing all default commands.
]=]

--[=[
	@within Cmdr
	@readonly
	@private

	@prop _defaultTypesFolder Folder

	Refers to the BuiltInTypes folder containing all default types.
]=]

const Cmdr = {
	Registry = nil :: Registry.Registry?,
	Dispatcher = nil :: any,
	Util = Util,

	_remoteEvent = nil :: RemoteEvent?,
	_remoteFunction = nil :: RemoteFunction?,

	_replicatedRoot = nil :: ModuleScript?,
	_defaultCommandsFolder = script.BuiltInCommands,
	_defaultTypesFolder = script.BuiltInTypes,
}

-- Initialize Cmdr
const function initialize()
	Cmdr.Registry = Registry(Cmdr)
	Cmdr.Dispatcher = Dispatcher(Cmdr)

	createObject("Folder", "Commands", script.CmdrClient)
	createObject("Folder", "Types", script.CmdrClient)

	Cmdr._replicatedRoot = script.CmdrClient
	Cmdr._replicatedRoot.Parent = ReplicatedStorage

	Cmdr._remoteEvent = createObject("RemoteEvent", "CmdrEvent", Cmdr._replicatedRoot)
	Cmdr._remoteFunction = createObject("RemoteFunction", "CmdrFunction", Cmdr._replicatedRoot)

	Cmdr._remoteFunction.OnServerInvoke = function(player: Player, text: string, options: any)
		if #text > 10000 then
			return "Input too long"
		end

		return Cmdr.Dispatcher:EvaluateAndRun(text, player, options)
	end

	Cmdr.Registry:RegisterTypesIn(Cmdr._defaultTypesFolder)

	script.BuiltInTypes:Destroy()
	script.BuiltInCommands.Name = "Server commands"
end

initialize()

-- Export Cmdr
return setmetatable(Cmdr, {
	__index = function(self, key)
		const registry = rawget(self, "Registry")
		const value = registry and registry[key]
		assert(value, `[Cmdr] Registry has no method or property "{key}".`)

		if type(value) == "function" then
			Util:_emitDeprecationWarning("ProxyCalls")

			return function(_, ...)
				return value(registry, ...)
			end
		end

		return nil
	end,
	__newindex = function(_, key)
		error(`[Cmdr] Cannot assign key "{key}"; the Cmdr object is read-only.`)
	end,
})
]]></ProtectedString>
</Properties>
