		return list:split(",")[index] or ""
	end,
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX2C">
<Properties>
<string name="Name">rand</string>
<ProtectedString name="Source"><![CDATA[const GENERATOR = Random.new()

return {
	Name = "rand",
	Description = "Returns a random number between min and max.",
	Group = "DefaultUtil",
	Args = {
		{
			Type = "integer",
			Name = "First number",
			Description = "If second number is nil, random number is between 1 and this value. If second number is provided, number is between this number and the second number.",
		},
		{
			Type = "integer",
			Name = "Second number",
			Description = "The upper bound.",
			Optional = true,
		},
	},

	ClientRun = function(_, firstNumber: number, secondNumber: number?): string
		const min = if secondNumber then math.min(firstNumber, secondNumber) else math.min(1, firstNumber)
		const max = if secondNumber then math.max(firstNumber, secondNumber) else math.max(1, firstNumber)

		return tostring(GENERATOR:NextInteger(min, max))
	end,
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX2D">
<Properties>
<string name="Name">replace</string>
<ProtectedString name="Source"><![CDATA[return {
	Name = "replace",
	Aliases = { "gsub", "//" },
	Description = "Replaces text A with text B.",
	Group = "DefaultUtil",
	AutoExec = {
		'alias "map|Maps a CSV into another CSV." replace $1{string|CSV} ([^,]+) "$2{string|mapped value|Use %1 to insert the element.}"',
		'alias "join|Joins a CSV with a specified delimiter." replace $1{string|CSV} , $2{string|Delimiter}',
	},
	Args = {
		{
			Type = "string",
			Name = "Haystack",
			Description = "The source string upon which to perform replacement.",
		},
		{
			Type = "string",
			Name = "Needle",
			Description = "The string pattern search for.",
		},
		{
			Type = "string",
			Name = "Replacement",
			Description = "The string to replace matches (%1 to insert matches).",
			Default = "",
		},
	},

	ClientRun = function(_, haystack: string, needle: string, replacement: string): string
		return haystack:gsub(needle, replacement)
	end,
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX2E">
<Properties>
<string name="Name">resolve</string>
<ProtectedString name="Source"><![CDATA[return {
	Name = "resolve",
	Description = "Resolves Argument Value Operators into lists. E.g., resolve players * gives you a list of all players.",
	Group = "DefaultUtil",
	AutoExec = {
		'alias "me|Displays your username." resolve players .',
	},
	Args = {
		{
			Type = "type",
			Name = "Type",
			Description = "The type for which to resolve.",
		},
		function(context: any)
			if context:GetArgument(1):Validate() == false then
				return
			end

			return {
				Type = context:GetArgument(1):GetValue(),
				Name = "Argument Value Operator",
				Description = "The value operator to resolve. One of: * ** . ? ?N",
				Optional = true,
			}
		end,
	},

	ClientRun = function(context: any): string
		const arg = context:GetArgument(2)
		return if arg then table.concat(arg.RawSegments, ",") else ""
	end,
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX2F">
<Properties>
<string name="Name">run</string>
<ProtectedString name="Source"><![CDATA[return {
	Name = "run",
	Aliases = { ">" },
	AutoExec = {
		'alias "discard|Run a command and discard the output." replace ${run $1} .* \\"\\"',
	},
	Description = "Runs a given command string (replacing embedded commands).",
	Group = "DefaultUtil",
	Args = {
		{
			Type = "string",
			Name = "Command",
			Description = "The command string to run.",
		},
	},

	ClientRun = function(context: any, commandString: string): string
		return context.Cmdr.Util.RunCommandString(context.Dispatcher, commandString)
	end,
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX30">
<Properties>
<string name="Name">runif</string>
<ProtectedString name="Source"><![CDATA[type ConditionFn = (text: string, arg: string) -> string?

const CONDITIONS: { [string]: ConditionFn } = {
	startsWith = function(text, arg)
		return text:sub(1, #arg) == arg and text:sub(#arg + 1)
	end,

	contains = function(text, arg)
		return text:find(arg, 1, true) and text
	end,

	endsWith = function(text, arg)
		return text:sub(-#arg) == arg and text:sub(1, -#arg - 1)
	end,

	pattern = function(text, arg)
		return text:match(arg) and text
	end,

	equals = function(text, arg)
		return text == arg and text
	end,

	notEquals = function(text, arg)
		return text ~= arg and text
	end,

	greaterThan = function(text, arg)
		return tonumber(arg) > tonumber(text) and text
	end,

	lessThan = function(text, arg)
		return tonumber(arg) < tonumber(text) and text
	end,

	greaterThanOrEqual = function(text, arg)
		return tonumber(arg) >= tonumber(text) and text
	end,

	lessThanOrEqual = function(text, arg)
		return tonumber(arg) <= tonumber(text) and text
	end,

	length = function(text, arg)
		return #text == tonumber(arg) and text
	end,
}

const conditionNames = {}
for name in pairs(CONDITIONS) do
	conditionNames[#conditionNames + 1] = name
end

return {
	Name = "runif",
	Description = "Runs a given command string if a certain condition is met.",
	Group = "DefaultUtil",
	Args = {
		function(context: any)
			return {
				Type = context.Cmdr.Util.MakeEnumType("ConditionFunction", conditionNames),
				Name = "Condition",
				Description = "The condition function.",
			}
		end,
		{
			Type = "string",
			Name = "Argument",
			Description = "The argument to the condition function.",
		},
		{
			Type = "string",
			Name = "Test against",
			Description = "The text to test against.",
		},
		{
			Type = "string",
			Name = "Command",
			Description = "The command string to run if requirements are met. If omitted, return value from condition function is used.",
			Optional = true,
		},
	},

	ClientRun = function(context: any, condition: string, arg: string, testAgainst: string, command: string?): string
		const conditionFunc = CONDITIONS[condition]
		const success, text = pcall(conditionFunc, testAgainst, arg)
		if success and text then
			return context.Dispatcher:EvaluateAndRun(
				context.Cmdr.Util.RunEmbeddedCommands(context.Dispatcher, command or text)
			)
		end

		return ""
	end,
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX31">
<Properties>
<string name="Name">runLines</string>
<ProtectedString name="Source"><![CDATA[return {
	Name = "run-lines",
	Description = "Splits input by newlines and runs each line as its own command. This is used by the init-run command.",
	Group = "DefaultUtil",
	Args = {
		{
			Type = "string",
			Name = "Script",
			Description = "The script to parse.",
			Default = "",
		},
	},

	ClientRun = function(context: any, text: string): string
		if #text == 0 then
			return ""
		end

		const shouldPrintOutput = context.Dispatcher:Run("var", "INIT_PRINT_OUTPUT") ~= ""
		const commands = text:gsub("\n+", "\n"):split("\n")
		for _, command: string in ipairs(commands) do
			if command:sub(1, 1) == "#" then
				continue
			end

			const output = context.Dispatcher:EvaluateAndRun(command)
			if shouldPrintOutput then
				context:Reply(output)
			end
		end

		return ""
	end,
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX32">
<Properties>
<string name="Name">unbind</string>
<ProtectedString name="Source"><![CDATA[const ContextActionService = game:GetService("ContextActionService")

return {
	Name = "unbind",
	Description = "Unbinds an input previously bound with Bind.",
	Group = "DefaultUtil",
	Args = {
		{
			Type = "userInput @ player",
			Name = "Input/Key",
			Description = "The key or input type you'd like to unbind.",
		},
	},

	ClientRun = function(context: any, bind: Enum.UserInputType | Enum.KeyCode | Player): string
		const binds = context:GetStore("CMDR_Binds")
		const existingBind = binds[bind]

		if not existingBind then
			return "That input wasn't bound."
		end

		if type(existingBind) == "string" then
			ContextActionService:UnbindAction(existingBind)
		end

		binds[bind] = nil
		return "Unbound command from input."
	end,
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX33">
<Properties>
<string name="Name">var</string>
<ProtectedString name="Source"><![CDATA[const ReplicatedStorage = game:GetService("ReplicatedStorage")

const BuiltInGuards = ReplicatedStorage.CmdrClient.Shared.BuiltInGuards
const IsDataStoreAvailable = require(BuiltInGuards.IsDataStoreAvailable) :: (number?) -> (any) -> string?

return {
	Name = "var",
	Description = "Gets a stored variable.",
	Group = "DefaultUtil",
	AutoExec = {
		'alias "init-edit|Edit your initialization script." edit ${var init} \\\\\n && var= init ||',
		'alias "init-run|Re-runs the initialization script manually." run-lines ${var init}',
		"init-run",
	},
	Args = {
		{
			Type = "storedKey",
			Name = "Key",
			Description = "The key to get, retrieved from your user data store. Keys prefixed with . are not saved. Keys prefixed with $ are game-wide. Keys prefixed with $. are game-wide and non-saved.",
		},
	},
	Guards = {
		IsDataStoreAvailable(1),
	},

	ClientRun = function(context: any, key: any)
		context:GetStore("vars_used")[key] = true
	end,
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX34">
<Properties>
<string name="Name">varServer</string>
<ProtectedString name="Source"><![CDATA[return function(context: any, key: string): string
	local gameWide = false
	local saved = true

	if key:sub(1, 1) == "$" then
		key = key:sub(2)
		gameWide = true
	end

	if key:sub(1, 1) == "." then
		key = key:sub(2)
		saved = false
	end

	const namespace = `var_{if gameWide then "global" else tostring(context.Executor.UserId)}`

	if saved then
		const dataStore = context.Cmdr.Util.GetDataStore()
		const keyPath = `{namespace}_{key}`
		const value = dataStore:GetAsync(keyPath) or ""

		if type(value) == "table" then
			return table.concat(value, ",") or ""
		end

		return tostring(value)
	else
		const store = context:GetStore(namespace)
		const value = store[key] or ""

		if type(value) == "table" then
			return table.concat(value, ",") or ""
		end

		return tostring(value)
	end
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX35">
<Properties>
<string name="Name">varSet</string>
<ProtectedString name="Source"><![CDATA[const ReplicatedStorage = game:GetService("ReplicatedStorage")

const BuiltInGuards = ReplicatedStorage.CmdrClient.Shared.BuiltInGuards
const IsDataStoreAvailable = require(BuiltInGuards.IsDataStoreAvailable) :: (number?) -> (any) -> string?

return {
	Name = "var=",
	Description = "Sets a stored value.",
	Group = "DefaultUtil",
	Args = {
		{
			Type = "storedKey",
			Name = "Key",
			Description = "The key to set, saved in your user data store. Keys prefixed with . are not saved. Keys prefixed with $ are game-wide. Keys prefixed with $. are game-wide and non-saved.",
		},
		{
			Type = "string",
			Name = "Value",
			Description = "Value or values to set.",
			Default = "",
		},
	},
	Guards = {
		IsDataStoreAvailable(1),
	},

	ClientRun = function(context: any, key: string)
		context:GetStore("vars_used")[key] = true
	end,
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX36">
<Properties>
<string name="Name">varSetServer</string>
<ProtectedString name="Source"><![CDATA[return function(context: any, key: string, value: string): string
	local gameWide = false
	local saved = true

	if key:sub(1, 1) == "$" then
		key = key:sub(2)
		gameWide = true
	end

	if key:sub(1, 1) == "." then
		key = key:sub(2)
		saved = false
	end

	const namespace = `var_{if gameWide then "global" else tostring(context.Executor.UserId)}`

	if saved then
		const dataStore = context.Cmdr.Util.GetDataStore()
		const keyPath = `{namespace}_{key}`
		dataStore:SetAsync(keyPath, value)

		return value
	else
		const store = context:GetStore(namespace)
		store[key] = value

		return value
	end
end
]]></ProtectedString>
</Properties>
</Item>
</Item>
