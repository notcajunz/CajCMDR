<Item class="ModuleScript" referent="RBX56">
<Properties>
<string name="Name">Command</string>
<ProtectedString name="Source"><![CDATA[const RunService = game:GetService("RunService")

const Argument = require("./Argument")

const IS_SERVER = RunService:IsServer()
const IS_CLIENT = RunService:IsClient()

--[=[
	@class CommandContext
	Represents an individual command execution.
]=]

local Command = {}
Command.__index = Command

--[=[
	@within CommandContext
	@readonly

	@prop Dispatcher Dispatcher

	The dispatcher that created this command context.
]=]

--[=[
	@within CommandContext
	@readonly

	@prop Cmdr Cmdr | CmdrClient

	The Cmdr instance this command belongs to.
]=]

--[=[
	@within CommandContext
	@readonly

	@prop Name string

	The command name.
]=]

--[=[
	@within CommandContext
	@readonly

	@prop RawText string

	The original command text.
]=]

--[=[
	@within CommandContext
	@readonly

	@prop Object CommandDefinition

	The command definition.
]=]

--[=[
	@within CommandContext
	@readonly

	@prop Group any

	The command group.
]=]

--[=[
	@within CommandContext
	@prop State table

	Temporary state storage.
]=]

--[=[
	@within CommandContext
	@readonly

	@prop Aliases {string}

	Command aliases.
]=]

--[=[
	@within CommandContext
	@readonly

	@prop Alias string

	The alias used to invoke this command.
]=]

--[=[
	@within CommandContext
	@readonly

	@prop Description string

	The command description.
]=]

--[=[
	@within CommandContext
	@readonly

	@prop Executor Player

	The player who executed this command.
]=]

--[=[
	@within CommandContext
	@readonly

	@prop ArgumentDefinitions {ArgumentDefinition}

	The command argument definitions.
]=]

--[=[
	@within CommandContext
	@readonly

	@prop RawArguments {string}

	The raw command arguments.
]=]

--[=[
	@within CommandContext
	@readonly

	@prop Arguments {ArgumentContext}

	The parsed arguments.
]=]

--[=[
	@within CommandContext
	@prop Data any

	Command data.
]=]

--[=[
	@within CommandContext
	@readonly

	@prop Response string?

	The command response.
]=]

--[=[
	@within CommandContext
	@readonly

	@prop Guards { (CommandContext) -> string? }

	Command guards.
]=]

--[=[
	@within CommandContext
	@param options table
	@return CommandContext

	Creates a new command context.
]=]
function Command.new(options)
	const self = {
		Dispatcher = options.Dispatcher,
		Cmdr = options.Dispatcher.Cmdr,
		Name = options.CommandObject.Name,
		RawText = options.Text,
		Object = options.CommandObject,
		Group = options.CommandObject.Group,
		State = {},
		Aliases = options.CommandObject.Aliases,
		Alias = options.Alias,
		Description = options.CommandObject.Description,
		Executor = options.Executor,
		ArgumentDefinitions = options.CommandObject.Args,
		RawArguments = options.Arguments,
		Arguments = {},
		Data = options.Data,
		Response = nil,
		Guards = options.Guards,
	}

	setmetatable(self, Command)

	return self
end

--[=[
	@within CommandContext
	Parses command arguments.
]=]
function Command:Parse(allowIncompleteArguments: boolean?): (boolean, string?)
	local hadOptional = false
	for index, definition in ipairs(self.ArgumentDefinitions) do
		if type(definition) == "function" then
			definition = definition(self)

			if not definition then
				break
			end
		end

		const required = definition.Default == nil and definition.Optional ~= true
		assert(
			not (required and hadOptional),
			`[Cmdr] Command {self.Name} has required arguments after optional arguments.`
		)

		if not required then
			hadOptional = true
		end

		if self.RawArguments[index] == nil and required and not allowIncompleteArguments then
			return false, `Required argument #{index} {definition.Name} is missing.`
		end

		if self.RawArguments[index] or allowIncompleteArguments then
			self.Arguments[index] = Argument.new(self, definition, self.RawArguments[index] or "")
		end
	end

	return true
end

--[=[
	@within CommandContext
	@return ArgumentContext?

	Validates command arguments.
]=]
function Command:Validate(isFinal: boolean?): (boolean, string)
	self._Validated = true

	local errorText = ""
	local success = true
	for index, argument in pairs(self.Arguments) do
		const valid, message = argument:Validate(isFinal)

		if not valid then
			success = false
			errorText ..= `; #{index} {argument.Name}: {message or "error"}`
		end
	end

	return success, errorText:sub(3)
end

--[=[
	@within CommandContext
	Returns the last argument containing a value.
]=]
function Command:GetLastArgument()
	for index = #self.Arguments, 1, -1 do
		const argument = self.Arguments[index]
		if argument and argument.RawValue then
			return argument
		end
	end

	return
end

--[=[
	@within CommandContext
	Gathers parsed argument values.
]=]
function Command:GatherArgumentValues(): ({ any }, number)
	const values = {}

	for index = 1, #self.ArgumentDefinitions do
		const argument = self.Arguments[index]

		if argument then
			values[index] = argument:GetValue()
		elseif type(self.ArgumentDefinitions[index]) == "table" then
			values[index] = self.ArgumentDefinitions[index].Default
		end
	end

	return values, #self.ArgumentDefinitions
end

--[=[
	@within CommandContext
	Runs the command.
]=]
function Command:Run(): string?
	assert(self._Validated, "[Cmdr] Must validate a command before running.")

	const beforeRunHook = self.Dispatcher:RunHooks("BeforeRun", self)
	if beforeRunHook then
		return beforeRunHook
	end

	const guardResult = self.Dispatcher:RunGuards(self)
	if guardResult then
		return guardResult
	end

	if not IS_SERVER and self.Object.Data and self.Data == nil then
		const values, length = self:GatherArgumentValues()
		self.Data = self.Object.Data(self, unpack(values, 1, length))
	end

	if not IS_SERVER and self.Object.ClientRun then
		const values, length = self:GatherArgumentValues()
		self.Response = self.Object.ClientRun(self, unpack(values, 1, length))
	end

	if self.Response == nil then
		if self.Object.Run then
			const values, length = self:GatherArgumentValues()
			self.Response = self.Object.Run(self, unpack(values, 1, length))
		elseif IS_SERVER then
			if self.Object.ClientRun then
				warn(
					`[Cmdr] {self.Name} command fell back to the server because ClientRun returned nil, but there is no server implementation!`
				)
			else
				warn(`[Cmdr] {self.Name} command has no implementation!`)
			end

			self.Response = "No implementation."
		else
			self.Response = self.Dispatcher:Send(self.RawText, self.Data)
		end
	end

	const afterRunHook = self.Dispatcher:RunHooks("AfterRun", self)
	if afterRunHook then
		return afterRunHook
	end

	return self.Response
end

--[=[
	@within CommandContext
	@return ArgumentContext?

	Returns an argument by index.
]=]
function Command:GetArgument(index: number)
	return self.Arguments[index]
end

--[=[
	@within CommandContext
	@return any

	Returns command data.
]=]
function Command:GetData()
	if self.Data then
		return self.Data
	end

	if self.Object.Data and not IS_SERVER then
		self.Data = self.Object.Data(self)
	end

	return self.Data
end

--[=[
	@within CommandContext
	Sends an event to a player.
]=]
function Command:SendEvent(player: Player, event: string, ...: any)
	self.Dispatcher:SendEvent(player, event, ...)
end

--[=[
	@within CommandContext
	Broadcasts an event to all clients.
]=]
function Command:BroadcastEvent(event: string, ...: any)
	self.Dispatcher:BroadcastEvent(event, ...)
end

--[=[
	@within CommandContext
	Sends a reply to the executor.
]=]
function Command:Reply(text: string, options: any?): { any }
	return self:SendEvent(self.Executor, "AddLine", text, options)
end

--[=[
	@within CommandContext
	Returns a registry store.
]=]
function Command:GetStore(name: string)
	return self.Cmdr.Registry:GetStore(name)
end

--[=[
	@within CommandContext
	Checks if the command has an implementation.
]=]
function Command:HasImplementation(): boolean
	return ((IS_CLIENT and self.Object.ClientRun) or self.Object.Run) ~= nil
end

return Command
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX57">
<Properties>
<string name="Name">Dispatcher</string>
<ProtectedString name="Source"><![CDATA[const Players = game:GetService("Players")
const RunService = game:GetService("RunService")
const TeleportService = game:GetService("TeleportService")

const Command = require("./Command")
const Util = require("./Util")

const IS_SERVER = RunService:IsServer()
const IS_CLIENT = RunService:IsClient()
const IS_STUDIO = RunService:IsStudio()

const WARNING_COLOR = Color3.fromRGB(255, 228, 26)
const HISTORY_SETTING_NAME = "CMDR_COMMAND_HISTORY"

const Player = Players.LocalPlayer

local hasDisplayedBeforeRunHookWarning = false

--[=[
	@class Dispatcher
	The dispatcher handles parsing, validating, and evaluating commands.
]=]

--[=[
	@within Dispatcher
	@readonly

	@prop Cmdr Cmdr | CmdrClient

	A reference to Cmdr. This may either be the server or client version of Cmdr depending on where the code is running.
]=]

--[=[
	@within Dispatcher
	@readonly

	@prop Registry Registry

	Refers to the command Registry.

]=]

const Dispatcher = {
	Cmdr = nil :: any,
	Registry = nil :: any,
}

--[=[
	@within Dispatcher
	@private

	@param allowIncompleteArguments -- When true, will ignore errors about arguments missing so we can parse live as the user types
	@param data -- Used for special networked Data about the command gathered on the client, purely optional.

	@return (CommandContext) | (false, string) -- If unsuccessful, returns false and the error text

	Takes in raw command information and generates a command out of it.
]=]
function Dispatcher:Evaluate(
	text: string,
	executor: Player,
	allowIncompleteArguments: boolean?,
	data: any?
): (typeof(Command.new()) | false, string?)
	assert(
		IS_SERVER or IS_CLIENT and executor == Players.LocalPlayer,
		"[Cmdr] Can't evaluate a command that isn't sent by the local player."
	)
	if typeof(text) ~= "string" or Util.TrimString(text) == "" then
		return false, "Command cannot be empty."
	end

	local arguments = Util.SplitString(text)
	const commandName = table.remove(arguments, 1)
	const commandObject = self.Registry:GetCommand(commandName)
	if not commandObject then
		return false,
			`{tostring(commandName)} is not a valid command name. Use the help command to see all available commands.`
	end

	arguments = Util.MashExcessArguments(arguments, #commandObject.Args)

	const commandContext = Command.new({
		Dispatcher = self,
		Text = text,
		CommandObject = commandObject,
		Alias = commandName,
		Executor = executor,
		Arguments = arguments,
		Data = data,
	})

	const success, errorText = commandContext:Parse(allowIncompleteArguments)
	if not success then
		return false, errorText
	end

	return commandContext
end

--[=[
	@within Dispatcher

	Runs a command as the given player. Executor is optional when running on the client.
	If `options.Data` is given, it will be available on the server with CommandContext.GetData
	If `options.IsHuman` is true and this function is called on the client, then the `text` will be inserted into the window history.
]=]
function Dispatcher:EvaluateAndRun(
	text: string,
	executor: Player?,
	options: {
		Data: any?,
		IsHuman: boolean?,
	}?
): string
	executor = executor or Players.LocalPlayer
	options = options or {}

	if IS_CLIENT and (options :: any).IsHuman then
		self:_pushHistory(text)
	end

	const commandContext, errorText = self:Evaluate(text, executor, nil, (options :: any).Data)
	if not commandContext then
		return errorText
	end

	const success, result = xpcall(function()
		const isValid, validationError = commandContext:Validate(true)

		if not isValid then
			return validationError
		end

		return commandContext:Run() or "Command executed."
	end, function(err)
		return debug.traceback(tostring(err))
	end)

	if not success then
		warn(`[Cmdr] Error occurred while evaluating command string {("%q"):format(text)}\n{result}`)
		return "An error occurred while running this command. Check the console for more information."
	end

	return result
end

--[=[
	@within Dispatcher
	@private
	@client

	Send text as the local user to remote server to be evaluated there.
]=]
function Dispatcher:Send(text: string, data: any?): string
	assert(IS_CLIENT, "[Cmdr] [Dispatcher::Send] can only be called from the client.")
	return self.Cmdr._remoteFunction:InvokeServer(text, { Data = data })
end

--[=[
	@within Dispatcher
	Sends an event to a player.
]=]
function Dispatcher:SendEvent(player: Player, event: string, ...: any)
	assert(typeof(player) == "Instance" and player:IsA("Player"), "[Cmdr] Argument #1 must be a Player")
	assert(typeof(event) == "string", "[Cmdr] Argument #2 must be a string")

	if IS_SERVER then
		self.Cmdr._remoteEvent:FireClient(player, event, ...)
	elseif self.Cmdr._events[event] then
		assert(
			player == Players.LocalPlayer,
			"[Cmdr] Event messages can only be sent to the local player on the client."
		)
		self.Cmdr._events[event](...)
	end
end

--[=[
	@within Dispatcher
	Broadcasts an event to all clients.
]=]
function Dispatcher:BroadcastEvent(event: string, ...: any)
	assert(IS_SERVER, "[Cmdr] Can't broadcast event messages from the client.")
	assert(typeof(event) == "string", "[Cmdr] Argument #1 must be a string")
	self.Cmdr._remoteEvent:FireAllClients(event, ...)
end

--[=[
	@within Dispatcher
	@client

	Invokes a command programmatically as the local player.
	Accepts a variable number of arguments, which are all joined with spaces before being run; the command should be the first argument.
	This function will raise an error if any validations occur, since it's only for hard-coded (or generated) commands.
]=]
function Dispatcher:Run(...: any): string
	assert(IS_CLIENT, "[Cmdr] [Dispatcher::Run] can only be called from the client.")

	const arguments = { ... }
	local text = tostring(arguments[1])
	for index = 2, #arguments do
		text ..= ` {arguments[index]}`
	end

	const commandContext, errorText = self:Evaluate(text, Players.LocalPlayer)
	assert(commandContext, errorText)

	const valid, validationError = commandContext:Validate(true)
	assert(valid, validationError)

	return commandContext:Run()
end

--[=[
	@within Dispatcher
	@private

	@param commandContext CommandContext
	@param ... ArgumentContext...

	Runs command-specific guard methods.
]=]
function Dispatcher:RunGuards(commandContext: any, ...: any): string?
	const guardMethods = commandContext.Object.Guards
	if not guardMethods then
		return nil
	end

	const guardMethodsType = typeof(guardMethods)
	assert(guardMethodsType == "table", `expected a table for Command.Guards, got {guardMethodsType}`)

	for _, guardMethod in ipairs(guardMethods) do
		const guardMethodType = typeof(guardMethod)
		assert(
			guardMethodType == "function",
			`expected a function for a value in Command.Guards, got {guardMethodType}`
		)

		const result = guardMethod(commandContext, ...)
		if result ~= nil then
			return tostring(result)
		end
	end

	return nil
end

--[=[
	@within Dispatcher
	@private

	@param hookName HookType
	@param commandContext CommandContext

	@return string? -- nil for success, string for cancellation.

	Runs hooks matching the specified hook name.
]=]
function Dispatcher:RunHooks(hookName: string, commandContext: any, passExactValue: boolean?): string?
	const hooks = self.Registry._hooks[hookName]
	assert(hooks, `[Cmdr] Invalid hook name: {hookName}`)
	assert(
		not (IS_SERVER and hookName == "BeforeCommandRegister"),
		"[Cmdr] The BeforeCommandRegister hook can only be run by the client."
	)

	if
		hookName == "BeforeRun"
		and #hooks == 0
		and commandContext.Group ~= "DefaultUtil"
		and commandContext.Group ~= "UserAlias"
		and commandContext:HasImplementation()
	then
		if not IS_STUDIO then
			return "Command blocked for security as no BeforeRun hook is configured."
		end

		if not hasDisplayedBeforeRunHookWarning then
			const environment = if IS_SERVER then "<Server>" else "<Client>"
			commandContext:Reply(
				`{environment} Commands will not run in-game if no BeforeRun hook is configured. Learn more: https://eryn.io/Cmdr/docs/hooks`,
				WARNING_COLOR
			)
			hasDisplayedBeforeRunHookWarning = true
		end
	end

	for _, hook in ipairs(hooks) do
		const result = hook.callback(commandContext)
		if result ~= nil then
			return if passExactValue == true then result else tostring(result)
		end
	end

	return nil
end

--[=[
	@within Dispatcher
	@private
	@client

	@param commandObject CommandDefinition

	@return string? -- nil for success, string for cancellation.

	Runs all BeforeCommandRegister Hooks on the specified CommandDefinition.
]=]
function Dispatcher:_runBeforeCommandRegisterHookForCommand(commandObject: any): string?
	assert(
		IS_CLIENT,
		"[Cmdr] [Dispatcher::_runBeforeCommandRegisterHookForCommand] can only be called from the client."
	)

	const commandName = commandObject.Name:lower()
	const commandContext = Command.new({
		Dispatcher = self,
		Text = nil,
		CommandObject = commandObject,
		Alias = commandName,
		Executor = Player,
		Arguments = {},
		Data = nil,
	})

	const result = self:RunHooks("BeforeCommandRegister", commandContext, true)
	assert(not result, "[Cmdr] BeforeCommandRegister hook must return nil or false.")
	return result
end

--[=[
	@within Dispatcher
	@param player Player? -- The player to run the hook for. This argument is required when the method is called from the server, and must be `nil`` on the client.

	Runs all BeforeCommandRegister Hooks on the client.
]=]
function Dispatcher:RunBeforeCommandRegisterHooks(player: Player?)
	assert(
		IS_CLIENT or IS_SERVER and typeof(player) == "Instance" and player:IsA("Player"),
		"[Cmdr] Argument #1 must be a Player when called on the Server."
	)
	assert(IS_CLIENT and player == nil, "[Cmdr] Argument #1 must be omitted when calling on the Client.")
	if IS_SERVER and player then
		self:SendEvent(player, "RunBeforeCommandRegisterHooks")
		return
	end

	for _, commandObject: any in pairs(self.Registry:GetCommands()) do
		const beforeCommandRegisterHook = self:_runBeforeCommandRegisterHookForCommand(commandObject)
		commandObject._isHidden = beforeCommandRegisterHook ~= nil and beforeCommandRegisterHook ~= true
	end
end

--[=[
	@within Dispatcher
	@client

	Returns an array of the user's command history. Most recent commands are inserted at the end of the array.
]=]
function Dispatcher:GetHistory(): { string }
	assert(IS_CLIENT, "[Cmdr] [Dispatcher::GetHistory] may only be used from the client.")
	return TeleportService:GetTeleportSetting(HISTORY_SETTING_NAME) or {}
end

--[=[
	@within Dispatcher
	@private
	@client

	Inserts the string into the window history
]=]
function Dispatcher:_pushHistory(text: string)
	assert(IS_CLIENT, "[Cmdr] [Dispatcher::PushHistory] may only be used from the client.")

	const history = self:GetHistory()
	if Util.TrimString(text) == "" or text == history[#history] then
		return
	end

	history[#history + 1] = text
	TeleportService:SetTeleportSetting(HISTORY_SETTING_NAME, history)
end

-- Export Dispatcher
Dispatcher.__index = Dispatcher
Dispatcher.__newindex = Dispatcher

export type Dispatcher = typeof(setmetatable(Dispatcher, Dispatcher))

return function(Cmdr): Dispatcher
	const ProtectedDispatcher = { Cmdr = Cmdr, Registry = Cmdr.Registry }
	return setmetatable(ProtectedDispatcher, {
		__index = function(_, key)
			if Util._deprecationWarnings[key] then
				Util:_emitDeprecationWarning(key)
			end

			const value = Dispatcher[key]
			assert(value, `[Cmdr] Dispatcher has no method or property "{key}".`)
			return value
		end,
		__newindex = function(_, key)
			error(`[Cmdr] Cannot assign key "{key}"; the Dispatcher is read-only.`)
		end,
	}) :: Dispatcher
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX58">
<Properties>
<string name="Name">Registry</string>
<ProtectedString name="Source"><![CDATA[const RunService = game:GetService("RunService")

const Util = require("./Util")

const IS_SERVER = RunService:IsServer()
const IS_CLIENT = RunService:IsClient()

const TYPE_METHODS = Util.MakeDictionary({
	"Transform",
	"Validate",
	"Autocomplete",
	"Parse",
	"DisplayName",
	"Listable",
	"ValidateOnce",
	"Prefixes",
	"Default",
	"ArgumentOperatorAliases",
})
const COMMAND_METHODS = Util.MakeDictionary({
	"Name",
	"Aliases",
	"AutoExec",
	"Description",
	"Args",
	"Run",
	"ClientRun",
	"Data",
	"Group",
	"Guards",
	"_scriptInstance",
})
const COMMAND_ARGUMENT_PROPERTIES = Util.MakeDictionary({ "Name", "Type", "Description", "Optional", "Default" })

const NIL_PROPERTIES = { "_autoExecFlushConnection" }

--[=[
	@class Registry
	The registry keeps track of all the commands and types that Cmdr knows about.
]=]

--[=[
	@within Registry
	@type HookType "BeforeRun" | "AfterRun" | "BeforeCommandRegister"
]=]

--[=[
	@within Registry
	@interface ArgumentDefinition
	.Type string | TypeDefinition -- The argument type (case sensitive), or an [inline TypeDefinition object](/docs/commands#dynamic-arguments-and-inline-types).
	.Name string -- The argument name, this is displayed to the user as they type.
	.Description string? -- A description of what the argument is, this is also displayed to the user.
	.Optional boolean? -- If this is set to `true`, then the user can run the command without filling out the value. In which case, the argument will be sent to implementations as `nil`.
	.Default any? -- If present, the argument will be automatically made optional, so if the user doesn't supply a value, implementations will receive whatever the value of `Default` is.

	The `table` definition, usually contained in a [CommandDefinition](#CommandDefinition), which 'defines' the argument.
]=]

--[=[
	@within Registry
	@interface CommandDefinition
	.Name string -- The name of the command
	.Aliases {string}? -- Aliases which aren't part of auto-complete, but if matched will run this command just the same. For example, `m` might be an alias of `announce`.
	.Description string? -- A description of the command, displayed to the user in the `help` command and auto-complete menu.
	.Group string? -- This property is intended to be used in hooks, so that you can categorise commands and decide if you want a specific user to be able to run them or not. But the `help` command will use them as headings.
	.Args {ArgumentDefinition | (CommandContext) -> (ArgumentDefinition)} -- Arguments for the command; this is technically optional but if you have no args, set it to `{}` or you may experience some interface weirdness.
	.Data (CommandContext, ...) -> any -- If your command needs to gather some extra data from the client that's only available on the client, then you can define this function. It should accept the command context and tuple of transformed arguments, and return a single value which will be available in the command with [CommandContext:GetData](/api/CommandContext#GetData).
	.ClientRun (CommandContext, ...) -> string? -- If you want your command to run on the client, you can add this function to the command definition itself. It works exactly like the function that you would return from the Server module. If this function returns a string, the command will run entirely on the client and won't touch the server (which means server-only hooks won't run). If this function doesn't return anything, it will fall back to executing the Server module on the server.
	.Run (CommandContext, ...) -> string? -- An older version of ClientRun. There are very few scenarios where this is preferred to ClientRun (so, in other words, don't use it!). These days, `Run` is only used for some dark magic involving server-sided command objects.
	._isDefault boolean -- Whether this command is provided by Cmdr itself rather than registered by the developer.
	._isHidden boolean -- Whether this command is hidden from the command list, help, and auto-complete.
]=]

--[=[
	@within Registry
	@interface TypeDefinition
	.Prefixes string? -- String containing [prefixed union types](/docs/commands#prefixed-union-types) for this type. This property should omit the inital type, so the string should begin with a prefix character, e.g. `Prefixes = "# integer ! boolean"`
	.DisplayName string? -- Overrides the user-facing name of this type in the autocomplete menu. Otherwise, the registered name of the type will be used.
	.Default ((Player) -> string)? -- Should return the "default" value for this type as a string. For example, the default value of the `player` type is the name of the player who ran the command.
	.Listable boolean? -- If true, this will tell Cmdr that comma-separated lists are allowed for this type. Cmdr will automatically split the list and parse each segment through your `Transform`, `Validate`, `Autocomplete` and `Parse` functions individually, so you don't have to change the logic of your type at all. The only limitation is that your `Parse` function **must return a table**, the tables from each individual segment's `Parse` functions will be merged into one table at the end of the parsing step. The uniqueness of values is ensured upon merging, so even if the user lists the same value several times, it will only appear once in the final table.
	.Transform (string, Player) -> T? -- Transform is an optional function that is passed two values: the raw text, and the player running the command. Then, whatever values this function returns will be passed to all other functions in the type (`Validate`, `Autocomplete` and `Parse`).
	.Validate (T) -> (boolean, string?) -- The `Validate` function is passed whatever is returned from the `Transform` function (or the raw value if there is no `Transform` function). If the value is valid for the type, it should return `true`. If the value is invalid, it should return two values: `false` and a string containing an error message. If this function is omitted, anything will be considered valid.
	.ValidateOnce (T) -> (boolean, string?) -- This function works exactly the same as the normal `Validate` function, except it only runs once (after the user presses Enter). This should only be used if the validation process is relatively expensive or needs to yield. For example, the `playerId` type uses this because it needs to call `GetUserIdFromNameAsync` in order to validate. For the vast majority of types, you should just use `Validate` instead.
	.Autocomplete (T) -> ({string}, {IsPartial: boolean?}?)? -- Should only be present for types that are possible to be auto-completed. It should return an array of strings that will be displayed in the auto-complete menu. It can also return a second value, containing a dictionary of options (currently, `IsPartial`: if true then pressing Tab to auto-complete won't continue onwards to the next argument.)
	.Parse (T) -> any -- Parse is the only required function in a type definition. It is the final step before the value is considered finalised. This function should return the actual parsed value that will be sent to implementations.

	The `table` definition, contained in an [ArgumentDefinition](#ArgumentDefinition) or [registered](#RegisterType), which 'defines' the argument.
]=]

--[=[
	@within Registry
	@readonly

	@prop Cmdr Cmdr | CmdrClient

	A reference to Cmdr. This may either be the server or client version of Cmdr depending on where the code is running.
]=]

--[=[
	@within Registry
	@readonly
	@private

	@prop _types table

	A collection of all types.
]=]

--[=[
	@within Registry
	@readonly
	@private

	@prop _typeAliases table

	A collection of all types and their names.
]=]

--[=[
	@within Registry
	@readonly
	@private

	@prop _commands table

	A collection of all registered commands.
]=]

--[=[
	@within Registry
	@readonly
	@private

	@prop _commandsArray table

	An array of all command objects.
]=]

--[=[
	@within Registry
	@readonly
	@private

	@prop _hooks { [HookType]: table }

	A collection of all registered hooks.
]=]

--[=[
	@within Registry
	@readonly
	@private

	@prop _autoExecBuffer table

	A buffer containing pending auto-execute commands waiting to be flushed.
]=]

--[=[
	@within Registry
	@readonly
	@private

	@prop _autoExecFlushConnection RBXScriptConnection?

	A connection used to defer flushing the auto-execute buffer until the end of the frame.
]=]

--[=[
	@prop _stores table
	@within Registry
	@readonly
	@private
]=]

const Registry = {
	Cmdr = nil :: any,

	_types = {},
	_typeAliases = {},

	_commands = {},
	_commandsArray = {},

	_hooks = {
		BeforeRun = {},
		AfterRun = {},
		BeforeCommandRegister = {},
	},

	_autoExecBuffer = {},
	_autoExecFlushConnection = nil,

	_stores = setmetatable({}, {
		__index = function(self, key)
			self[key] = {}
			return self[key]
		end,
	}),
}

--[=[
	@within Registry

	@param name -- The name of the type, this must be unique, alphanumeric, and start with a lower-case letter or digit.
	@param typeObject TypeDefinition

	Registers a type on the current realm (server/client), this function should be called from within the type definition ModuleScript.
]=]
function Registry:RegisterType(name: string, typeObject: any)
	assert(typeof(name) == "string", `[Cmdr] Invalid type name provided: {tostring(name)}`)
	assert(
		name:find("^[%d%l]%w*$") ~= nil,
		`[Cmdr] Invalid type name provided: "{name}", type names must be alphanumeric and start with a lowercase letter or digit.`
	)

	for key in pairs(typeObject) do
		assert(TYPE_METHODS[key] ~= nil, `[Cmdr] Unknown key/method in type "{name}": {key}`)
	end

	assert(self._types[name] == nil, `[Cmdr] Type "{name}" has already been registered.`)

	typeObject.Name = name
	typeObject.DisplayName = typeObject.DisplayName or name

	self._types[name] = typeObject

	if typeObject.Prefixes then
		self:RegisterTypePrefix(name, typeObject.Prefixes)
	end
end

--[=[
	@within Registry

	@param name -- The name of the type.
	@param union -- The string should omit the initial type name, so this string should begin with a prefix character, e.g. `# integer ! boolean`

	Registers a Prefixed Union Type string on the current realm (server/client), this function should be called from within the type definition ModuleScript.
	If there are already type prefixes for the given type name, they will be concatenated. This allows you to add prefixes to default types, like `players`.
]=]
function Registry:RegisterTypePrefix(name: string, union: string)
	if not self._typeAliases[name] then
		self._typeAliases[name] = name
	end

	self._typeAliases[name] = `{self._typeAliases[name]} {union}`
end

--[=[
	@within Registry

	@param name -- The name of the type, this must be unique, alphanumeric, and start with a lower-case letter or digit.
	@param alias -- The string should *include* the initial type name, e.g. `string # integer ! boolean`

	Allows you to register a name which will be expanded into a longer type which can be used as a command argument type.
	For example, if you register the alias `stringOrNumber` it could be interpreted as `string # number` when used.
]=]
function Registry:RegisterTypeAlias(name: string, alias: string)
	assert(self._typeAliases[name] == nil, `[Cmdr] Type alias "{name}" already exists!`)

	self._typeAliases[name] = alias
end

--[=[
	@within Registry
	@server

	Registers all types from a container.
]=]
function Registry:RegisterTypesIn(container: Instance)
	for _, object in pairs(container:GetChildren()) do
		if object:IsA("ModuleScript") then
			object.Parent = self.Cmdr._replicatedRoot.Types

			require(object)(self)
		else
			self:RegisterTypesIn(object)
		end
	end
end

-- These are exactly the same thing. No one will notice. Except for you, dear reader.
--[=[
	@within Registry
	@method RegisterHooksIn
	@server

	@param container Instance

	Registers all hooks from within a container on both the server and client.
	If you want to add a hook only on the server or client – e.g. for logging – then you should use the Register.RegisterHook method instead.
]=]
Registry.RegisterHooksIn = Registry.RegisterTypesIn

--[=[
	@within Registry
	@private

	@param commandObject CommandDefinition

	Validates the arguments of a provided Command Object.
	Errors if an invalid property exists.
]=]
function Registry:_validateCommandArguments(commandObject: any)
	for index, argument in pairs(commandObject.Args) do
		if type(argument) ~= "table" then
			continue
		end

		for key in pairs(argument) do
			assert(
				COMMAND_ARGUMENT_PROPERTIES[key],
				`[Cmdr] Unknown property in command "{commandObject.Name or "unknown"}" argument #{index}: {key}`
			)
		end
	end
end

--[=[
	@within Registry
	@private

	@param commandObject CommandDefinition

	Validates the properties of a provided Command Object.
	Errors if an invalid property exists.
]=]
function Registry:_validateCommand(commandObject: any)
	for key in pairs(commandObject) do
		assert(
			COMMAND_METHODS[key],
			`[Cmdr] Unknown key/method in command "{commandObject.Name or "unknown command"}": {key}`
		)
	end

	if commandObject.Args then
		self:_validateCommandArguments(commandObject)
	end
end

--[=[
	@within Registry

	@param commandObject CommandDefinition
	@param isDefault boolean? -- True if this is a built-in Cmdr command
	@return boolean -- Returns true if registration succeeded or false if aborted due to a developer override

	Register a command purely based on its definition.
	Prefer using Registry:RegisterCommand for proper handling of client/server model.
]=]
function Registry:RegisterCommandObject(commandObject: any, isDefault: boolean?): boolean
	self:_validateCommand(commandObject) -- Error if the command object isn't valid

	commandObject._isDefault = isDefault == true
	commandObject._isHidden = false

	if IS_CLIENT then
		const beforeCommandRegisterHook = self.Cmdr.Dispatcher:_runBeforeCommandRegisterHookForCommand(commandObject)
		commandObject._isHidden = beforeCommandRegisterHook ~= nil and beforeCommandRegisterHook ~= true

		if commandObject.AutoExec then
			table.insert(self._autoExecBuffer, commandObject.AutoExec)
			self:_flushAutoExecBufferDeferred()
		end
	end

	const commandName = commandObject.Name:lower()
	const existingCommand = self._commands[commandName]
	if existingCommand then
		const existingIsDefault = existingCommand._isDefault

		if isDefault and not existingIsDefault then
			warn(
				`[Cmdr] Ignored default command "{commandObject.Name}" because a custom developer command is already registered with this name.`
			)
			return false
		end

		if not isDefault and existingIsDefault then
			warn(`[Cmdr] Custom command "{commandObject.Name}" has replaced the default built-in command.`)
		elseif not isDefault and not existingIsDefault then
			warn(`[Cmdr] Custom command "{commandObject.Name}" was overwritten by a newer custom command.`)
		else
			warn(`[Cmdr] Default command "{commandObject.Name}" was overwritten by a newer default command.`)
		end

		if IS_SERVER and existingCommand._scriptInstance then
			existingCommand._scriptInstance:Destroy()
		end

		const commandIndex = table.find(self._commandsArray, existingCommand)
		if commandIndex then
			self._commandsArray[commandIndex] = commandObject
		else
			table.insert(self._commandsArray, commandObject)
		end

		if existingCommand.Aliases then
			for _, alias in pairs(existingCommand.Aliases) do
				self._commands[alias:lower()] = nil
			end
		end
	else
		table.insert(self._commandsArray, commandObject)
	end

	self._commands[commandName] = commandObject

	if commandObject.Aliases then
		for _, alias in pairs(commandObject.Aliases) do
			self._commands[alias:lower()] = commandObject
		end
	end

	return true
end

--[=[
	@within Registry

	@param filter ((CommandDefinition) -> boolean)? -- If present, will be passed a command definition which will then only be registered if the function returns `true`.

	Registers a command definition and its server equivalent.
	Handles replicating the definition to the client.
]=]
function Registry:RegisterCommand(
	commandScript: ModuleScript,
	commandServerScript: ModuleScript?,
	filter: ((any) -> boolean)?,
	isDefault: boolean?
)
	local commandObject = require(commandScript)
	assert(
		typeof(commandObject) == "table",
		`[Cmdr] Invalid return value from command script "{commandScript.Name}" (CommandDefinition expected, got {typeof(
			commandObject
		)})`
	)

	if commandServerScript then
		assert(IS_SERVER, "[Cmdr] The commandServerScript parameter is not valid for client usage.")
		commandObject.Run = require(commandServerScript)
	end

	if filter and not filter(commandObject) then
		return
	end

	commandObject._scriptInstance = commandScript

	const success = self:RegisterCommandObject(commandObject, isDefault)
	if success then
		commandScript.Parent = self.Cmdr._replicatedRoot.Commands
	end
end

--[=[
	@within Registry

	@param filter ((CommandDefinition) -> boolean)? -- If present, will be passed a command definition which will then only be registered if the function returns `true`.

	Registers all commands from within a container on both the server and client.
	Module scripts which include `Server` in their name will not be sent to the client.
]=]
function Registry:RegisterCommandsIn(container: Instance, filter: ((any) -> boolean)?, isDefault: boolean?)
	local skippedServerScripts = {}
	local usedServerScripts = {}
	for _, commandScript in pairs(container:GetChildren()) do
		if commandScript:IsA("ModuleScript") then
			if not commandScript.Name:find("Server") then
				const serverCommandScript = container:FindFirstChild(`{commandScript.Name}Server`)
				if serverCommandScript then
					usedServerScripts[serverCommandScript] = true
				end

				self:RegisterCommand(commandScript, serverCommandScript, filter, isDefault)
			else
				skippedServerScripts[commandScript] = true
			end
		else
			self:RegisterCommandsIn(commandScript, filter, isDefault)
		end
	end

	for skippedScript in pairs(skippedServerScripts) do
		if not usedServerScripts[skippedScript] then
			warn(
				`[Cmdr] Command script {skippedScript.Name} was skipped because it has 'Server' in its name, and has no equivalent shared script.`
			)
		end
	end
end

--[=[
	@within Registry
	@server

	@param arrayOrFunc {string} | (CommandDefinition) -> boolean | nil

	Registers the default commands on both the server and client.

	The optional `arrayOrFunc` parameter can be provided with:

	1. an array of strings — this will limit registration to only commands which have their `Group` property set to this
	2. a function which takes in a CommandDefinition and returns a `boolean` — only if `true` is returned will the command be registered

	If a custom developer command is registered with the same name or alias as a default command, the developer command will take precedence and replace the default built-in command.
]=]
function Registry:RegisterDefaultCommands(arrayOrFunc: { string } | (any) -> boolean | nil)
	assert(IS_SERVER, "[Cmdr] RegisterDefaultCommands cannot be called from the client.")

	const dictionary = if type(arrayOrFunc) == "table" then Util.MakeDictionary(arrayOrFunc) else nil
	local filter

	if dictionary ~= nil then
		function filter(command)
			return dictionary[command.Group] or false
		end
	else
		filter = arrayOrFunc
	end

	self:RegisterCommandsIn(self.Cmdr._defaultCommandsFolder, filter, true)
end

--[=[
	@within Registry
	@return CommandDefinition?

	Returns the CommandDefinition from the given name, or nil if no command is found. Command aliases are also accepted.
]=]
function Registry:GetCommand(name: string)
	return self._commands[name:lower()]
end

--[=[
	@within Registry
	@return {CommandDefinition}

	Returns an array of all registers commands, not including aliases.
]=]
function Registry:GetCommands(): { any }
	return self._commandsArray
end

--[=[
	@within Registry
	Returns an array of containing the names of all registered commands, not including aliases.
]=]
function Registry:GetCommandNames(includeAliases: boolean?): { string }
	local commands = {}

	for _, command in pairs(self._commandsArray) do
		if command._isHidden then
			continue
		end

		if includeAliases and typeof(command.Aliases) == "table" then
			for _, alias in pairs(command.Aliases) do
				table.insert(commands, alias)
			end
		end

		table.insert(commands, command.Name)
	end

	return commands
end

--[=[
	@within Registry
	@method GetCommandsAsStrings
	@deprecated v1.8.0 -- This method was renamed to GetCommandNames in v1.8.0. The old name exists for backwards compatibility and should not be used for new work.
]=]
Registry.GetCommandsAsStrings = Registry.GetCommandNames
Util:_registerDeprecationWarning(
	"GetCommandsAsStrings",
	"This method was renamed to GetCommandNames in v1.8.0. The old name exists for backwards compatibility and should not be used for new work."
)

--[=[
	@within Registry
	Returns an array of containing the names of all registered types, not including aliases.
]=]
function Registry:GetTypeNames(): { string }
	local typeNames = {}

	for typeName in pairs(self._types) do
		table.insert(typeNames, typeName)
	end

	return typeNames
end

--[=[
	@within Registry
	@return TypeDefinition?

	Returns the type definition from the given name, or nil if no argument is found.
]=]
function Registry:GetType(name: string)
	return self._types[name]
end

--[=[
	@within Registry
	@return TypeDefinition | string

	Returns a type name taking aliases into account. If there is no alias, the name parameter is simply returned as a pass through.
]=]
function Registry:GetTypeName(name: string): string | any
	return self._typeAliases[name] or name
end

--[=[
	@within Registry

	@param hookName HookType
	@param callback (CommandContext) -> string? -- returns nil for ok, string (errorText) for cancellation
	@param priority number? -- If unspecified, the priority will default to `0`.

	Registers a hook on the current realm (server/client). This should probably be ran on the server or in a hook module script, but can also work on the client.
	Hooks run in order of priority from lowest (running first) to highest.
]=]
function Registry:RegisterHook(hookName: string, callback: (any) -> string?, priority: number?)
	assert(self._hooks[hookName], `[Cmdr] Invalid hook name: {hookName}`)

	table.insert(self._hooks[hookName], { callback = callback, priority = priority or 0 })
	table.sort(self._hooks[hookName], function(a, b)
		return a.priority < b.priority
	end)
end

--[=[
	@within Registry
	@method AddHook
	@deprecated v1.1.2 -- This method was renamed to RegisterHook in v1.1.2. The old name exists for backwards compatibility and should not be used for new work.
]=]
Registry.AddHook = Registry.RegisterHook
Util:_registerDeprecationWarning(
	"AddHook",
	"This method was renamed to RegisterHook in v1.1.2. The old name exists for backwards compatibility and should not be used for new work."
)

--[=[
	@within Registry
	@return table

	Returns a table saved with the given name. Always returns the same table on subsequent calls. Useful for commands that require persistent state, like bind or ban.
	This is the same as CommandContext.GetStore.
]=]
function Registry:GetStore(name: string)
	return self._stores[name]
end

--[=[
	@within Registry
	@private

	Runs all pending auto exec commands in Registry.AutoExecBuffer.
]=]
function Registry:_flushAutoExecBuffer()
	for _, commandGroup in ipairs(self._autoExecBuffer) do
		for _, command in ipairs(commandGroup) do
			self.Cmdr.Dispatcher:EvaluateAndRun(command)
		end
	end

	self._autoExecBuffer = {}
end

--[=[
	@within Registry
	@private

	Calls Registry.FlushAutoExecBuffer at the end of the frame.
]=]
function Registry:_flushAutoExecBufferDeferred()
	if self._autoExecFlushConnection then
		return
	end

	self._autoExecFlushConnection = RunService.Heartbeat:Connect(function()
		self._autoExecFlushConnection:Disconnect()
		self._autoExecFlushConnection = nil
		self:_flushAutoExecBuffer()
	end)
end

-- Export Registry
Registry.__index = Registry
Registry.__newindex = Registry

export type Registry = typeof(setmetatable(Registry, Registry))

return function(Cmdr): Registry
	const ProtectedRegistry = { Cmdr = Cmdr }
	return setmetatable(ProtectedRegistry, {
		__index = function(_, key)
			if Util._deprecationWarnings[key] then
				Util:_emitDeprecationWarning(key)
			end

			const value = Registry[key]
			assert(value or table.find(NIL_PROPERTIES, key), `[Cmdr] Registry has no method or property "{key}".`)
			return value
		end,
		__newindex = function(_, key, value)
			assert(
				table.find(NIL_PROPERTIES, key) or Registry[key],
				`[Cmdr] Cannot assign key "{key}"; the Registry is read-only.`
			)
			Registry[key] = value
		end,
	}) :: Registry
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX59">
<Properties>
<string name="Name">Util</string>
<ProtectedString name="Source"><![CDATA[-- Here be dragons

const DataStoreService = game:GetService("DataStoreService")
const RunService = game:GetService("RunService")
const TextService = game:GetService("TextService")

local dataStoreActive: boolean? = nil
local dataStore: GlobalDataStore? = nil
const dataStoreQueue: { thread } = {}

const CMDR_ESCAPE = "___!CMDR_ESCAPE!___"
const CMDR_QUOTE = "___!CMDR_QUOTE!___"
const CMDR_SQUOTE = "___!CMDR_SQUOTE!___"
const CMDR_NEW_LINE = "___!CMDR_NL!___"
const CMDR_DOLLAR = "___!CMDR_DOLLAR!___"

const OPERATORS = { "&&", "||", ";" }
const START_QUOTE_PATTERN = [=[^(['"])]=]
const END_QUOTE_PATTERN = [=[(['"])$]=]
const ESCAPED_QUOTE_PATTERN = [=[(\*)['"]$]=]

const CACHED_LABELS = setmetatable({}, { __mode = "k" })

if RunService:IsServer() then
	task.spawn(function()
		const success, result = pcall(function()
			const targetStore = DataStoreService:GetDataStore("_package/eryn.io/Cmdr")
			targetStore:GetAsync("test_key")
			return targetStore
		end)

		dataStoreActive = success

		if success then
			dataStore = result
		end

		while #dataStoreQueue > 0 do
			const nextThread = table.remove(dataStoreQueue, 1)

			if nextThread then
				coroutine.resume(nextThread)
			end
		end
	end)
end

-- Converts instances into display names and keeps the original values.
const function transformInstanceSet(instances: { any }): ({ string }, { any })
	const names: { string } = {}

	for index = 1, #instances do
		local object = instances[index]
		names[index] = object.Name or tostring(object)
	end

	return names, instances
end

-- Converts a hexadecimal string into a UTF-8 character.
const function hexToChar(value: string): string
	return utf8.char(tonumber(value, 16) :: number)
end

-- Replaces escaped control characters with temporary placeholders.
const function encodeControlChars(text: string): string
	return (text:gsub("\\\\", CMDR_ESCAPE):gsub('\\"', CMDR_QUOTE):gsub("\\'", CMDR_SQUOTE):gsub("\\\n", CMDR_NEW_LINE))
end

-- Restores temporary placeholders back into control characters.
const function decodeControlChars(text: string): string
	return (text:gsub(CMDR_ESCAPE, "\\"):gsub(CMDR_QUOTE, '"'):gsub(CMDR_SQUOTE, "'"):gsub(CMDR_NEW_LINE, "\n"))
end

-- Replaces escaped command variables with temporary placeholders.
const function encodeCommandEscape(text: string): string
	return (text:gsub("\\%$", CMDR_DOLLAR))
end

-- Restores temporary command variable placeholders.
const function decodeCommandEscape(text: string): string
	return (text:gsub(CMDR_DOLLAR, "$"))
end

-- Wraps a string in quotes while escaping special characters.
const function quoteString(value: string): string
	return ("%q"):format(value)
end

--[=[
	@class Util
	Cmdr utilities module.
]=]

--[=[
	@within Util
	@readonly
	@private

	@prop _deprecationWarnings { [string]: { Description: string, Suppressed: boolean, Emitted: boolean } }

	A collection of deprecated methods and their warnings.
]=]

const Util = {
	_deprecationWarnings = {} :: { [string]: { Description: string, Suppressed: boolean, Emitted: boolean } },
}

function Util.GetDataStore(): GlobalDataStore?
	if RunService:IsClient() then
		return
	end

	if dataStoreActive == nil then
		table.insert(dataStoreQueue, coroutine.running())
		coroutine.yield()
	end

	return dataStore
end

--[=[
	@within Util
	Takes an array and flips its values into dictionary keys with value of true.
]=]
function Util.MakeDictionary(array: { any }): { [any]: true }
	const dictionary = {}

	for index = 1, #array do
		dictionary[array[index]] = true
	end

	return dictionary
end

--[=[
	@within Util
	Takes a dictionary and returns its keys.
]=]
function Util.DictionaryKeys(dict: { [any]: any }): { any }
	const keys = {}

	for key in pairs(dict) do
		table.insert(keys, key)
	end

	return keys
end

--[=[
	@within Util

	Returns a function that is a fuzzy finder for the specified set or container.

	Can pass an array of strings, array of instances, array of EnumItems,
	array of dictionaries with a Name key or an instance (in which case its children will be used).

	Exact matches will be inserted in the front of the resulting array.
]=]
function Util.MakeFuzzyFinder(setOrContainer: any): (string, boolean?, boolean?) -> any
	const containerType = typeof(setOrContainer)
	assert(
		containerType == "table" or containerType == "Enum" or containerType == "Instance",
		"[Cmdr] MakeFuzzyFinder only accepts a table, Enum, or Instance."
	)

	if containerType == "Enum" then
		setOrContainer = setOrContainer:GetEnumItems()
	elseif containerType == "Instance" then
		setOrContainer = setOrContainer:GetChildren()
	end

	local names: { string }
	local instances: { any }? = nil
	if #setOrContainer == 0 then
		names = {}
	else
		const first = setOrContainer[1]
		const firstType = typeof(first)

		if firstType == "string" then
			names = setOrContainer
		else
			const firstNameType = if firstType == "table" or firstType == "Instance" then typeof(first.Name) else "nil"
			assert(
				firstType == "Instance"
					or firstType == "EnumItem"
					or (firstType == "table" and firstNameType == "string"),
				"[Cmdr] MakeFuzzyFinder only accepts tables of instances or strings."
			)
			names, instances = transformInstanceSet(setOrContainer)
		end
	end

	-- Searches the set (checking exact matches first)
	return function(text: string, returnFirst: boolean?, matchStart: boolean?)
		const resultsPriority = {}
		const results = {}

		for index, name in pairs(names) do
			const value = if instances then instances[index] else name

			if name:lower() == text:lower() then
				if returnFirst then
					return value
				end

				results[#results + 1] = value
				resultsPriority[value] = 0
			elseif matchStart then
				if name:lower():sub(1, #text) == text:lower() then
					results[#results + 1] = value
					resultsPriority[value] = 1
				end
			else
				const startingIndex = name:lower():find(text:lower(), 1, true)
				if startingIndex then
					results[#results + 1] = value
					resultsPriority[value] = startingIndex
				end
			end
		end

		table.sort(results, function(a, b)
			const aPriority = resultsPriority[a]
			const bPriority = resultsPriority[b]

			if aPriority ~= bPriority then
				return aPriority < bPriority
			end

			const aString = if typeof(a) == "string"
				then a
				elseif typeof(a) == "Instance" then a.Name
				elseif typeof(a) == "table" and typeof(a.Name) == "string" then a.Name
				else ""
			const bString = if typeof(b) == "string"
				then b
				elseif typeof(b) == "Instance" then b.Name
				elseif typeof(b) == "table" and typeof(b.Name) == "string" then b.Name
				else ""

			return #aString < #bString
		end)

		if returnFirst then
			return results[1]
		end

		return results
	end
end

--[=[
	@within Util

	Takes an array of instances (or anything with a Name property) and maps them into an array of their names.
	If no Name property is present, then tostring will be called instead.
]=]
function Util.GetNames(instances: any): { string }
	const names, _ = transformInstanceSet(instances)
	return names
end

--[=[
	@within Util
	Splits a string using a simple separator (no quote parsing)
]=]
function Util.SplitStringSimple(input: string, separator: string?): { string }
	separator = separator or "%s"

	const segments = {}
	local index = 1
	for string in input:gmatch(`([^{separator :: string}]+)`) do
		segments[index] = string
		index = index + 1
	end

	return segments
end

--[=[
	@within Util
	Parses escape sequences into their fully qualified characters
]=]
function Util.ParseEscapeSequences(text: string): string
	return text:gsub("\\(.)", {
		t = "\t",
		n = "\n",
	})
		:gsub("\\u(%x%x%x%x)", hexToChar)
		:gsub("\\x(%x%x)", hexToChar)
end

--[=[
	@within Util
	Encodes escaped operators in a string, replacing them with their unicode representations.
]=]
function Util.EncodeEscapedOperator(text: string, operator: string): string
	const first = operator:sub(1, 1)
	const escapedOp = operator:gsub("(.)", "%%%1")
	const escapedFirst = `%{first}`

	return text:gsub(`({escapedFirst}+)({escapedOp})`, function(esc, op)
		return (`{esc:sub(1, #esc - 1)}{op}`):gsub(".", function(char)
			return `\\u{("%04x"):format(char:byte())}`
		end)
	end)
end

--[=[
	@within Util
	Encodes all escaped operators in a string, replacing them with their unicode representations.
]=]
function Util.EncodeEscapedOperators(text: string): string
	for _, operator in ipairs(OPERATORS) do
		text = Util.EncodeEscapedOperator(text, operator)
	end

	return text
end

--[[
	FIXME: Listable types containing spaces are currently handled incorrectly.
	The issue spans multiple systems, including Window, Dispatcher, and Argument.
	Fixing this properly would require a major overhaul of how Cmdr tokenizes,
	parses, and preserves command input strings.

	Good luck, future reader.

	Hours wasted attempting to fix this:
	3
]]

--[=[
	@within Util
	Splits a string by space but taking into account quoted sequences which will be treated as a single argument.
]=]
function Util.SplitString(text: string, max: number?): { string }
	text = encodeControlChars(text)
	max = max or math.huge

	const segments = {}
	local buffer = nil
	local quoteChar = nil

	const function addSegment(segment: string)
		if #segments > max then
			segments[max] ..= ` {segment}`
		else
			segments[#segments + 1] = segment
		end
	end

	for segment in text:gmatch("[^ ]+") do
		segment = Util.ParseEscapeSequences(segment)

		const startsWithQuote = segment:match(START_QUOTE_PATTERN)
		const endsWithQuote = segment:match(END_QUOTE_PATTERN)
		const escapedQuotes = segment:match(ESCAPED_QUOTE_PATTERN)

		if startsWithQuote and not quoteChar and not endsWithQuote then
			buffer = segment
			quoteChar = startsWithQuote
		elseif buffer and endsWithQuote == quoteChar and #escapedQuotes % 2 == 0 then
			buffer ..= ` {segment}`

			addSegment(decodeControlChars(buffer:gsub(START_QUOTE_PATTERN, ""):gsub(END_QUOTE_PATTERN, "")))

			buffer = nil
			quoteChar = nil
		elseif buffer then
			buffer ..= ` {segment}`
		else
			addSegment(decodeControlChars(segment:gsub(START_QUOTE_PATTERN, ""):gsub(END_QUOTE_PATTERN, "")))
		end
	end

	if buffer then
		addSegment(decodeControlChars(buffer))
	end

	return segments
end

--[=[
	@within Util
	Takes an array of arguments and a max value. Any indicies past the max value will be appended to the last valid argument.
]=]
function Util.MashExcessArguments(arguments: { string }, max: number): { string }
	const results = {}

	for argumentIndex = 1, #arguments do
		if argumentIndex > max then
			results[max] = (results[max] or "") .. ` {arguments[argumentIndex]}`
		else
			results[argumentIndex] = arguments[argumentIndex]
		end
	end

	return results
end

--[=[
	@within Util
	Trims whitespace from both sides of a string.
]=]
function Util.TrimString(str: string): string
	const _, from = str:find("^%s*")
	return if from == #str then "" else str:match(".*%S", from + 1) :: string
end

--[=[
	@within Util
	Returns the text bounds size based on given text, label (from which properties will be pulled), and optional Vector2 container size.
]=]
function Util.GetTextSize(text: string, label: TextLabel, size: Vector2?): Vector2
	size = size or Vector2.new(label.AbsoluteSize.X, 0)

	if label.Font == Enum.Font.Unknown then
		const textBoundsParams = CACHED_LABELS[label] or Instance.new("GetTextBoundsParams")
		textBoundsParams.Text = text
		textBoundsParams.Font = label.FontFace
		textBoundsParams.Size = label.TextSize
		textBoundsParams.Width = (size :: Vector2).X
		textBoundsParams.RichText = label.RichText
		CACHED_LABELS[label] = textBoundsParams

		const success, bounds = pcall(TextService.GetTextBoundsAsync, TextService, textBoundsParams)
		if not success or not bounds then
			warn(`[Cmdr] Failed to get TextSize for Font Face {label.FontFace.Family}: {bounds}`)
			return Vector2.new(0, 0)
		end

		return bounds
	end

	return TextService:GetTextSize(text, label.TextSize, label.Font, size)
end

--[=[
	@within Util
	@return TypeDefinition

	Makes an Enum type.
]=]
function Util.MakeEnumType(name: string, values: any): { [string]: any }
	const findValue = Util.MakeFuzzyFinder(values)
	return {
		Validate = function(text)
			return findValue(text, true) ~= nil, `Value {("%q"):format(text)} is not a valid {name}.`
		end,

		Autocomplete = function(text)
			local list = findValue(text)
			return type(list[1]) ~= "string" and Util.GetNames(list) or list
		end,

		Parse = function(text)
			return findValue(text, true)
		end,
	}
end

--[=[
	@within Util
	Parses a prefixed union type argument (such as %Team)
]=]
function Util.ParsePrefixedUnionType(typeValue: string, rawValue: string): (string?, string?, string?)
	const split = Util.SplitStringSimple(typeValue)

	const types = {}
	for splitIndex = 1, #split, 2 do
		types[#types + 1] = {
			prefix = split[splitIndex - 1] or "",
			type = split[splitIndex],
		}
	end

	table.sort(types, function(a, b)
		return #a.prefix > #b.prefix
	end)

	for typeIndex = 1, #types do
		const typeInfo = types[typeIndex]

		if rawValue:sub(1, #typeInfo.prefix) == typeInfo.prefix then
			return typeInfo.type, rawValue:sub(#typeInfo.prefix + 1), typeInfo.prefix
		end
	end

	return
end

--[=[
	@within Util

	@param typeDefinition TypeDefinition
	@param override table
	@return TypeDefinition

	Creates a listable type from a singular type
]=]
function Util.MakeListableType(typeDefinition: any, override: { [string]: any }?): { [string]: any }
	const listableType: { [string]: any } = {
		Listable = true,
		Transform = typeDefinition.Transform,
		Validate = typeDefinition.Validate,
		ValidateOnce = typeDefinition.ValidateOnce,
		Autocomplete = typeDefinition.Autocomplete,
		Default = typeDefinition.Default,
		ArgumentOperatorAliases = typeDefinition.ArgumentOperatorAliases,
		Parse = function(...)
			return { typeDefinition.Parse(...) }
		end,
	}

	if override then
		for key, value in pairs(override) do
			listableType[key] = value
		end
	end

	return listableType
end

--[=[
	@within Util
	@param dispatcher Dispatcher

	Runs a command string, chaining commands with && and replacing || with the previous command's output.
]=]
function Util.RunCommandString(dispatcher: any, commandString: string): string?
	commandString = Util.ParseEscapeSequences(commandString)
	commandString = Util.EncodeEscapedOperators(commandString)

	const commands = commandString:split("&&")
	local output = ""
	for commandIndex, command in ipairs(commands) do
		const outputEncoded = output:gsub("%$", "\\x24"):gsub("%%", "%%%%")
		command = command:gsub("||", output:find("%s") and quoteString(outputEncoded) or outputEncoded)

		output = tostring(dispatcher:EvaluateAndRun((Util.RunEmbeddedCommands(dispatcher, command))))

		if commandIndex == #commands then
			return output
		end
	end

	return
end

--[=[
	@within Util
	@param dispatcher Dispatcher

	Runs embedded commands and replaces them
]=]
function Util.RunEmbeddedCommands(dispatcher: any, str: string): string
	str = encodeCommandEscape(str)

	const results = {}
	-- We need to do this because you can't yield in the gsub function
	for text in str:gmatch("$(%b{})") do
		local doQuotes = true
		local commandString = text:sub(2, #text - 1)

		if commandString:match("^{.+}$") then -- Allow double curly for literal replacement
			doQuotes = false
			commandString = commandString:sub(2, #commandString - 1)
		end

		results[text] = Util.RunCommandString(dispatcher, commandString)

		if doQuotes then
			if results[text]:find("%s") or results[text] == "" then
				results[text] = quoteString(results[text])
			end
		end
	end

	const escaped = (str:gsub("%$(%b{})", results))
	return decodeCommandEscape(escaped)
end

--[=[
	@within Util
	Replaces arguments in the format $1, $2, $something with whatever the given function returns for it.
]=]
function Util.SubstituteArgs(str: string, replace: any): string
	str = encodeCommandEscape(str)

	if type(replace) == "table" then
		for index = 1, #replace do
			const key = tostring(index)
			replace[key] = replace[index]

			if replace[key]:find("%s") then
				replace[key] = quoteString(replace[key])
			end
		end
	end

	const escaped = str:gsub("%$(%d+)%b{}", "$%1"):gsub("%$(%w+)", replace)
	return decodeCommandEscape(escaped)
end

--[=[
	@within Util
	@return CommandDefinition

	Creates an alias command, should only be used on the client.
]=]
function Util.MakeAliasCommand(name: string, commandString: string): { [string]: any }
	const commandName, commandDescription = unpack(name:split("|"))
	const args, seenArgs = {}, {}

	commandString = Util.EncodeEscapedOperators(commandString)
	for arg in commandString:gmatch("$(%d+)") do
		if seenArgs[arg] == nil then
			seenArgs[arg] = true
			local options = commandString:match(`${arg}(%b\{})`)

			local argOptional, argType, argName, argDescription
			if options then
				options = options:sub(2, #options - 1) -- remove braces
				argType, argName, argDescription = unpack(options:split("|"))
			end

			argOptional = argType and not not argType:match("%?$")
			argType = if argType then argType:match("^%w+") else "string"
			argName = argName or `Argument {arg}`
			argDescription = argDescription or ""

			table.insert(args, {
				Type = argType,
				Name = argName,
				Description = argDescription,
				Optional = argOptional,
			})
		end
	end

	return {
		Name = commandName,
		Description = `<Alias> {commandDescription or commandString}`,
		Group = "UserAlias",
		Args = args,
		ClientRun = function(context: any)
			return Util.RunCommandString(context.Dispatcher, Util.SubstituteArgs(commandString, context.RawArguments))
		end,
	}
end

--[=[
	@within Util

	@param options { Transform: function?, Parse: function?, Constructor: function?, TransformEach: function?, ValidateEach: function?, Prefixes: {string}?, Length: number? }
	@return ArgumentDefinition

	Makes a type that contains a sequence, e.g. Vector3 or Color3
	For options, one of Constructor or Parse is required
]=]
function Util.MakeSequenceType(options: {
	Transform: ((string) -> any)?,
	Parse: (({ string }) -> any)?,
	Constructor: ((...any) -> any)?,
	TransformEach: ((string) -> any)?,
	ValidateEach: ((any, number) -> (boolean, string?))?,
	Prefixes: { string }?,
	Length: number?,
}): { [string]: any }
	assert(
		options.Parse ~= nil or options.Constructor ~= nil,
		"[Cmdr] MakeSequenceType: Must provide one of: Constructor, Parse"
	)
	options.TransformEach = options.TransformEach or function(value: string): string
		return value
	end

	options.ValidateEach = options.ValidateEach or function()
		return true
	end

	return {
		Prefixes = options.Prefixes,

		Transform = options.Transform or function(text: string)
			const elements = Util.SplitPrioritizedDelimeter(text, { ",", "%s" }) or {}
			return Util.Map(elements, function(value: string)
				return (options :: any).TransformEach(value)
			end)
		end,

		Validate = function(components)
			if options.Length and #components > options.Length then
				return false, `Maximum of {options.Length} values allowed in sequence`
			end

			for componentIndex = 1, options.Length or #components do
				const valid, reason = (options :: any).ValidateEach(components[componentIndex], componentIndex)
				if not valid then
					return false, reason
				end
			end

			return true
		end,

		Parse = options.Parse or function(components)
			return options.Constructor(unpack(components))
		end,
	}
end

--[=[
	@within Util
	Splits a string by a single delimeter chosen from the given set. The first matching delimeter from the set becomes the split character.
]=]
function Util.SplitPrioritizedDelimeter(text: string, delimiters: { string }): { string }?
	for delimiterIndex, delimiter in ipairs(delimiters) do
		if text:find(delimiter) or delimiterIndex == #delimiters then
			return Util.SplitStringSimple(text, delimiter)
		end
	end

	return
end

--[=[
	@within Util
	Maps values of an array through a callback and returns an array of mapped values.
]=]
function Util.Map(array: { any }, callback: (any, number) -> any): { any }
	const results: { any } = {}
	for index, value in ipairs(array) do
		results[index] = callback(value, index)
	end

	return results
end

--[=[
	@within Util
	Maps arguments #2-n through callback and returns values as tuple.
]=]
function Util.Each(callback: (any) -> any, ...: any): ...any
	const results: { any } = {}
	for index, value in ipairs({ ... }) do
		results[index] = callback(value)
	end

	return unpack(results)
end

--[=[
	@within Util
	Emulates tabstops with spaces.
]=]
function Util.EmulateTabstops(text: string, tabWidth: number): string
	local currentColumn = 0
	const result = table.create(#text)
	for index = 1, #text do
		const character = text:sub(index, index)

		if character == "\t" then
			const spaces = tabWidth - currentColumn % tabWidth
			table.insert(result, (" "):rep(spaces))
			currentColumn += spaces
		else
			table.insert(result, character)

			if character == "\n" then
				currentColumn = 0
			elseif character ~= "\r" then
				currentColumn += 1
			end
		end
	end

	return table.concat(result)
end

--[=[
	@within Util
	@return function -- A function that locks the mutex and returns a function to unlock it.

	Creates a mutex for synchronizing coroutines.
]=]
function Util.Mutex(): () -> ()
	const queue: { thread } = {}
	local locked = false

	return function()
		if locked then
			table.insert(queue, coroutine.running())
			coroutine.yield()
		else
			locked = true
		end

		return function()
			if #queue > 0 then
				const nextThread = table.remove(queue, 1)
				coroutine.resume(nextThread)
			else
				locked = false
			end
		end
	end
end

--[=[
	@within Util
	@private

	Registers a deprecation warning for a method.
]=]
function Util:_registerDeprecationWarning(name: string, description: string)
	assert(type(name) == "string" and #name > 0, "[Cmdr] Deprecation warning name must be a string.")
	assert(
		type(description) == "string" and #description > 0,
		"[Cmdr] Deprecation warning description must be a string."
	)
	assert(not self._deprecationWarnings[name], `[Cmdr] Deprecation warning {name} is already registered.`)

	self._deprecationWarnings[name] = {
		Description = description,
		Suppressed = false,
		Emitted = false,
	}
end

--[=[
	@within Util
	@private

	Emits a deprecation warning for a method if it has been called. This should be called at the start of a deprecated method.
]=]
function Util:_emitDeprecationWarning(name: string)
	const warningInfo = self._deprecationWarnings[name]
	assert(warningInfo, `[Cmdr] Unknown deprecation warning {name}.`)

	if not warningInfo.Suppressed and not warningInfo.Emitted then
		warn(debug.traceback(`[Cmdr] [DeprecationWarning::{name}] {warningInfo.Description}`, 2))
		warningInfo.Emitted = true
	end
end

--[=[
	@within Util
	Suppresses a deprecation warning for a method.
]=]
function Util:SuppressDeprecationWarning(names: string | { string })
	assert(
		type(names) == "string" or type(names) == "table",
		"[Cmdr] Deprecation warning name(s) must be a string or an array of strings."
	)
	assert(#names > 0, "[Cmdr] Deprecation warning name(s) must not be empty.")

	if type(names) == "string" then
		names = { names }
	end

	for _, name in pairs(names) do
		assert(type(name) == "string", "[Cmdr] Deprecation warning names must be strings.")
		assert(self._deprecationWarnings[name], `[Cmdr] Unknown deprecation warning {name}.`)
		self._deprecationWarnings[name].Suppressed = true
	end
end

Util:_registerDeprecationWarning(
	"ProxyCalls",
	`Method calls should be performed against their respective modules rather than the {if RunService:IsServer()
		then "Cmdr"
