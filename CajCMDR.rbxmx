<Item class="ModuleScript" referent="RBX14">
<Properties>
<string name="Name">getPlayerPlaceInstance</string>
<ProtectedString name="Source"><![CDATA[return {
	Name = "get-player-place-instance",
	Description = "Returns the target player's Place ID and the JobId separated by a space. Returns 0 if the player is offline or something else goes wrong.",
	Group = "DefaultDebug",
	Args = {
		{
			Type = "playerId",
			Name = "Player",
			Description = "Get the place instance of this player.",
		},
		function(context: any)
			return {
				Type = context.Cmdr.Util.MakeEnumType("PlaceInstance Format", { "PlaceIdJobId", "PlaceId", "JobId" }),
				Name = "Format",
				Description = "What data to return. PlaceIdJobId returns both separated by a space.",
				Default = "PlaceIdJobId",
			}
		end,
	},
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX15">
<Properties>
<string name="Name">getPlayerPlaceInstanceServer</string>
<ProtectedString name="Source"><![CDATA[const TeleportService = game:GetService("TeleportService")

return function(_, playerId: number, format: string): string
	format = format or "PlaceIdJobId"

	const success, _, errorText, placeId, jobId =
		pcall(TeleportService.GetPlayerPlaceInstanceAsync, TeleportService, playerId)

	if not success or not placeId or not jobId or (errorText and #errorText > 0) then
		if format == "PlaceIdJobId" then
			return "0 -"
		elseif format == "PlaceId" then
			return "0"
		elseif format == "JobId" then
			return "-"
		end
	end

	if format == "PlaceIdJobId" then
		return `{placeId} {jobId}`
	elseif format == "PlaceId" then
		return tostring(placeId)
	elseif format == "JobId" then
		return tostring(jobId)
	end

	return "Something went very wrong!"
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX16">
<Properties>
<string name="Name">position</string>
<ProtectedString name="Source"><![CDATA[const Players = game:GetService("Players")
const ReplicatedStorage = game:GetService("ReplicatedStorage")

const BuiltInGuards = ReplicatedStorage.CmdrClient.Shared.BuiltInGuards
const HasCharacter = require(BuiltInGuards.HasCharacter) :: (number?) -> (any) -> string?

return {
	Name = "position",
	Aliases = { "pos" },
	Description = "Returns the Vector3 position of you or another player.",
	Group = "DefaultDebug",
	Args = {
		{
			Type = "player",
			Name = "Player",
			Description = "The player to report the position of. Omit for your own position.",
			Default = Players.LocalPlayer,
		},
	},
	Guards = {
		HasCharacter(1),
	},

	ClientRun = function(_, player: Player): string?
		const character = player.Character
		const rootPart = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not rootPart then
			return nil
		end

		return (tostring(rootPart.Position):gsub("%s", ""))
	end,
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX17">
<Properties>
<string name="Name">positionServer</string>
<ProtectedString name="Source"><![CDATA[return function(context: any, player: Player?): string
	const target: Player? = player or context.Executor
	const character = target and target.Character
	const rootPart = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?

	if not rootPart then
		return "Target player has no character."
	end

	return (tostring(rootPart.Position):gsub("%s", ""))
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX18">
<Properties>
<string name="Name">thru</string>
<ProtectedString name="Source"><![CDATA[const ReplicatedStorage = game:GetService("ReplicatedStorage")

const BuiltInGuards = ReplicatedStorage.CmdrClient.Shared.BuiltInGuards
const HasCharacter = require(BuiltInGuards.HasCharacter) :: (number?) -> (any) -> string?

return {
	Name = "thru",
	Aliases = { "t", "through" },
	Description = "Teleports you through whatever your mouse is hovering over, placing you equidistantly from the wall.",
	Group = "DefaultDebug",
	Args = {
		{
			Type = "number",
			Name = "Extra distance",
			Description = "Go through the wall an additional X studs.",
			Default = 0,
		},
	},
	Guards = {
		HasCharacter(),
	},

	ClientRun = function(context: any, extra: number): string
		-- We implement this here because player position is owned by the client.
		-- No reason to bother the server for this!

		const mouse = context.Executor:GetMouse() :: Mouse
		const character = context.Executor.Character :: Model
		const rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart

		const raycastParams = RaycastParams.new()
		raycastParams.FilterType = Enum.RaycastFilterType.Exclude
		raycastParams.FilterDescendantsInstances = { character }
		raycastParams.IgnoreWater = true
		raycastParams.RespectCanCollide = true

		const raycastResult = workspace:Raycast(mouse.UnitRay.Origin, mouse.UnitRay.Direction * 1000, raycastParams)
		if raycastResult then
			const pos = rootPart.Position
			const diff = (raycastResult.Position - pos)
			const unitDirection = if diff.Magnitude > 0 then diff.Unit else Vector3.new()

			character:MoveTo((diff * 2) + (unitDirection * extra) + pos)
			return "Thru the wall!"
		else
			character:MoveTo(mouse.Hit.Position)
			return "Blinked (No wall found)!"
		end
	end,
}
]]></ProtectedString>
</Properties>
</Item>
