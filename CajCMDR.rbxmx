<Item class="ModuleScript" referent="RBX1A">
<Properties>
<string name="Name">uptimeServer</string>
<ProtectedString name="Source"><![CDATA[const startTime = os.time()

return function(): string
	const uptime = os.time() - startTime

	const days = uptime // 86400
	const hours = uptime // 3600 % 24
	const minutes = uptime // 60 % 60
	const seconds = uptime % 60

	return `{days}d {hours}h {minutes}m {seconds}s`
end
]]></ProtectedString>
</Properties>
</Item>
