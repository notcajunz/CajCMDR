<Item class="ModuleScript" referent="RBX40">
<Properties>
<string name="Name">PlayerId</string>
<ProtectedString name="Source"><![CDATA[const Players = game:GetService("Players")

const nameCache: { [string]: number } = {}

const function getUserId(username: string): number?
	username = username:match("%(@([^%)]+)%)") or username

	if nameCache[username] then
		return nameCache[username]
	elseif Players:FindFirstChild(username) then
		const player = Players[username] :: Player

		nameCache[username] = player.UserId
		return player.UserId
	else
		const success, userid = pcall(Players.GetUserIdFromNameAsync, Players, username)

		if not success then
			return nil
		end

		nameCache[username] = userid
		return userid
	end
end

return function(registry: any)
	const playerIdType = {
		DisplayName = "Full Player Name",
		Prefixes = "# positiveInteger",

		Transform = function(text: string): (string, { Player })
			const findPlayer = registry.Cmdr.Util.MakeFuzzyFinder(Players:GetPlayers())
			return text, findPlayer(text)
		end,

		ValidateOnce = function(text: string): (boolean, string?)
			return getUserId(text) ~= nil, "No player with that name could be found."
		end,

		Autocomplete = function(_, players: { Player }): { string }
			return registry.Cmdr.Util.GetNames(players)
		end,

		Parse = function(text: string): number?
			return getUserId(text)
		end,

		Default = function(player: Player): string
			return player.Name
		end,

		ArgumentOperatorAliases = {
			me = ".",
			all = "*",
			others = "**",
			random = "?",
		},
	}

	registry:RegisterType("playerId", playerIdType)
	registry:RegisterType(
		"playerIds",
		registry.Cmdr.Util.MakeListableType(playerIdType, { Prefixes = "# positiveIntegers" })
	)
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX41">
<Properties>
<string name="Name">Primitives</string>
<ProtectedString name="Source"><![CDATA[const TRUTHY_VALUES = { "true", "t", "yes", "y", "on", "enable", "enabled", "1", "+" }
const FALSY_VALUES = { "false", "f", "no", "n", "off", "disable", "disabled", "0", "-" }

type NumberTransformer = {
	Transform: (text: string) -> number?,
	Validate: (value: number?) -> (boolean, string?),
	Parse: (value: number) -> number,
}

const stringType = {
	Validate = function(value: unknown): (boolean, string?)
		return value ~= nil
	end,

	Parse = function(value: unknown): string
		return tostring(value)
	end,
}

const numberType: NumberTransformer = {
	Transform = function(text: string): number?
		return tonumber(text)
	end,

	Validate = function(value: number?): (boolean, string?)
		return value ~= nil
	end,

	Parse = function(value: number): number
		return value
	end,
}

const intType: NumberTransformer = {
	Transform = function(text: string): number?
		return tonumber(text)
	end,

	Validate = function(value: number?): (boolean, string?)
		return value ~= nil and value == math.floor(value), "Only whole numbers are valid."
	end,

	Parse = function(value: number): number
		return value
	end,
}

const positiveIntType: NumberTransformer = {
	Transform = function(text: string): number?
		return tonumber(text)
	end,

	Validate = function(value: number?): (boolean, string?)
		return value ~= nil and value == math.floor(value) and value > 0, "Only positive whole numbers are valid."
	end,

	Parse = function(value: number): number
		return value
	end,
}

const nonNegativeIntType: NumberTransformer = {
	Transform = function(text: string): number?
		return tonumber(text)
	end,

	Validate = function(value: number?): (boolean, string?)
		return value ~= nil and value == math.floor(value) and value >= 0, "Only non-negative whole numbers are valid."
	end,

	Parse = function(value: number): number
		return value
	end,
}

const byteType: NumberTransformer = {
	Transform = function(text: string): number?
		return tonumber(text)
	end,

	Validate = function(value: number?): (boolean, string?)
		return value ~= nil and value == math.floor(value) and value >= 0 and value <= 255, "Only bytes are valid."
	end,

	Parse = function(value: number): number
		return value
	end,
}

const digitType: NumberTransformer = {
	Transform = function(text: string): number?
		return tonumber(text)
	end,

	Validate = function(value: number?): (boolean, string?)
		return value ~= nil and value == math.floor(value) and value >= 0 and value <= 9, "Only digits are valid."
	end,

	Parse = function(value: number): number
		return value
	end,
}

return function(registry: any)
	const truthy: { [string]: boolean } = registry.Cmdr.Util.MakeDictionary(TRUTHY_VALUES)
	const falsy: { [string]: boolean } = registry.Cmdr.Util.MakeDictionary(FALSY_VALUES)

	const boolType = {
		Transform = function(text: string): string
			return text:lower()
		end,

		Validate = function(value: string): (boolean, string?)
			return truthy[value] ~= nil or falsy[value] ~= nil, "Please use true/yes/on or false/no/off."
		end,

		Parse = function(value: string): boolean?
			if truthy[value] then
				return true
			elseif falsy[value] then
				return false
			end

			return nil
		end,
	}

	registry:RegisterType("string", stringType)
	registry:RegisterType("number", numberType)
	registry:RegisterType("integer", intType)
	registry:RegisterType("positiveInteger", positiveIntType)
	registry:RegisterType("nonNegativeInteger", nonNegativeIntType)
	registry:RegisterType("byte", byteType)
	registry:RegisterType("digit", digitType)
	registry:RegisterType("boolean", boolType)

	registry:RegisterType("strings", registry.Cmdr.Util.MakeListableType(stringType))
	registry:RegisterType("numbers", registry.Cmdr.Util.MakeListableType(numberType))
	registry:RegisterType("integers", registry.Cmdr.Util.MakeListableType(intType))
	registry:RegisterType("positiveIntegers", registry.Cmdr.Util.MakeListableType(positiveIntType))
	registry:RegisterType("nonNegativeIntegers", registry.Cmdr.Util.MakeListableType(nonNegativeIntType))
	registry:RegisterType("bytes", registry.Cmdr.Util.MakeListableType(byteType))
	registry:RegisterType("digits", registry.Cmdr.Util.MakeListableType(digitType))
	registry:RegisterType("booleans", registry.Cmdr.Util.MakeListableType(boolType))
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX42">
<Properties>
<string name="Name">StoredKey</string>
<ProtectedString name="Source"><![CDATA[const VALID_STORED_KEY_NAME_PATTERNS: { string } = {
	"^%a[%w_]*$",
	"^%$%a[%w_]*$",
	"^%.%a[%w_]*$",
	"^%$%.%a[%w_]*$",
}

return function(registry: any)
	const storedKeyType = {
		Autocomplete = function(text: string): { string }
			const store = registry:GetStore("vars_used") or {}
			const find = registry.Cmdr.Util.MakeFuzzyFinder(registry.Cmdr.Util.DictionaryKeys(store))
			return find(text)
		end,

		Validate = function(text: string): (boolean, string?)
			for _, pattern: string in ipairs(VALID_STORED_KEY_NAME_PATTERNS) do
				if text:match(pattern) then
					return true
				end
			end

			return false, "Key names must start with an optional modifier: . $ or $. and must begin with a letter."
		end,

		Parse = function(text: string): string
			return text
		end,
	}

	registry:RegisterType("storedKey", storedKeyType)
	registry:RegisterType("storedKeys", registry.Cmdr.Util.MakeListableType(storedKeyType))
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX43">
